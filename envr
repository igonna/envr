    def refuse_incomplete_resize(self, instance: dict[str, Any]) -> None:
        if self.resize_marker_exists(instance):
            raise EnvrError("resize is incomplete; run envr resize to resume it")

    def resize_marker_state(
        self, instance: dict[str, Any]
    ) -> tuple[str, int | None] | None:
        identity = str(instance.get("id") or instance.get("main_ip") or "")
        if identity and identity in self._resize_markers:
            return self._resize_markers[identity]
        result = self.remote_command(
            instance,
            f"test -s {shlex.quote(REMOTE_RESIZE_MARKER)} && "
            f"cat {shlex.quote(REMOTE_RESIZE_MARKER)}",
            capture=True,
            check=False,
            quiet=True,
            timeout=15,
        )
        if result.returncode != 0:
            if identity:
                self._resize_markers[identity] = None
            return None
        match = re.fullmatch(r"(source|target):([0-9]+)", result.stdout.strip())
        if match is None:
            marker: tuple[str, int | None] = ("unknown", None)
        else:
            marker = (match.group(1), int(match.group(2)))
        if identity:
            self._resize_markers[identity] = marker
        return marker

    def resize_marker_exists(self, instance: dict[str, Any]) -> bool:
        return self.resize_marker_state(instance) is not None

    def resize_target_ram_gb(self, instance: dict[str, Any]) -> int:
        marker = self.resize_marker_state(instance)
        if marker is not None and marker[1] in PLAN_IDS:
            return int(marker[1])
        return self.requested_ram_gb(instance)

    def connect_shell(
        self,
        instance: dict[str, Any],
        repository: dict[str, Any] | None,
    ) -> None:
        if repository is None:
            display_name = "workspace"
            target = REMOTE_ROOT
            session = "envr-workspace"
        else:
            display_name = str(repository["folder"])
            target = f"{REMOTE_ROOT}/{display_name}"
            session = f"envr-repo-{display_name}"
        exact_session = f"={session}"
        create_session = (
            f"tmux has-session -t {shlex.quote(exact_session)} 2>/dev/null || "
            f"tmux new-session -d -s {shlex.quote(session)} "
            f"-c {shlex.quote(target)}"
        )
        command = (
            f"flock -x {shlex.quote(f'{REMOTE_CONFIG_ROOT}/tmux.lock')} "
            f"bash -lc {shlex.quote(create_session)}; "
            f"session_id=$(tmux display-message -p -t {shlex.quote(exact_session)} "
            "'#{session_id}') || exit; "
            'tmux set-option -t "$session_id" mouse on; '
            "tmux set-option -g history-limit 50000; "
            f"exec tmux attach-session -t {shlex.quote(exact_session)}"
        )
        print(f"Connecting to {display_name}. Detach safely with Ctrl-b d.")
        try:
            self.remote_command(instance, command, tty=True, check=False)
        finally:
            try:
                self.sync_from_server(instance)
            except EnvrError as error:
                eprint(f"Warning: could not refresh the local envr cache: {error}")

    def resume_initial_setup(self, instance: dict[str, Any]) -> None:
        self.refuse_incomplete_resize(instance)
        self.wait_for_cloud_init(instance)
        self.ensure_remote_runtime(instance)
        self.ensure_recovery_password(instance)
        synchronized = self.sync_from_server(instance)
        if not synchronized:
            self.install_cached_auth(instance)
        self.repair_remote_repository_bindings(instance)
        self.set_last_workspace(instance, None)
        self.record_successful_connection(instance)
        self.remote_command(
            instance,
            f"touch {shlex.quote(REMOTE_INITIAL_READY)} && "
            f"chmod 600 {shlex.quote(REMOTE_INITIAL_READY)}",
            quiet=True,
            timeout=30,
        )

    def probe_cached_instance(self, ram_gb: int | None) -> dict[str, Any] | None:
        cached = self.cached_instance(ram_gb)
        if cached is None:
            return None
        reachable = None
        for attempt in range(3):
            try:
                reachable = self.remote_command(
                    cached,
                    "true",
                    check=False,
                    quiet=True,
                    timeout=7,
                    connect_timeout=5,
                    strict_host_key_checking="yes",
                )
            except subprocess.TimeoutExpired:
                reachable = None
            if reachable is not None and reachable.returncode == 0:
                break
            failure = (reachable.stderr or "") if reachable is not None else ""
            if not self.transient_ssh_probe_failure(failure) or attempt == 2:
                break
            print("SSH handshake interrupted; retrying...")
            time.sleep(1)
        if reachable is None or reachable.returncode != 0:
            return None
        return cached

    def initial_setup_complete(self, instance: dict[str, Any]) -> bool:
        result = self.remote_command(
            instance,
            f"test -e {shlex.quote(REMOTE_INITIAL_READY)} || {{ "
            "test -e /var/lib/envr-ready && "
            "command -v tmux >/dev/null && command -v codex >/dev/null && "
            "command -v scodex >/dev/null && "
            f"test -d {shlex.quote(REMOTE_ROOT)} && "
            f"test -s {shlex.quote(REMOTE_RECOVERY_PASSWORD)}; }}",
            check=False,
            quiet=True,
            timeout=15,
        )
        return result.returncode == 0

    def require_initial_setup_complete(self, instance: dict[str, Any]) -> None:
        if not self.initial_setup_complete(instance):
            ram_gb = self.instance_ram_gb(instance)
            raise EnvrError(
                f"initial setup is incomplete; run envr up {ram_gb} to resume it"
            )

    def prepare_go_instance(
        self, instance: dict[str, Any], folder: str | None
    ) -> tuple[dict[str, Any], dict[str, Any] | None]:
        self.refuse_incomplete_resize(instance)
        self.ensure_remote_runtime_current(instance)
        explicitly_selected = folder is not None
        if folder is None:
            folder = self.last_workspace(instance)
        repository = None
        if folder is not None:
            if not FOLDER_RE.fullmatch(folder):
                raise EnvrError(f"invalid repository folder: {folder!r}")
            result = self.remote_command(
                instance,
                f"target={shlex.quote(f'{REMOTE_ROOT}/{folder}')}; "
                "test -e \"$target\" || exit 10; "
                "git -C \"$target\" rev-parse --git-dir >/dev/null 2>&1 "
                "|| exit 11",
                check=False,
                quiet=True,
                timeout=15,
            )
            if result.returncode == 10:
                self.sync_from_server(instance)
                configured = self.repository(folder)
                self.ensure_remote_repository(instance, configured)
                repository = configured
            elif result.returncode != 0:
                raise EnvrError(f"repository is not available on the VPS: {folder}")
            else:
                repository = {"folder": folder}
            if explicitly_selected:
                self.set_last_workspace(instance, folder)
        self.record_successful_connection(instance)
        return instance, repository

    def up(self, ram_gb: int) -> None:
        if ram_gb not in PLAN_IDS:
            supported = ", ".join(str(size) for size in sorted(PLAN_IDS))
            raise EnvrError(f"RAM must be one of: {supported}")
        ensure_commands(("ssh", "scp", "ssh-keygen"))

        cached = self.probe_cached_instance(None)
        if cached is not None:
            current_ram = self.instance_ram_gb(cached)
            if self.initial_setup_complete(cached):
                raise EnvrError(
                    f"envr VPS already exists ({current_ram} GB); "
                    "use envr go or envr resize"
                )
            if current_ram != ram_gb:
                raise EnvrError(
                    f"incomplete envr VPS has {current_ram} GB; "
                    f"run envr up {current_ram} to resume it"
                )
            print(f"Resuming initial setup at {cached['main_ip']}...")
            self.resume_initial_setup(cached)
            self.try_cached_device_key_sync(cached)
            print("VPS ready. Connect with envr go.")
            return

        found = self.active_inventory(include_selected=True)
        if found:
            api, instance = found
            current_ram = int(instance.get("ram", 0)) // 1024
            self.save_instance_state(instance, ram_gb=current_ram)
            if instance.get("power_status") == "stopped":
                raise EnvrError(
                    f"envr VPS already exists ({current_ram} GB) and is stopped; "
                    "use envr go"
                )
            instance = self.wait_for_instance(api, str(instance.get("id")))
            self.ensure_device_access(api, instance)
            if self.initial_setup_complete(instance):
                raise EnvrError(
                    f"envr VPS already exists ({current_ram} GB); "
                    "use envr go or envr resize"
                )
            if current_ram != ram_gb:
                raise EnvrError(
                    f"incomplete envr VPS has {current_ram} GB; "
                    f"run envr up {current_ram} to resume it"
                )
            self.resume_initial_setup(instance)
        else:
            api = self.api(self.selected_provider())
            self.account_response(api)
            self.create_instance(api, ram_gb)
        print("VPS ready. Connect with envr go.")

    def go(
        self, folder: str | None
    ) -> tuple[dict[str, Any], dict[str, Any] | None]:
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        cached = self.probe_cached_instance(None)
        if cached is not None:
            print(f"Using cached VPS at {cached['main_ip']}...")
            self.require_initial_setup_complete(cached)
            return self.prepare_go_instance(cached, folder)

        found = self.active_inventory()
        if not found:
            raise EnvrError("envr-codex is not running; run envr up RAM")
        api, instance = found
        current_ram = self.instance_ram_gb(instance)
        self.save_instance_state(instance, ram_gb=current_ram)
        if instance.get("power_status") == "stopped":
            api.request("POST", f"instances/{instance.get('id')}/start")
        instance = self.wait_for_instance(api, str(instance.get("id")))
        self.ensure_device_access(api, instance)
        self.require_initial_setup_complete(instance)
        return self.prepare_go_instance(instance, folder)

    @staticmethod
    def transient_ssh_probe_failure(stderr: str) -> bool:
        failure = stderr.lower()
        non_retryable = (
            "permission denied",
            "authentication failed",
            "host identification has changed",
            "host key verification failed",
            "no ed25519 host key is known",
            "no ecdsa host key is known",
            "no rsa host key is known",
            "load key",
            "identity file",
            "bad permissions",
            "invalid format",
            "error in libcrypto",
        )
        return not any(marker in failure for marker in non_retryable)

    @staticmethod
    def instance_ram_gb(instance: dict[str, Any]) -> int:
        return int(instance.get("ram") or 0) // 1024

    def requested_ram_gb(self, instance: dict[str, Any]) -> int:
        provider = str(instance.get("provider") or "vultr")
        plan = str(instance.get("plan") or "")
        state = self.state()
        if str(state.get("instance_id") or "") == str(instance.get("id") or ""):
            with contextlib.suppress(TypeError, ValueError):
                saved = int(state.get("ram_gb") or 0)
                if saved:
                    return saved
        actual = self.instance_ram_gb(instance)
        matches = [
            requested
            for requested, plan_id in PROVIDER_PLAN_IDS.get(provider, {}).items()
            if plan == plan_id
        ]
        if len(matches) == 1:
            return matches[0]
        if actual in matches:
            return actual
        return matches[0] if matches else actual

    def resize_roles(
        self, api: VultrAPI
    ) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
        instances = self.all_instances(api)
        tag = self.management_tag()
        owned = [
            instance
            for instance in instances
            if any(
                str(value) == tag or str(value).startswith(tag + "-")
                for value in (instance.get("tags") or [])
            )
        ]
        current = [item for item in owned if item.get("label") == LABEL]
        targets = [
            item for item in owned if item.get("label") == RESIZE_TARGET_LABEL
        ]
        sources = [
            item for item in owned if item.get("label") == RESIZE_SOURCE_LABEL
        ]
        return current, targets, sources

    def set_instance_label(
        self, api: VultrAPI, instance: dict[str, Any], label: str
    ) -> None:
        instance_id = str(instance.get("id") or "")
        if not instance_id:
            raise EnvrError("cannot relabel an instance without an ID")
        api.patch(f"instances/{instance_id}", {"label": label})
        instance["label"] = label

    def set_resize_marker(
        self, instance: dict[str, Any], ram_gb: int, *, role: str = "source"
    ) -> None:
        if role not in {"source", "target"}:
            raise EnvrError(f"invalid resize marker role: {role}")
        script = f"""set -euo pipefail
install -d -m 700 {shlex.quote(REMOTE_CONFIG_ROOT)}
temporary=$(mktemp {shlex.quote(REMOTE_CONFIG_ROOT)}/.resize.XXXXXX)
trap 'rm -f "$temporary"' EXIT
printf '%s:%s\n' "$1" "$2" > "$temporary"
chmod 600 "$temporary"
mv -f "$temporary" {shlex.quote(REMOTE_RESIZE_MARKER)}
trap - EXIT
"""
        self.remote_script(
            instance, script, (role, str(ram_gb)), quiet=True, timeout=30
        )
        identity = str(instance.get("id") or instance.get("main_ip") or "")
        if identity:
            self._resize_markers[identity] = (role, ram_gb)

    def clear_resize_marker(self, instance: dict[str, Any]) -> None:
        result = self.remote_command(
            instance,
            f"rm -f {shlex.quote(REMOTE_RESIZE_MARKER)}",
            quiet=True,
            check=False,
            timeout=30,
        )
        identity = str(instance.get("id") or instance.get("main_ip") or "")
        if identity and result.returncode == 0:
            self._resize_markers[identity] = None

    def ensure_resize_source_ready(
        self, instance: dict[str, Any], *, measure: bool = True
    ) -> int:
        script = r"""set -euo pipefail
measure=$1
if (pgrep -u remote -af '[c]odex' \
        | grep -v '[e]nvr-codex-supervisor' | grep -q .) \
        || (command -v envr-codex-supervisor >/dev/null 2>&1 \
            && envr-codex-supervisor armed); then
    echo CODEX_RUNNING
    exit 20
fi
if test "$measure" != yes; then
    printf '0\n'
    exit 0
fi
for path in /home/remote/envr /home/remote/.codex /home/remote/.ssh/envr; do
    test -d "$path" || continue
    if find "$path" -xdev \( -type b -o -type c -o -type p -o -type s \) \
        -print -quit | grep -q .; then
        echo SPECIAL_FILE
        exit 21
    fi
done
total=0
for path in \
    /home/remote/envr \
    /home/remote/.codex \
    /home/remote/.ssh/envr \
    /home/remote/.config/envr/repos.json \
    /home/remote/.config/envr/last-workspace; do
    test -e "$path" || continue
    size=$(du -sb -- "$path" | awk '{print $1}')
    total=$((total + size))
done
printf '%s\n' "$total"
"""
        result = self.remote_script(
            instance,
            script,
            ("yes" if measure else "no",),
            capture=True,
            check=False,
            timeout=120,
        )
        detail = result.stdout.strip()
        if result.returncode == 20 or detail == "CODEX_RUNNING":
            raise EnvrError(
                "Codex is still running. Exit Codex and detach from tmux, "
                "then run resize again"
            )
        if result.returncode == 21 or detail == "SPECIAL_FILE":
            raise EnvrError("a preserved directory contains a special file")
        if result.returncode != 0 or not detail.isdigit():
            raise EnvrError("could not measure the resize data")
        return int(detail)

    def quiesce_resize_source(self, instance: dict[str, Any]) -> None:
        """Stop persistent tmux only while no Codex session is armed."""
        script = rf"""set -euo pipefail
lock={shlex.quote(f'{REMOTE_CONFIG_ROOT}/tmux.lock')}
exec 9>"$lock"
flock -x 9
if (pgrep -u remote -af '[c]odex' \
        | grep -v '[e]nvr-codex-supervisor' | grep -q .) \
        || (command -v envr-codex-supervisor >/dev/null 2>&1 \
            && envr-codex-supervisor armed); then
    echo CODEX_RUNNING
    exit 20
fi
sudo systemctl stop envr-tmux.service 2>/dev/null || true
tmux kill-server 2>/dev/null || true
"""
        result = self.remote_script(
            instance,
            script,
            (),
            capture=True,
            check=False,
            timeout=30,
        )
        if result.returncode == 20 or result.stdout.strip() == "CODEX_RUNNING":
            raise EnvrError(
                "Codex started while resize was preparing. Exit Codex and "
                "detach from tmux, then run resize again"
            )
        if result.returncode != 0:
            raise EnvrError("could not safely pause tmux for resize")

    def ensure_resize_capacity(
        self, target: dict[str, Any], transfer_bytes: int
    ) -> None:
        result = self.remote_command(
            target,
            "df -PB1 /home/remote | awk 'NR == 2 {print $4}'",
            capture=True,
            quiet=True,
            timeout=30,
        )
        available = result.stdout.strip()
        if not available.isdigit():
            raise EnvrError("could not determine destination free space")
        required = transfer_bytes + 1024**3
        if int(available) < required:
            raise EnvrError(
                "preserved data does not fit on the requested VPS "
                "with the required 1 GB safety margin"
            )

    def migration_key_and_host(
        self,
        source: dict[str, Any],
        target: dict[str, Any],
        token: str,
    ) -> tuple[str, str]:
        key = f"{REMOTE_CONFIG_ROOT}/.resize-key-{token}"
        public = self.remote_command(
            target,
            f"install -d -m 700 {shlex.quote(REMOTE_CONFIG_ROOT)} && "
            f"ssh-keygen -q -t ed25519 -N '' -C {shlex.quote('envr-resize-' + token)} "
            f"-f {shlex.quote(key)} && cat {shlex.quote(key + '.pub')}",
            capture=True,
            quiet=True,
            timeout=30,
        ).stdout.strip()
        if not public.startswith("ssh-ed25519 ") or "\n" in public:
            raise EnvrError("destination produced an invalid migration key")
        host_key = self.remote_command(
            source,
            "cat /etc/ssh/ssh_host_ed25519_key.pub",
            capture=True,
            quiet=True,
            timeout=30,
        ).stdout.strip()
        if not host_key.startswith("ssh-ed25519 ") or "\n" in host_key:
            raise EnvrError("source has an invalid SSH host key")
        return public, host_key

    def authorize_resize_target(
        self,
        source: dict[str, Any],
        target: dict[str, Any],
        public_key: str,
        token: str,
    ) -> None:
        target_ip = str(target.get("main_ip") or "")
        try:
            if ipaddress.ip_address(target_ip).version != 4:
                raise ValueError
        except ValueError as error:
            raise EnvrError("resize target does not have a valid IPv4 address") from error
        script = r"""set -euo pipefail
ip=$1
key=$2
marker=$3
install -d -m 700 /home/remote/.ssh
touch /home/remote/.ssh/authorized_keys
chmod 600 /home/remote/.ssh/authorized_keys
printf '\n' >> /home/remote/.ssh/authorized_keys
printf 'restrict,from="%s" %s %s\n' "$ip" "$key" "$marker" \
    >> /home/remote/.ssh/authorized_keys
"""
        self.remote_script(
            source,
            script,
            (target_ip, public_key, f"envr-resize-{token}"),
            quiet=True,
            timeout=30,
        )

    def cleanup_resize_access(
        self,
        source: dict[str, Any],
        target: dict[str, Any],
        token: str,
    ) -> None:
        marker = f"envr-resize-{token}"
        script = r"""set -euo pipefail
path=/home/remote/.ssh/authorized_keys
test -f "$path" || exit 0
temporary=$(mktemp /home/remote/.ssh/.authorized_keys.XXXXXX)
trap 'rm -f "$temporary"' EXIT
grep -Fv -- "$1" "$path" > "$temporary" || true
chmod 600 "$temporary"
mv -f "$temporary" "$path"
trap - EXIT
"""
        with contextlib.suppress(EnvrError, subprocess.TimeoutExpired):
            self.remote_script(source, script, (marker,), quiet=True, timeout=30)
        excludes = f"{REMOTE_CONFIG_ROOT}/.resize-excludes-{token}"
        with contextlib.suppress(EnvrError, subprocess.TimeoutExpired):
            self.remote_command(
                source,
                f"rm -f {shlex.quote(excludes)}",
                quiet=True,
                check=False,
                timeout=30,
            )
        key = f"{REMOTE_CONFIG_ROOT}/.resize-key-{token}"
        with contextlib.suppress(EnvrError, subprocess.TimeoutExpired):
            self.remote_command(
                target,
                f"rm -f {shlex.quote(key)} {shlex.quote(key + '.pub')} "
                f"{shlex.quote(key + '.known_hosts')} "
                f"{shlex.quote(key + '.excludes')}",
                quiet=True,
                check=False,
                timeout=30,
            )

    def prepare_resize_excludes(
        self, source: dict[str, Any], token: str
    ) -> None:
        excludes = f"{REMOTE_CONFIG_ROOT}/.resize-excludes-{token}"
        script = r"""set -euo pipefail
root=$1
output=$2
config=${output%/*}
temporary=$(mktemp "$config/.resize-excludes.XXXXXX")
ignored_list=""
trap 'rm -f "$temporary" ${ignored_list:+"$ignored_list"}' EXIT
: > "$temporary"
shopt -s nullglob
for repository in \
    "$root"/* \
    "$root"/.[!.]* \
    "$root"/..?*; do
    test -d "$repository" || continue
    git -C "$repository" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
    folder=${repository##*/}
    ignored_list=$(mktemp "$config/.resize-ignored.XXXXXX")
    git -C "$repository" ls-files \
        --others --ignored --exclude-standard --directory -z > "$ignored_list"
    while IFS= read -r -d '' ignored; do
        printf '/%s/%s\0' "$folder" "$ignored" >> "$temporary"
    done < "$ignored_list"
    rm -f "$ignored_list"
    ignored_list=""
done
chmod 600 "$temporary"
mv -f "$temporary" "$output"
trap - EXIT
"""
        self.remote_script(
            source, script, (REMOTE_ROOT, excludes), quiet=True, timeout=300
        )

    def transfer_resize_data(
        self,
        source: dict[str, Any],
        target: dict[str, Any],
        host_key: str,
        token: str,
    ) -> None:
        source_ip = str(source.get("main_ip") or "")
        try:
