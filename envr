    def finish_resize(
        self,
        api: VultrAPI,
        target: dict[str, Any],
        source: dict[str, Any],
        *,
        target_validated: bool = False,
    ) -> None:
        if target.get("label") == RESIZE_TARGET_LABEL:
            print("Promoting the validated VPS...")
            self.set_instance_label(api, target, LABEL)
        self.save_instance_state(target, ram_gb=self.resize_target_ram_gb(target))
        print("Synchronizing final device access and credentials...")
        self.ensure_device_access(api, target)
        self.ensure_recovery_password(target)
        if not target_validated:
            self.repair_remote_repository_bindings(target)
            self.sync_from_server(target)
        print(f"Deleting the old {self.instance_ram_gb(source)} GB VPS...")
        self.delete_instance(api, source)
        self.remote_command(
            target,
            f"touch {shlex.quote(REMOTE_INITIAL_READY)} && "
            f"chmod 600 {shlex.quote(REMOTE_INITIAL_READY)}",
            quiet=True,
            timeout=30,
        )
        self.clear_resize_marker(target)
        print(f"Resize complete: {self.instance_ram_gb(target)} GB.")
        print("Connect with envr go.")

    def finish_cross_provider_resize(
        self,
        source_api: Any,
        target_api: Any,
        target: dict[str, Any],
        source: dict[str, Any],
        *,
        target_validated: bool = False,
    ) -> None:
        if target.get("label") == RESIZE_TARGET_LABEL:
            print("Promoting the validated VPS...")
            self.set_instance_label(target_api, target, LABEL)
        print("Synchronizing final device access and credentials...")
        self.ensure_device_access(target_api, target)
        self.ensure_recovery_password(target)
        if not target_validated:
            self.repair_remote_repository_bindings(target)
            self.sync_from_server(target)
        print(
            f"Deleting the old {self.provider_label(source_api)} "
            f"{self.instance_ram_gb(source)} GB VPS..."
        )
        self.delete_instance(source_api, source)
        if self.password_path.is_file():
            target["default_password"] = self.password_path.read_text(
                encoding="utf-8"
            ).strip()
        self.save_instance_state(target, ram_gb=self.resize_target_ram_gb(target))
        self.remote_command(
            target,
            f"touch {shlex.quote(REMOTE_INITIAL_READY)} && "
            f"chmod 600 {shlex.quote(REMOTE_INITIAL_READY)}",
            quiet=True,
            timeout=30,
        )
        self.clear_resize_marker(target)
        print(
            f"Resize complete: {self.instance_ram_gb(target)} GB on "
            f"{self.provider_label(target_api)}."
        )
        print("Connect with envr go.")

    def resize_cross_provider(
        self, source_api: Any, target_api: Any, ram_gb: int
    ) -> None:
        source_current, _, source_old = self.resize_roles(source_api)
        target_current, target_pending, _ = self.resize_roles(target_api)
        if not source_current and not source_old and len(target_current) == 1:
            target = target_current[0]
            print("The source is already deleted; finalizing the destination...")
            self.validate_resize_target(target)
            if self.password_path.is_file():
                target["default_password"] = self.password_path.read_text(
                    encoding="utf-8"
                ).strip()
            self.save_instance_state(target, ram_gb=self.resize_target_ram_gb(target))
            self.remote_command(
                target,
                f"touch {shlex.quote(REMOTE_INITIAL_READY)} && "
                f"chmod 600 {shlex.quote(REMOTE_INITIAL_READY)}",
                quiet=True,
                timeout=30,
            )
            self.clear_resize_marker(target)
            print("Resize cleanup complete. Connect with envr go.")
            return
        if len(source_current) + len(source_old) != 1:
            raise EnvrError("source cloud does not contain one unambiguous envr VPS")
        if len(target_current) > 1 or len(target_pending) > 1:
            raise EnvrError("destination cloud has an ambiguous resize state")
        source = (source_current or source_old)[0]

        # Resume only after promotion/validation. An unpromoted target is not
        # trusted after an interruption, so the source remains authoritative.
        if source_old and target_current:
            self.finish_cross_provider_resize(
                source_api, target_api, target_current[0], source
            )
            return
        if source_old and target_pending:
            self.validate_resize_target(target_pending[0])
            self.finish_cross_provider_resize(
                source_api,
                target_api,
                target_pending[0],
                source,
                target_validated=True,
            )
            return
        if target_current:
            raise EnvrError("destination cloud already contains envr-codex")
        if target_pending:
            print("Removing an incomplete destination VPS; the source is unchanged...")
            self.delete_instance(target_api, target_pending[0])
            self.clear_resize_marker(source)

        self.ensure_device_access(source_api, source)
        self.wait_for_cloud_init(source)
        self.ensure_resize_source_ready(source, measure=False)
        target_plan_id = target_api.plan_ids[ram_gb]
        plan = self.plan_catalog(target_api).get(target_plan_id)
        if not plan:
            raise EnvrError(
                f"{self.provider_label(target_api)} plan {target_plan_id} is unavailable"
            )
        actual_ram = int(plan.get("ram") or 0) // 1024
        size_text = f"{ram_gb} GB"
        if actual_ram != ram_gb:
            size_text += f" ({actual_ram} GB provider size)"
        hourly = plan.get("hourly_cost")
        price_text = (
            f" at {hourly}/hour" if hourly not in (None, "") else " (live price unavailable)"
        )
        print(
            f"Move envr from {self.provider_label(source_api)} to "
            f"{self.provider_label(target_api)}, {size_text}{price_text}?\n\n"
            "Preserved: workspace, Codex state, repository keys, device SSH keys\n"
            "Rebuilt: operating system and standard envr tools\n"
            "Not preserved: Git-ignored files, custom packages, VPNs, "
            "containers, services, or firewall rules"
        )
        if not prompt_yes_no("Continue?"):
            print("Cancelled.")
            return

        self.sync_from_server(source)
        self.set_resize_marker(source, ram_gb)
        target: dict[str, Any] | None = None
        promoted = False
        try:
            target = self.create_instance(
                target_api,
                ram_gb,
                label=RESIZE_TARGET_LABEL,
                cache_state=False,
                prepare_workspace=False,
            )
            self.set_resize_marker(target, ram_gb, role="target")
            token = secrets.token_hex(8)
            public_key, host_key = self.migration_key_and_host(source, target, token)
            try:
                self.prepare_resize_excludes(source, token)
                self.authorize_resize_target(source, target, public_key, token)
                transfer_bytes = self.ensure_resize_source_ready(source)
                self.ensure_resize_capacity(target, transfer_bytes)
                self.quiesce_resize_source(source)
                print("Transferring workspace and Codex state...")
                self.transfer_resize_data(source, target, host_key, token)
            finally:
                self.cleanup_resize_access(source, target, token)
            print("Validating the new VPS...")
            self.validate_resize_target(target)
            promoted = True
            self.set_instance_label(source_api, source, RESIZE_SOURCE_LABEL)
            self.finish_cross_provider_resize(
                source_api,
                target_api,
                target,
                source,
                target_validated=True,
            )
        except (EnvrError, subprocess.TimeoutExpired, KeyboardInterrupt):
            if not promoted and target is not None:
                with contextlib.suppress(EnvrError, subprocess.TimeoutExpired):
                    self.remote_command(
                        source,
                        "sudo systemctl start envr-tmux.service 2>/dev/null || true",
                        quiet=True,
                        timeout=30,
                    )
                with contextlib.suppress(EnvrError, subprocess.TimeoutExpired):
                    self.delete_instance(target_api, target)
                    self.clear_resize_marker(source)
            if promoted:
                eprint(
                    "Warning: destination validation completed, but cleanup is "
                    "incomplete. Run envr resize again; do not delete "
                    "either VPS manually."
                )
            raise

    def resize_options(self, api: Any) -> list[dict[str, Any]]:
        """Return exact, currently deployable configurations for one provider."""
        plans = self.plan_catalog(api)
        self.ubuntu_os_id(api)
        options: list[dict[str, Any]] = []
        seen: set[tuple[str, int]] = set()
        for requested, plan_id in sorted(api.plan_ids.items()):
            plan = plans.get(str(plan_id))
            if not isinstance(plan, dict):
                continue
            actual_ram = int(plan.get("ram") or 0) // 1024
            # Aliases such as a 12 GB request backed by a 16 GB plan are not
            # separate configurations. The menu exposes only what is allocated.
            if actual_ram != requested:
                continue
            key = (str(plan_id), actual_ram)
            if key in seen:
                continue
            try:
                regions = self.available_regions(api, str(plan_id), plan)
            except ApiError:
                raise
            except EnvrError:
                continue
            if not regions:
                continue
            seen.add(key)
            options.append({
                "ram_gb": requested,
                "plan_id": str(plan_id),
                "vcpu_count": int(plan.get("vcpu_count") or 0),
                "region": regions[0],
                "plan": plan,
            })
        return options

    def resize_menu(self) -> None:
        """Choose one live destination and delegate to the transactional resize."""
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        state = self.state()
        source_provider = str(
            state.get("provider") or self.selected_provider()
        )
        source_api = self.api(source_provider)
        current, pending, retired = self.resize_roles(source_api)
        for instance in current + pending + retired:
            self.ensure_device_access(source_api, instance)
        recovery_instances = current + pending + retired
        selected_provider = self.selected_provider()
        if selected_provider != source_provider:
            selected_api = self.api(selected_provider, prompt=False)
            selected_roles = self.resize_roles(selected_api)
            for instance in (item for role in selected_roles for item in role):
                self.ensure_device_access(selected_api, instance)
            recovery_instances.extend(
                instance for role in selected_roles for instance in role
            )
        marker_sizes = {
            marker[1]
            for instance in recovery_instances
            if (marker := self.resize_marker_state(instance)) is not None
            and marker[1] in PLAN_IDS
        }
        if len(marker_sizes) == 1:
            ram_gb = marker_sizes.pop()
            print(f"Resuming the interrupted {ram_gb} GB migration...")
            self.resize(ram_gb)
            return
        if pending or retired or len(marker_sizes) > 1:
            raise EnvrError("resize state is ambiguous; run envr status")
        if len(current) != 1:
            raise EnvrError("envr-codex is not running")

        source = current[0]
        source_plan = self.plan_catalog(source_api).get(
            str(source.get("plan") or ""), {}
        )
        current_price = compact_price(source_plan) if source_plan else "price unavailable"
        print(
            f"Current: {self.provider_label(source_api)} · "
            f"{region_label(str(source.get('region') or ''))} · "
            f"{self.instance_ram_gb(source)} GB · "
            f"{int(source.get('vcpu_count') or 0)} CPU · {current_price}"
        )

        configured = self.configured_providers()
        if not configured:
            raise EnvrError("no cloud provider is configured; run envr cloud")
        print("\nDestination cloud:")
        for index, provider in enumerate(configured, 1):
            suffix = " (current)" if provider == source_provider else ""
            print(f"  {index}. {PROVIDER_LABELS[provider]}{suffix}")
        while True:
            choice = input(f"Choose 1-{len(configured)}, or Q to cancel: ").strip().lower()
            if choice in {"", "q"}:
                print("Cancelled.")
                return
            if choice.isdigit() and 1 <= int(choice) <= len(configured):
                target_provider = configured[int(choice) - 1]
                break
            print(f"Choose 1-{len(configured)}, or Q.")

        target_api = self.api(target_provider, prompt=False)
        self.account_response(target_api)
        options = self.resize_options(target_api)
        provider_available_sizes = {int(option["ram_gb"]) for option in options}
        if target_provider == source_provider:
            current_actual_ram = self.instance_ram_gb(source)
            options = [
                option for option in options
                if int(option["ram_gb"]) != current_actual_ram
            ]
        if not options:
            raise EnvrError(
                f"{self.provider_label(target_api)} has no supported configuration "
                "available in the preferred regions"
            )
        print("\nAvailable configurations:")
        for index, option in enumerate(options, 1):
            print(
                f"  {index}. {option['ram_gb']} GB · "
                f"{option['vcpu_count']} CPU · "
                f"{region_label(str(option['region']))} · "
                f"{compact_price(option['plan'])}"
            )
        unavailable_sizes = [
            size for size in sorted(PLAN_IDS)
            if size not in provider_available_sizes
        ]
        if unavailable_sizes:
            sizes = ", ".join(f"{size} GB" for size in unavailable_sizes)
            print(f"  Exact sizes unavailable: {sizes}")
        while True:
            choice = input(f"Choose 1-{len(options)}, or Q to cancel: ").strip().lower()
            if choice in {"", "q"}:
                print("Cancelled.")
                return
            if choice.isdigit() and 1 <= int(choice) <= len(options):
                option = options[int(choice) - 1]
                break
            print(f"Choose 1-{len(options)}, or Q.")

        atomic_write_json(
            self.cloud_path,
            {"schema": SCHEMA_VERSION, "selected": target_provider},
        )
        self.resize(int(option["ram_gb"]))

    def resize(self, ram_gb: int) -> None:
        if ram_gb not in PLAN_IDS:
            supported = ", ".join(str(size) for size in sorted(PLAN_IDS))
            raise EnvrError(f"RAM must be one of: {supported}")
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        state = self.state()
        if state.get("instance_id"):
            source_provider = str(state.get("provider") or "vultr")
        elif len(self.configured_providers()) > 1:
            candidates: list[str] = []
            for candidate_api, inventory in self.provider_inventories():
                if self.managed_from(inventory) or any(
                    item.get("label") == RESIZE_SOURCE_LABEL
                    for item in self.resize_from(inventory)
                ):
                    candidates.append(self.provider_name(candidate_api))
            if len(candidates) != 1:
                raise EnvrError(
                    "cannot identify one resize source across configured clouds; "
                    "run envr status"
                )
            source_provider = candidates[0]
        else:
            source_provider = self.selected_provider()
        target_provider = self.selected_provider()
        api = self.api(source_provider)
        self.account_response(api)
        if target_provider != source_provider:
            target_api = self.api(target_provider)
            self.account_response(target_api)
            return self.resize_cross_provider(api, target_api, ram_gb)
        current, targets, sources = self.resize_roles(api)
        if any(len(role) > 1 for role in (current, targets, sources)):
            raise EnvrError("ambiguous resize state; run envr status")
        if current and targets and sources:
            raise EnvrError("ambiguous resize state has three managed VPSs")

        if current and not sources and targets:
            print("Removing an incomplete resize target...")
            self.delete_instance(api, targets[0])
            self.clear_resize_marker(current[0])
            targets = []
        if not current and sources and targets:
            target_ram = self.resize_target_ram_gb(targets[0])
            if target_ram != ram_gb:
                raise EnvrError(
                    f"interrupted resize target is {target_ram} GB; "
                    "run envr resize to resume it"
                )
            self.finish_resize(api, targets[0], sources[0])
            return
        if current and sources:
            target_ram = self.resize_target_ram_gb(current[0])
            if target_ram != ram_gb:
                raise EnvrError(
                    f"promoted resize target is {target_ram} GB; "
                    "run envr resize to finish cleanup"
                )
            self.finish_resize(api, current[0], sources[0])
            return
        if not current and sources and not targets:
            self.set_instance_label(api, sources[0], LABEL)
            self.clear_resize_marker(sources[0])
            current = sources
            sources = []
        if len(current) != 1 or targets or sources:
            raise EnvrError("envr-codex is not running or resize state is incomplete")

        source = current[0]
        current_ram = self.requested_ram_gb(source)
        self.ensure_device_access(api, source)
        self.wait_for_cloud_init(source)
        if current_ram == ram_gb:
            marker = self.resize_marker_state(source)
            if marker is not None and marker[0] == "target":
                self.remote_command(
                    source,
                    f"touch {shlex.quote(REMOTE_INITIAL_READY)} && "
                    f"chmod 600 {shlex.quote(REMOTE_INITIAL_READY)}",
                    quiet=True,
                    timeout=30,
                )
                self.clear_resize_marker(source)
                print(f"Resize cleanup complete: {ram_gb} GB.")
                print("Connect with envr go.")
                return
            if marker is not None:
                target_ram = marker[1]
                detail = (
                    "; run envr resize"
                    if target_ram is not None
                    else "; inspect envr status before retrying"
                )
                raise EnvrError(f"resize is incomplete{detail}")
            print(f"envr VPS is already {ram_gb} GB. Connect with envr go.")
            return

        self.ensure_resize_source_ready(source, measure=False)
        print(
            f"Resize envr from {current_ram} GB to {ram_gb} GB?\n\n"
            "Preserved: workspace, Codex state, repository keys\n"
            "Rebuilt: operating system and standard envr tools\n"
            "Not preserved: Git-ignored files, custom packages, VPNs, "
            "containers, services, or firewall rules"
        )
        if not prompt_yes_no("Continue?"):
            print("Cancelled.")
            return None

        self.sync_from_server(source)
        self.set_resize_marker(source, ram_gb)
        target: dict[str, Any] | None = None
        promoted = False
        try:
            target = self.create_instance(
                api,
                ram_gb,
                label=RESIZE_TARGET_LABEL,
                cache_state=False,
                prepare_workspace=False,
            )
            self.set_resize_marker(target, ram_gb, role="target")
            token = secrets.token_hex(8)
            public_key, host_key = self.migration_key_and_host(source, target, token)
            try:
                self.prepare_resize_excludes(source, token)
                self.authorize_resize_target(source, target, public_key, token)
                transfer_bytes = self.ensure_resize_source_ready(source)
                self.ensure_resize_capacity(target, transfer_bytes)
                self.quiesce_resize_source(source)
                print("Transferring workspace and Codex state...")
                self.transfer_resize_data(source, target, host_key, token)
            finally:
                self.cleanup_resize_access(source, target, token)
            print("Validating the new VPS...")
            self.validate_resize_target(target)
            self.set_instance_label(api, source, RESIZE_SOURCE_LABEL)
            promoted = True
            self.finish_resize(api, target, source, target_validated=True)
            return
        except (EnvrError, subprocess.TimeoutExpired, KeyboardInterrupt):
            if not promoted:
                with contextlib.suppress(EnvrError, subprocess.TimeoutExpired):
                    self.remote_command(
                        source,
                        "sudo systemctl start envr-tmux.service 2>/dev/null || true",
                        quiet=True,
                        timeout=30,
                    )
                try:
                    rollback_current, rollback_targets, rollback_sources = (
                        self.resize_roles(api)
                    )
                    if not rollback_sources and len(rollback_current) == 1:
                        for candidate in rollback_targets:
                            self.delete_instance(api, candidate)
                        self.clear_resize_marker(source)
                except (EnvrError, subprocess.TimeoutExpired):
                    eprint(
                        "Warning: resize cleanup could not be confirmed; "
                        "run envr resize again"
                    )
            else:
                eprint(
                    "Warning: the validated destination was promoted, but final "
                    "cleanup is incomplete. The old source may still be running "
                    "and billable. Do not create or delete a VPS manually; when "
                    "the provider API recovers, run envr resize again"
                )
            raise

    def status_api_unavailable(self, error: ApiError) -> int:
        state = self.state()
        provider = str(state.get("provider") or self.selected_provider())
        instance_id = str(state.get("instance_id") or "")
        main_ip = str(state.get("main_ip") or "")
        ram_gb = int(state.get("ram_gb") or 0)
        if not instance_id or not main_ip or not ram_gb:
            print("envr-codex: not running (cached state unavailable)")
            print("Live inventory, billing, and resize state cannot be confirmed.")
        else:
            print("envr-codex")
            print("  Cached envr state (not live API data)")
            print(f"  ID:         {instance_id}")
            print(f"  Region:     {state.get('region') or ''}")
            print(f"  RAM:        {ram_gb} GB")
            print(f"  IP:         {main_ip}")
            print("  Status:     unknown while the cloud API is unavailable")
            print("  Warning:    billing and incomplete resize resources are unknown")
        print("\nClouds")
        print(PROVIDER_LABELS.get(provider, provider))
        print(f"  API:              unavailable ({error})")
        return 1

    def print_instance_status(
        self,
        api: Any,
        instance: dict[str, Any],
        plan: dict[str, Any],
        currency: str,
        *,
        show_cloud: bool = False,
        leading_blank: bool = True,
    ) -> None:
        """Print one VPS as a stable, readable vertical block."""
        try:
            password = self.instance_password(api, instance)
        except EnvrError:
            password = "unavailable from API"
        prefix = "\n" if leading_blank else ""
        print(f"{prefix}{instance.get('label') or LABEL}")
        if show_cloud:
            print(f"  Cloud:      {self.provider_label(api)}")
        print(f"  ID:         {instance.get('id', '')}")
        print(f"  Region:     {instance.get('region', '')}")
        print(f"  RAM:        {self.instance_ram_gb(instance)} GB")
        print(f"  CPU:        {instance.get('vcpu_count', '')}")
        print(f"  IP:         {instance.get('main_ip', '')}")
        print(f"  SSH user:   {REMOTE_USER} (key)")
        print("  Root user:  root")
        print(f"  Password:   {password}")
        print(f"  Status:     {instance.get('status', '')}")
        print(f"  Power:      {instance.get('power_status', '')}")
