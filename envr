class EnvrError(RuntimeError):
    """A concise, expected user-facing error."""


class ApiError(EnvrError):
    def __init__(
        self,
        status: int,
        message: str,
        *,
        retry_after: int | None = None,
        operation: str | None = None,
        provider: str = "Vultr",
    ):
