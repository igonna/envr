class EnvrError(RuntimeError):
    """A concise, expected user-facing error."""


class ApiError(EnvrError):
    def __init__(self, status: int, message: str, *, retry_after: int | None = None):
        self.status = status
        self.message = message
        self.retry_after = retry_after
        super().__init__(message)


def eprint(*values: object) -> None:
    print(*values, file=sys.stderr)


def data_root() -> Path:
    override = os.environ.get("ENVR_HOME")
    return Path(override).expanduser() if override else Path.home() / "envr"


def ensure_private_dir(directory: Path) -> None:
    directory.mkdir(parents=True, exist_ok=True)
    directory.chmod(0o700)


def fsync_directory(directory: Path) -> None:
    try:
        descriptor = os.open(directory, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    ensure_private_dir(path.parent)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=str(path.parent)
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        path.chmod(mode)
        fsync_directory(path.parent)
    finally:
        with contextlib.suppress(FileNotFoundError):
            temporary.unlink()


def atomic_write_text(path: Path, value: str, mode: int = 0o600) -> None:
    atomic_write(path, value.encode("utf-8"), mode)


def atomic_write_json(path: Path, value: dict[str, Any]) -> None:
    content = json.dumps(value, indent=2, sort_keys=True) + "\n"
    atomic_write_text(path, content)


def load_json(path: Path, *, default: dict[str, Any] | None = None) -> dict[str, Any]:
    if not path.exists():
        return {} if default is None else default
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise EnvrError(f"{path} is not valid JSON: {error}") from error
    if not isinstance(value, dict):
        raise EnvrError(f"{path} must contain a JSON object")
    if value.get("schema") != SCHEMA_VERSION:
        raise EnvrError(
            f"{path} has unsupported schema {value.get('schema')!r}; "
            f"expected {SCHEMA_VERSION}"
        )
    return value


@contextlib.contextmanager
def exclusive_lock(root: Path) -> Iterator[None]:
    ensure_private_dir(root)
    lock_path = root / ".lock"
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        lock_path.chmod(0o600)
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        except OSError as error:
            raise EnvrError(f"cannot lock {lock_path}: {error}") from error
        yield


def run(
    command: Sequence[str],
    *,
    input_data: str | bytes | None = None,
    capture: bool = False,
    check: bool = True,
    timeout: int | None = None,
    env: dict[str, str] | None = None,
    quiet: bool = False,
) -> subprocess.CompletedProcess[str]:
    if isinstance(input_data, bytes):
        text_input = input_data.decode("utf-8")
    else:
        text_input = input_data
    result = subprocess.run(
        list(command),
        input=text_input,
        text=True,
        stdout=subprocess.PIPE if capture or quiet else None,
        stderr=subprocess.PIPE if capture or quiet else None,
        check=False,
        timeout=timeout,
        env=env,
    )
    if check and result.returncode != 0:
        detail = ""
        if result.stderr:
            detail = f": {result.stderr.strip()}"
        raise EnvrError(f"{Path(command[0]).name} failed{detail}")
    return result


def prompt_yes_no(prompt: str, *, default: bool = False) -> bool:
    suffix = " [Y/n] " if default else " [y/N] "
    answer = input(prompt + suffix).strip().lower()
    if not answer:
        return default
    return answer in {"y", "yes"}


def package_environment() -> str:
    prefix = os.environ.get("PREFIX", "")
    if "com.termux" in prefix or shutil.which("pkg"):
        return "termux"
    if platform.system() == "Darwin":
        return "macos"
    if platform.system() == "Linux":
        return "linux"
    return "unknown"


def ensure_commands(commands: Sequence[str]) -> None:
    missing = sorted({command for command in commands if shutil.which(command) is None})
    if not missing:
        return

    environment = package_environment()
    if environment == "termux":
        packages = set()
        for command in missing:
            packages.add("git" if command == "git" else "openssh")
        run(["pkg", "install", "-y", *sorted(packages)])
    elif environment == "linux" and shutil.which("apt-get"):
        packages = set()
        for command in missing:
            packages.add("git" if command == "git" else "openssh-client")
        prefix = [] if os.geteuid() == 0 else ["sudo"]
        run([*prefix, "apt-get", "install", "-y", *sorted(packages)])
    elif environment == "macos" and shutil.which("brew"):
        packages = set()
        for command in missing:
            packages.add("git" if command == "git" else "openssh")
        run(["brew", "install", *sorted(packages)])
    else:
        raise EnvrError(
            f"missing {', '.join(missing)}; install Git and OpenSSH, then retry"
        )

    still_missing = [command for command in missing if shutil.which(command) is None]
    if still_missing:
        raise EnvrError(f"still missing after installation: {', '.join(still_missing)}")


def generate_password(length: int = 16) -> str:
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(length))


def available_prepaid_credit(balance: float, pending_charges: float) -> float:
    """Translate Vultr's negative-credit balance into remaining prepaid credit."""
    return max(-balance - pending_charges, 0.0)


REPO_URL_RE = re.compile(
    r"^(?P<user>[^@\s/:]+)@(?P<host>[^:\s/]+):(?P<repo_path>[^\s]+)$"
)
FOLDER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def parse_repository_url(url: str) -> dict[str, str]:
    match = REPO_URL_RE.fullmatch(url.strip())
    if not match:
        raise EnvrError("repository URL must look like git@HOST:OWNER/REPOSITORY.git")
    repository_path = match.group("repo_path").strip("/")
    if repository_path.endswith(".git"):
        repository_path = repository_path[:-4]
    pieces = repository_path.split("/")
    if len(pieces) < 2 or any(piece in {"", ".", ".."} for piece in pieces):
        raise EnvrError("repository URL must contain an owner and repository")
    folder = pieces[-1]
    if not FOLDER_RE.fullmatch(folder):
        raise EnvrError(f"repository folder {folder!r} is not safe")
    identity = "-".join(pieces[-2:])
    return {
        "url": url.strip(),
        "user": match.group("user"),
        "host": match.group("host"),
        "path": repository_path,
        "folder": folder,
        "identity": identity,
    }


def validate_text_field(label: str, value: str) -> str:
    value = value.strip()
    if not value:
        raise EnvrError(f"{label} cannot be empty")
    if any(ord(character) < 32 for character in value):
        raise EnvrError(f"{label} contains control characters")
    return value


class VultrAPI:
    def __init__(self, token: str, base_url: str | None = None):
        self.token = token
        self.base_url = (base_url or os.environ.get("ENVR_VULTR_API") or API_BASE).rstrip(
            "/"
        )

    def request(
        self,
        method: str,
        resource: str,
        *,
        payload: dict[str, Any] | None = None,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        url = self.base_url + "/" + resource.lstrip("/")
        if query:
            url += "?" + urllib.parse.urlencode(query)
        body = None
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json",
            "User-Agent": f"envr/{VERSION}",
        }
        if payload is not None:
            body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(url, data=body, headers=headers, method=method)
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                content = response.read()
        except urllib.error.HTTPError as error:
            try:
                content = error.read()
            finally:
                error.close()
            message = self._error_message(content, error.reason)
            retry_after = None
            with contextlib.suppress(TypeError, ValueError):
                retry_after = int(error.headers.get("Retry-After", ""))
            raise ApiError(error.code, message, retry_after=retry_after) from error
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            raise ApiError(0, f"Vultr API network error: {error}") from error

        if not content:
            return {}
        try:
            value = json.loads(content.decode("utf-8"))
        except (UnicodeError, json.JSONDecodeError) as error:
            raise EnvrError("Vultr API returned malformed JSON") from error
        if not isinstance(value, dict):
            raise EnvrError("Vultr API returned an unexpected response")
        return value

    @staticmethod
    def _error_message(content: bytes, fallback: object) -> str:
        try:
            value = json.loads(content.decode("utf-8"))
            if isinstance(value, dict):
                for key in ("error", "message"):
                    if value.get(key):
                        return str(value[key])
        except (UnicodeError, json.JSONDecodeError):
            pass
        decoded = content.decode("utf-8", errors="replace").strip()
        return decoded or str(fallback)

    def get(
        self, resource: str, *, query: dict[str, str | int] | None = None
    ) -> dict[str, Any]:
        return self.request("GET", resource, query=query)

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        return self.request("POST", resource, payload=payload)

    def delete(self, resource: str) -> None:
        self.request("DELETE", resource)


class Envr:
    def __init__(self, root: Path | None = None):
        self.root = root or data_root()
        self.token_path = self.root / "api"
        self.auth_path = self.root / "codex" / "auth.json"
        self.git_root = self.root / "git"
        self.ssh_root = self.root / "ssh"
        self.vps_key = self.ssh_root / "id_ed25519"
        self.vps_public_key = self.ssh_root / "id_ed25519.pub"
        self.vps_known_hosts = self.ssh_root / "known_hosts"
        self.git_known_hosts = self.ssh_root / "git_known_hosts"
        self.repos_path = self.root / "repos.json"
        self.state_path = self.root / "state.json"
        self.client_id_path = self.root / "client-id"
        self.password_path = self.root / "instance-password"

    def ensure_layout(self) -> None:
        ensure_private_dir(self.root)
        ensure_private_dir(self.git_root)
        ensure_private_dir(self.ssh_root)
        ensure_private_dir(self.auth_path.parent)

    def client_id(self) -> str:
        self.ensure_layout()
        if self.client_id_path.exists():
            value = self.client_id_path.read_text(encoding="utf-8").strip()
            if not re.fullmatch(r"[a-f0-9]{20}", value):
                raise EnvrError(f"{self.client_id_path} is invalid")
            self.client_id_path.chmod(0o600)
            return value
        value = secrets.token_hex(10)
        atomic_write_text(self.client_id_path, value + "\n")
        return value

    def management_tag(self) -> str:
        return f"envr-managed-{self.client_id()}"

    def repositories(self) -> dict[str, Any]:
        default = {"schema": SCHEMA_VERSION, "repositories": {}}
        value = load_json(self.repos_path, default=default)
        repositories = value.get("repositories")
        if not isinstance(repositories, dict):
            raise EnvrError(f"{self.repos_path} has an invalid repositories object")
        return value

    def save_repositories(self, value: dict[str, Any]) -> None:
        value["schema"] = SCHEMA_VERSION
        atomic_write_json(self.repos_path, value)

    def state(self) -> dict[str, Any]:
        return load_json(
            self.state_path,
            default={"schema": SCHEMA_VERSION, "instance_id": None},
        )

    def save_state(self, value: dict[str, Any]) -> None:
        value["schema"] = SCHEMA_VERSION
        atomic_write_json(self.state_path, value)

    def clear_instance_state(self) -> None:
        with contextlib.suppress(FileNotFoundError):
            self.state_path.unlink()
        with contextlib.suppress(FileNotFoundError):
            self.password_path.unlink()
        fsync_directory(self.root)

    def api_token(self) -> str:
        self.ensure_layout()
        if self.token_path.exists():
            self.token_path.chmod(0o600)
            token = self.token_path.read_text(encoding="utf-8").strip()
            if token:
                return token
        token = getpass.getpass("Vultr API token: ").strip()
        if not token:
            raise EnvrError("Vultr API token cannot be empty")
        atomic_write_text(self.token_path, token + "\n")
        return token

    def api(self) -> VultrAPI:
        return VultrAPI(self.api_token())

    def configure_git(self) -> None:
        ensure_commands(("git", "ssh", "ssh-keygen"))
        self.ensure_layout()

        parsed = parse_repository_url(input("Repository SSH URL: ").strip())
        repositories = self.repositories()
        records = repositories["repositories"]
        existing_folder = next(
            (
                folder
                for folder, record in records.items()
                if isinstance(record, dict) and record.get("url") == parsed["url"]
            ),
            None,
        )
        if existing_folder is not None:
            existing = records[existing_folder]
            public_path = Path(existing["public_key"])
            print(f"Repository is already configured as: {existing_folder}")
            if public_path.exists():
                print("\nPUBLIC key:\n")
                print(public_path.read_text(encoding="utf-8").strip())
                print()
            if not prompt_yes_no("Replace its key or Git identity?"):
                return

        collision = records.get(parsed["folder"])
        if collision and collision.get("url") != parsed["url"]:
            raise EnvrError(
                f"folder {parsed['folder']!r} is already used by {collision.get('url')}"
            )

        key_directory = self.git_root / parsed["folder"]
        private_key = key_directory / "id_ed25519"
        public_key = key_directory / "id_ed25519.pub"

        with tempfile.TemporaryDirectory(dir=self.root) as temporary_directory:
            candidate_private = Path(temporary_directory) / "id_ed25519"
            candidate_public = candidate_private.with_suffix(".pub")
            supplied = input(
                "SSH private key path (leave empty to generate one): "
            ).strip()
            if supplied:
                source = Path(supplied).expanduser().resolve()
                if not source.is_file():
                    raise EnvrError(f"SSH private key does not exist: {source}")
                result = run(
                    ["ssh-keygen", "-y", "-P", "", "-f", str(source)],
                    capture=True,
                    check=False,
                )
                if result.returncode != 0 or not result.stdout.strip():
                    raise EnvrError(
                        "SSH private key is invalid or passphrase-protected; "
                        "use a dedicated unencrypted key"
                    )
                atomic_write(candidate_private, source.read_bytes())
                atomic_write_text(
                    candidate_public, result.stdout.strip() + "\n", 0o600
                )
            else:
                run(
                    [
                        "ssh-keygen",
                        "-q",
                        "-t",
                        "ed25519",
                        "-N",
                        "",
                        "-C",
                        f"envr:{parsed['path']}",
                        "-f",
                        str(candidate_private),
                    ]
                )

            author_name = validate_text_field(
                "Git author name", input("Git author name: ")
            )
            author_email = validate_text_field(
                "Git author email", input("Git author email: ")
            )

            print("\nAdd this PUBLIC key to the Git repository or account:\n")
            print(candidate_public.read_text(encoding="utf-8").strip())
            print("\nThe private key is never printed.")
            input("Press Enter after adding the key: ")

            self.verify_repository_access(parsed["url"], candidate_private)
            ensure_private_dir(key_directory)
            atomic_write(private_key, candidate_private.read_bytes())
            atomic_write(public_key, candidate_public.read_bytes())

        records[parsed["folder"]] = {
            "url": parsed["url"],
            "folder": parsed["folder"],
            "identity": parsed["identity"],
            "host": parsed["host"],
            "private_key": str(private_key),
            "public_key": str(public_key),
            "author_name": author_name,
            "author_email": author_email,
        }
        self.save_repositories(repositories)
        print(f"\nSaved repository as: {parsed['folder']}")
        print(f"Run: envr up 4 {parsed['folder']}")

    def verify_repository_access(self, url: str, private_key: Path) -> None:
        ensure_private_dir(self.git_known_hosts.parent)
        self.git_known_hosts.touch(mode=0o600, exist_ok=True)
        self.git_known_hosts.chmod(0o600)
        ssh_command = " ".join(
            shlex.quote(part)
            for part in (
                "ssh",
                "-i",
                str(private_key),
                "-o",
                "IdentitiesOnly=yes",
                "-o",
                "BatchMode=yes",
                "-o",
                "StrictHostKeyChecking=ask",
                "-o",
                f"UserKnownHostsFile={self.git_known_hosts}",
            )
        )
        environment = os.environ.copy()
        environment["GIT_SSH_COMMAND"] = ssh_command
        environment["GIT_TERMINAL_PROMPT"] = "0"
        print("Verifying repository access...")
        result = run(
            ["git", "ls-remote", url],
            env=environment,
            quiet=True,
            check=False,
            timeout=60,
        )
        if result.returncode != 0:
            detail = result.stderr.strip() if result.stderr else "access denied"
            raise EnvrError(f"repository access verification failed: {detail}")

    def repository(self, folder: str) -> dict[str, Any]:
        if not FOLDER_RE.fullmatch(folder):
            raise EnvrError(f"invalid repository folder: {folder!r}")
        record = self.repositories()["repositories"].get(folder)
        if not isinstance(record, dict):
            raise EnvrError(f'Repository "{folder}" is not configured. Run: envr git')
        required = {
            "url",
            "folder",
            "identity",
            "private_key",
            "author_name",
            "author_email",
        }
        if not required.issubset(record):
            raise EnvrError(f"repository configuration for {folder!r} is incomplete")
        private_key = Path(record["private_key"])
        if not private_key.is_file():
            raise EnvrError(f"repository key is missing: {private_key}")
        private_key.chmod(0o600)
        return record

    def ensure_vps_key(self) -> str:
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        self.ensure_layout()
        if not self.vps_key.exists() or not self.vps_public_key.exists():
            with tempfile.TemporaryDirectory(dir=self.root) as temporary_directory:
                temporary_key = Path(temporary_directory) / "id_ed25519"
                run(
                    [
                        "ssh-keygen",
                        "-q",
                        "-t",
                        "ed25519",
                        "-N",
                        "",
                        "-C",
                        f"envr-vultr:{self.client_id()}",
                        "-f",
                        str(temporary_key),
                    ]
                )
                atomic_write(self.vps_key, temporary_key.read_bytes())
                atomic_write(
                    self.vps_public_key, temporary_key.with_suffix(".pub").read_bytes()
                )
        self.vps_key.chmod(0o600)
        self.vps_public_key.chmod(0o600)
        return self.vps_public_key.read_text(encoding="utf-8").strip()

    def ensure_vultr_ssh_key(self, api: VultrAPI, public_key: str) -> str:
        response = api.get("ssh-keys", query={"per_page": 500})
        keys = response.get("ssh_keys")
        if not isinstance(keys, list):
            raise EnvrError("Vultr API returned an invalid SSH-key list")
        normalized = public_key.strip()
        for key in keys:
            if isinstance(key, dict) and str(key.get("ssh_key", "")).strip() == normalized:
                return str(key["id"])
        created = api.post(
            "ssh-keys",
            {"name": f"envr-{self.client_id()}", "ssh_key": normalized},
        ).get("ssh_key")
        if not isinstance(created, dict) or not created.get("id"):
            raise EnvrError("Vultr API did not return the uploaded SSH-key ID")
        return str(created["id"])

    def managed_instances(self, api: VultrAPI) -> list[dict[str, Any]]:
        response = api.get("instances", query={"per_page": 500})
        instances = response.get("instances")
        if not isinstance(instances, list):
            raise EnvrError("Vultr API returned an invalid instance list")
        tag = self.management_tag()
        managed = [
            instance
            for instance in instances
            if isinstance(instance, dict)
            and tag in (instance.get("tags") or [])
            and instance.get("label") == LABEL
        ]
        return sorted(managed, key=lambda item: str(item.get("date_created", "")))

    def resolve_single_instance(
        self, api: VultrAPI, *, allow_none: bool = True
    ) -> dict[str, Any] | None:
        instances = self.managed_instances(api)
        if len(instances) > 1:
            raise EnvrError(
                f"conflict: {len(instances)} envr-managed instances exist; "
                "run envr status, then envr destroy"
            )
        if not instances:
            if allow_none:
                return None
            raise EnvrError("envr-codex is not running")
        instance = instances[0]
        previous = self.state()
        same_instance = previous.get("instance_id") == instance.get("id")
        self.save_state(
            {
                "schema": SCHEMA_VERSION,
                "instance_id": instance.get("id"),
                "ram_gb": int(instance.get("ram", 0)) // 1024,
                "region": instance.get("region"),
                "password_ready": (
                    bool(previous.get("password_ready")) if same_instance else False
                ),
            }
        )
        return instance

    def plan_catalog(self, api: VultrAPI) -> dict[str, dict[str, Any]]:
        response = api.get("plans", query={"type": "vc2", "per_page": 500})
        plans = response.get("plans")
        if not isinstance(plans, list):
            raise EnvrError("Vultr API returned an invalid plan catalog")
        return {
            str(plan["id"]): plan
            for plan in plans
            if isinstance(plan, dict) and plan.get("id")
        }

    def ubuntu_os_id(self, api: VultrAPI) -> int:
        response = api.get("os", query={"per_page": 500})
        systems = response.get("os")
        if not isinstance(systems, list):
            raise EnvrError("Vultr API returned an invalid OS catalog")
        exact = [
            system
            for system in systems
            if isinstance(system, dict)
            and system.get("name") == "Ubuntu 24.04 LTS x64"
            and system.get("family") == "ubuntu"
            and system.get("arch") == "x64"
        ]
        if len(exact) != 1:
            raise EnvrError("Ubuntu 24.04 LTS x64 is not uniquely available")
        return int(exact[0]["id"])

    def available_regions(
        self, api: VultrAPI, plan_id: str, plan: dict[str, Any]
    ) -> list[str]:
        advertised = plan.get("locations", [])
        candidates = [region for region in REGIONS if region in advertised]
        available = []
        for region in candidates:
            response = api.get(f"regions/{region}/availability")
            plans = response.get("available_plans")
            if isinstance(plans, list) and plan_id in plans:
                available.append(region)
        if not available:
            raise EnvrError(
                f"{plan_id} is unavailable in configured regions: "
                + ", ".join(REGIONS)
            )
        return available

