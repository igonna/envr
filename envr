    @staticmethod
    def validate_auth_file(path: Path) -> None:
        if not path.is_file() or path.stat().st_size == 0:
            raise EnvrError(f"Codex auth file is empty: {path}")
        try:
            value = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as error:
            raise EnvrError(f"Codex auth file is invalid JSON: {path}") from error
        if not isinstance(value, dict) or not value:
            raise EnvrError(f"Codex auth file does not contain credentials: {path}")

    def pull_auth(self, instance: dict[str, Any]) -> bool:
        result = self.remote_command(
            instance,
            f"test -s {REMOTE_HOME}/.codex/auth.json && "
            f"sha256sum {REMOTE_HOME}/.codex/auth.json",
            capture=True,
            check=False,
            timeout=30,
        )
        if result.returncode != 0 or not result.stdout.strip():
            return False
        remote_hash = result.stdout.split()[0]
        if self.auth_path.exists():
            local_hash = hashlib.sha256(self.auth_path.read_bytes()).hexdigest()
            if local_hash == remote_hash:
                return True

        ensure_private_dir(self.auth_path.parent)
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=".auth.json.", dir=self.auth_path.parent
        )
        os.close(descriptor)
        temporary = Path(temporary_name)
        try:
            run(
                [
                    "scp",
                    *self.scp_options(instance),
                    f"{self.ssh_target(instance)}:{REMOTE_HOME}/.codex/auth.json",
                    str(temporary),
                ],
                quiet=True,
                timeout=120,
            )
            temporary.chmod(0o600)
            self.validate_auth_file(temporary)
            downloaded_hash = hashlib.sha256(temporary.read_bytes()).hexdigest()
            if downloaded_hash != remote_hash:
                raise EnvrError("Codex auth changed during download; retry")
            os.replace(temporary, self.auth_path)
            self.auth_path.chmod(0o600)
            fsync_directory(self.auth_path.parent)
            return True
        finally:
            with contextlib.suppress(FileNotFoundError):
                temporary.unlink()

    @staticmethod
    def portable_repository(repository: dict[str, Any]) -> dict[str, str]:
        return {
            key: str(repository[key])
            for key in (
                "url",
                "folder",
                "identity",
                "host",
                "author_name",
                "author_email",
            )
        }

    def update_remote_manifest(
        self, instance: dict[str, Any], repository: dict[str, Any]
    ) -> None:
        record = self.portable_repository(repository)
        encoded = base64.b64encode(
            json.dumps(record, separators=(",", ":")).encode()
        ).decode()
        script = f"""set -euo pipefail
install -d -m 700 {shlex.quote(REMOTE_CONFIG_ROOT)}
python3 - "$1" {shlex.quote(REMOTE_REPOS)} <<'PY'
import base64
import json
import os
import sys
import tempfile

record = json.loads(base64.b64decode(sys.argv[1]).decode())
path = sys.argv[2]
value = {{"schema": {SCHEMA_VERSION}, "repositories": {{}}}}
try:
    with open(path, encoding="utf-8") as source:
        existing = json.load(source)
    if (
        isinstance(existing, dict)
        and existing.get("schema") == {SCHEMA_VERSION}
        and isinstance(existing.get("repositories"), dict)
    ):
        value = existing
except FileNotFoundError:
    pass
value["repositories"][record["folder"]] = record
descriptor, temporary = tempfile.mkstemp(prefix=".repos.", dir=os.path.dirname(path))
try:
    os.fchmod(descriptor, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as output:
        json.dump(value, output, indent=2, sort_keys=True)
        output.write("\\n")
        output.flush()
        os.fsync(output.fileno())
    os.replace(temporary, path)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
"""
        self.remote_script(instance, script, (encoded,), timeout=60)

    def sync_from_server(self, instance: dict[str, Any]) -> bool:
        auth_synchronized = self.pull_auth(instance)
        available = self.remote_command(
            instance,
            f"test -s {shlex.quote(REMOTE_REPOS)}",
            check=False,
            quiet=True,
            timeout=30,
        )
        if available.returncode != 0:
            return auth_synchronized

        self.ensure_layout()
        descriptor, manifest_name = tempfile.mkstemp(
            prefix=".server-repos.", dir=self.root
        )
        os.close(descriptor)
        manifest_path = Path(manifest_name)
        try:
            run(
                [
                    "scp",
                    *self.scp_options(instance),
                    f"{self.ssh_target(instance)}:{REMOTE_REPOS}",
                    str(manifest_path),
                ],
                quiet=True,
                timeout=120,
            )
            manifest_path.chmod(0o600)
            remote_manifest = load_json(manifest_path)
        finally:
            with contextlib.suppress(FileNotFoundError):
                manifest_path.unlink()

        remote_records = remote_manifest.get("repositories")
        if not isinstance(remote_records, dict):
            raise EnvrError("server repository manifest is invalid")
        local_manifest = self.repositories()
        local_records = local_manifest["repositories"]
        validated_records: list[tuple[str, dict[str, Any]]] = []
        for folder, record in remote_records.items():
            if not isinstance(folder, str) or not isinstance(record, dict):
                raise EnvrError("server repository manifest contains an invalid entry")
            parsed = parse_repository_url(str(record.get("url", "")))
            if folder != parsed["folder"] or record.get("folder") != folder:
                raise EnvrError("server repository manifest has a folder mismatch")
            if (
                record.get("identity") != parsed["identity"]
                or record.get("host") != parsed["host"]
            ):
                raise EnvrError("server repository manifest has an identity mismatch")
            for field in ("identity", "host", "author_name", "author_email"):
                validate_text_field(field, str(record.get(field, "")))
            validated_records.append((folder, record))

        def fetch_repository_key(
            item: tuple[str, dict[str, Any]]
        ) -> tuple[str, dict[str, str]]:
            folder, record = item
            key_directory = self.git_root / folder
            ensure_private_dir(key_directory)
            private_key = key_directory / "id_ed25519"
            public_key = key_directory / "id_ed25519.pub"
            descriptor, candidate_name = tempfile.mkstemp(
                prefix=".id_ed25519.", dir=key_directory
            )
            os.close(descriptor)
            candidate = Path(candidate_name)
            try:
                run(
                    [
                        "scp",
                        *self.scp_options(instance),
                        f"{self.ssh_target(instance)}:"
                        f"{REMOTE_HOME}/.ssh/envr/{folder}",
                        str(candidate),
                    ],
                    quiet=True,
                    timeout=120,
                )
                candidate.chmod(0o600)
                derived = run(
                    ["ssh-keygen", "-y", "-P", "", "-f", str(candidate)],
                    capture=True,
                    quiet=True,
                ).stdout.strip()
                if not derived:
                    raise EnvrError(f"server repository key is invalid: {folder}")
                atomic_write(private_key, candidate.read_bytes())
                atomic_write_text(public_key, derived + "\n")
            finally:
                with contextlib.suppress(FileNotFoundError):
                    candidate.unlink()
            return folder, {
                **self.portable_repository(record),
                "private_key": str(private_key),
                "public_key": str(public_key),
            }

        if validated_records:
            with concurrent.futures.ThreadPoolExecutor(
                max_workers=min(4, len(validated_records))
            ) as executor:
                for folder, local_record in executor.map(
                    fetch_repository_key, validated_records
                ):
                    local_records[folder] = local_record
        self.save_repositories(local_manifest)

        return auth_synchronized

