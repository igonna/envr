class EnvrError(RuntimeError):
    """A concise, expected user-facing error."""


class ApiError(EnvrError):
    def __init__(self, status: int, message: str, *, retry_after: int | None = None):
        self.status = status
        self.message = message
        self.retry_after = retry_after
        super().__init__(message)


def eprint(*values: object) -> None:
    print(*values, file=sys.stderr)


def data_root() -> Path:
    override = os.environ.get("ENVR_HOME")
    if override:
        return Path(override).expanduser()
    config_home = os.environ.get("XDG_CONFIG_HOME")
    base = Path(config_home).expanduser() if config_home else Path.home() / ".config"
    return base / "envr"


def ensure_private_dir(directory: Path) -> None:
    directory.mkdir(parents=True, exist_ok=True)
    directory.chmod(0o700)


def fsync_directory(directory: Path) -> None:
    try:
        descriptor = os.open(directory, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    ensure_private_dir(path.parent)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=str(path.parent)
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        path.chmod(mode)
        fsync_directory(path.parent)
    finally:
        with contextlib.suppress(FileNotFoundError):
            temporary.unlink()


def atomic_write_text(path: Path, value: str, mode: int = 0o600) -> None:
    atomic_write(path, value.encode("utf-8"), mode)


def atomic_write_json(path: Path, value: dict[str, Any]) -> None:
    content = json.dumps(value, indent=2, sort_keys=True) + "\n"
    atomic_write_text(path, content)


def load_json(path: Path, *, default: dict[str, Any] | None = None) -> dict[str, Any]:
    if not path.exists():
        return {} if default is None else default
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise EnvrError(f"{path} is not valid JSON: {error}") from error
    if not isinstance(value, dict):
        raise EnvrError(f"{path} must contain a JSON object")
    if value.get("schema") != SCHEMA_VERSION:
        raise EnvrError(
            f"{path} has unsupported schema {value.get('schema')!r}; "
            f"expected {SCHEMA_VERSION}"
        )
    return value


@contextlib.contextmanager
def exclusive_lock(root: Path) -> Iterator[None]:
    ensure_private_dir(root)
    lock_path = root / ".lock"
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        lock_path.chmod(0o600)
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        except OSError as error:
            raise EnvrError(f"cannot lock {lock_path}: {error}") from error
        yield


def run(
    command: Sequence[str],
    *,
    input_data: str | bytes | None = None,
    capture: bool = False,
    check: bool = True,
    timeout: int | None = None,
    env: dict[str, str] | None = None,
    quiet: bool = False,
) -> subprocess.CompletedProcess[str]:
    if isinstance(input_data, bytes):
        text_input = input_data.decode("utf-8")
    else:
        text_input = input_data
    result = subprocess.run(
        list(command),
        input=text_input,
        text=True,
        stdout=subprocess.PIPE if capture or quiet else None,
        stderr=subprocess.PIPE if capture or quiet else None,
        check=False,
        timeout=timeout,
        env=env,
    )
    if check and result.returncode != 0:
        detail = ""
        if result.stderr:
            detail = f": {result.stderr.strip()}"
        raise EnvrError(f"{Path(command[0]).name} failed{detail}")
    return result


def prompt_yes_no(prompt: str, *, default: bool = False) -> bool:
    suffix = " [Y/n] " if default else " [y/N] "
    answer = input(prompt + suffix).strip().lower()
    if not answer:
        return default
    return answer in {"y", "yes"}


def package_environment() -> str:
    prefix = os.environ.get("PREFIX", "")
    if "com.termux" in prefix or shutil.which("pkg"):
        return "termux"
    if platform.system() == "Darwin":
        return "macos"
    if platform.system() == "Linux":
        return "linux"
    return "unknown"


def ensure_commands(commands: Sequence[str]) -> None:
    missing = sorted({command for command in commands if shutil.which(command) is None})
    if not missing:
        return

    environment = package_environment()
    if environment == "termux":
        run(["pkg", "install", "-y", "openssh"])
    elif environment == "linux" and shutil.which("apt-get"):
        prefix = [] if os.geteuid() == 0 else ["sudo"]
        run([*prefix, "apt-get", "install", "-y", "openssh-client"])
    elif environment == "macos" and shutil.which("brew"):
        run(["brew", "install", "openssh"])
    else:
        raise EnvrError(
            f"missing {', '.join(missing)}; install OpenSSH, then retry"
        )

    still_missing = [command for command in missing if shutil.which(command) is None]
    if still_missing:
        raise EnvrError(f"still missing after installation: {', '.join(still_missing)}")


def available_prepaid_credit(balance: float, pending_charges: float) -> float:
    """Translate Vultr's negative-credit balance into remaining prepaid credit."""
    return max(-balance - pending_charges, 0.0)


REPO_URL_RE = re.compile(
    r"^(?P<user>[^@\s/:]+)@(?P<host>[^:\s/]+):(?P<repo_path>[^\s]+)$"
)
FOLDER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def parse_repository_url(url: str) -> dict[str, str]:
    match = REPO_URL_RE.fullmatch(url.strip())
    if not match:
        raise EnvrError("repository URL must look like git@HOST:OWNER/REPOSITORY.git")
    repository_path = match.group("repo_path").strip("/")
    if repository_path.endswith(".git"):
        repository_path = repository_path[:-4]
    pieces = repository_path.split("/")
    if len(pieces) < 2 or any(piece in {"", ".", ".."} for piece in pieces):
        raise EnvrError("repository URL must contain an owner and repository")
    folder = pieces[-1]
    if not FOLDER_RE.fullmatch(folder):
        raise EnvrError(f"repository folder {folder!r} is not safe")
    identity = "-".join(pieces[-2:])
    return {
        "url": url.strip(),
        "user": match.group("user"),
        "host": match.group("host"),
        "path": repository_path,
        "folder": folder,
        "identity": identity,
    }


def validate_text_field(label: str, value: str) -> str:
    value = value.strip()
    if not value:
        raise EnvrError(f"{label} cannot be empty")
    if any(ord(character) < 32 for character in value):
        raise EnvrError(f"{label} contains control characters")
    return value


class VultrAPI:
    def __init__(self, token: str, base_url: str | None = None):
        self.token = token
        self.base_url = (base_url or os.environ.get("ENVR_VULTR_API") or API_BASE).rstrip(
            "/"
        )

    def request(
        self,
        method: str,
        resource: str,
        *,
        payload: dict[str, Any] | None = None,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        url = self.base_url + "/" + resource.lstrip("/")
        if query:
            url += "?" + urllib.parse.urlencode(query)
        body = None
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json",
            "User-Agent": f"envr/{VERSION}",
        }
        if payload is not None:
            body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(url, data=body, headers=headers, method=method)
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                content = response.read()
        except urllib.error.HTTPError as error:
            try:
                content = error.read()
            finally:
                error.close()
            message = self._error_message(content, error.reason)
            retry_after = None
            with contextlib.suppress(TypeError, ValueError):
                retry_after = int(error.headers.get("Retry-After", ""))
            raise ApiError(error.code, message, retry_after=retry_after) from error
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            raise ApiError(0, f"Vultr API network error: {error}") from error

        if not content:
            return {}
        try:
            value = json.loads(content.decode("utf-8"))
        except (UnicodeError, json.JSONDecodeError) as error:
            raise EnvrError("Vultr API returned malformed JSON") from error
        if not isinstance(value, dict):
            raise EnvrError("Vultr API returned an unexpected response")
        return value

    @staticmethod
    def _error_message(content: bytes, fallback: object) -> str:
        try:
            value = json.loads(content.decode("utf-8"))
            if isinstance(value, dict):
                for key in ("error", "message"):
                    if value.get(key):
                        return str(value[key])
        except (UnicodeError, json.JSONDecodeError):
            pass
        decoded = content.decode("utf-8", errors="replace").strip()
        return decoded or str(fallback)

    def get(
        self,
        resource: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        return self.request("GET", resource, query=query, timeout=timeout)

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        return self.request("POST", resource, payload=payload)

    def delete(self, resource: str) -> None:
        self.request("DELETE", resource)


class Envr:
    def __init__(self, root: Path | None = None):
        self.root = root or data_root()
        self.token_path = self.root / "api"
        self.auth_path = self.root / "codex" / "auth.json"
        self.git_root = self.root / "git"
        self.ssh_root = self.root / "ssh"
        self.vps_key = self.ssh_root / "id_ed25519"
        self.vps_public_key = self.ssh_root / "id_ed25519.pub"
        self.vps_known_hosts = self.ssh_root / "known_hosts"
        self.repos_path = self.root / "repos.json"
        self.state_path = self.root / "state.json"
        self.password_path = self.root / "instance-password"
        if root is None:
            self.migrate_legacy_layout()

    def migrate_legacy_layout(self) -> None:
        legacy = Path.home() / "envr"
        if self.root == legacy or not legacy.is_dir():
            return
        names = (
            "api",
            "codex",
            "git",
            "ssh",
            "repos.json",
            "state.json",
            "instance-password",
            "client-id",
        )
        candidates = [name for name in names if (legacy / name).exists()]
        if not candidates:
            return
        ensure_private_dir(self.root)
        moved = []
        for name in candidates:
            source = legacy / name
            destination = self.root / name
            if destination.exists():
                continue
            ensure_private_dir(destination.parent)
            os.replace(source, destination)
            moved.append(name)
        if moved:
            print(f"Migrated envr state to {self.root}")

    def ensure_layout(self) -> None:
        ensure_private_dir(self.root)
        ensure_private_dir(self.git_root)
        ensure_private_dir(self.ssh_root)
        ensure_private_dir(self.auth_path.parent)

    def management_tag(self) -> str:
        return MANAGEMENT_TAG

    def repositories(self) -> dict[str, Any]:
        default = {"schema": SCHEMA_VERSION, "repositories": {}}
        value = load_json(self.repos_path, default=default)
        repositories = value.get("repositories")
        if not isinstance(repositories, dict):
            raise EnvrError(f"{self.repos_path} has an invalid repositories object")
        return value

    def save_repositories(self, value: dict[str, Any]) -> None:
        value["schema"] = SCHEMA_VERSION
        atomic_write_json(self.repos_path, value)

    def state(self) -> dict[str, Any]:
        return load_json(
            self.state_path,
            default={"schema": SCHEMA_VERSION, "instance_id": None},
        )

    def save_state(self, value: dict[str, Any]) -> None:
        value["schema"] = SCHEMA_VERSION
        atomic_write_json(self.state_path, value)

    def save_instance_state(
        self,
        instance: dict[str, Any],
        *,
        ram_gb: int | None = None,
        region: str | None = None,
    ) -> None:
        instance_id = str(instance.get("id") or "")
        if not instance_id:
            raise EnvrError("cannot cache an instance without an ID")
        existing = self.state()
        if existing.get("instance_id") != instance_id:
            existing = {}
        main_ip = str(instance.get("main_ip") or existing.get("main_ip") or "")
        value: dict[str, Any] = {
            "schema": SCHEMA_VERSION,
            "instance_id": instance_id,
            "ram_gb": (
                ram_gb
                if ram_gb is not None
                else int(instance.get("ram") or 0) // 1024
            ),
            "region": region or instance.get("region") or existing.get("region"),
        }
        if main_ip and main_ip != "0.0.0.0":
            try:
                address = ipaddress.ip_address(main_ip)
            except ValueError as error:
                raise EnvrError("Vultr returned an invalid instance IP address") from error
            if address.version != 4:
                raise EnvrError("envr requires a public IPv4 address")
            value["main_ip"] = main_ip
        self.save_state(value)
        password = str(instance.get("default_password") or "").strip()
        if password:
            atomic_write_text(self.password_path, password + "\n")

    def cached_instance(self, ram_gb: int) -> dict[str, Any] | None:
        state = self.state()
        instance_id = str(state.get("instance_id") or "")
        main_ip = str(state.get("main_ip") or "")
        try:
            cached_ram_gb = int(state.get("ram_gb") or 0)
        except (TypeError, ValueError):
            return None
        if (
            not instance_id
            or cached_ram_gb != ram_gb
            or not self.vps_key.is_file()
            or not self.vps_known_hosts.is_file()
        ):
            return None
        if not main_ip:
            main_ip = self.single_known_host_ip() or ""
            if main_ip:
                self.save_instance_state(
                    {
                        "id": instance_id,
                        "main_ip": main_ip,
                        "ram": ram_gb * 1024,
                        "region": state.get("region"),
                    }
                )
        if not main_ip:
            return None
        try:
            address = ipaddress.ip_address(main_ip)
        except ValueError:
            return None
        if address.version != 4:
            return None
        return {
            "id": instance_id,
            "main_ip": main_ip,
            "ram": ram_gb * 1024,
            "region": state.get("region"),
            "status": "active",
            "power_status": "running",
        }

    def single_known_host_ip(self) -> str | None:
        try:
            lines = self.vps_known_hosts.read_text(encoding="utf-8").splitlines()
        except (FileNotFoundError, OSError, UnicodeError):
            return None
        addresses: set[str] = set()
        for line in lines:
            fields = line.strip().split()
            if not fields or fields[0].startswith("#"):
                continue
            host_field_index = 1 if fields[0].startswith("@") else 0
            if len(fields) <= host_field_index:
                continue
            for host in fields[host_field_index].split(","):
                candidate = host
                if host.startswith("[") and "]:" in host:
                    candidate = host[1 : host.index("]:")]
                try:
                    address = ipaddress.ip_address(candidate)
                except ValueError:
                    continue
                if address.version == 4:
                    addresses.add(str(address))
        if len(addresses) == 1:
            return addresses.pop()
        return None

    def clear_instance_state(self) -> None:
        with contextlib.suppress(FileNotFoundError):
            self.state_path.unlink()
        with contextlib.suppress(FileNotFoundError):
            self.password_path.unlink()
        fsync_directory(self.root)

    def api_token(self) -> str:
        self.ensure_layout()
        if self.token_path.exists():
            self.token_path.chmod(0o600)
            token = self.token_path.read_text(encoding="utf-8").strip()
            if token:
                return token
        token = getpass.getpass("Vultr API token: ").strip()
        if not token:
            raise EnvrError("Vultr API token cannot be empty")
        return token

    def api(self) -> VultrAPI:
        saved = self.token_path.exists() and bool(
            self.token_path.read_text(encoding="utf-8").strip()
        )
        token = self.api_token()
        api = VultrAPI(token)
        if not saved:
            print("Verifying Vultr API token...")
            api.get("account")
            atomic_write_text(self.token_path, token + "\n")
            print(f"Vultr API token verified and saved to {self.token_path}")
        return api

    def configure_git(self) -> None:
        ensure_commands(("ssh-keygen",))
        self.ensure_layout()

        parsed = parse_repository_url(input("Repository SSH URL: ").strip())
        repositories = self.repositories()
        records = repositories["repositories"]
        existing_folder = next(
            (
                folder
                for folder, record in records.items()
                if isinstance(record, dict) and record.get("url") == parsed["url"]
            ),
            None,
        )
        if existing_folder is not None:
            existing = records[existing_folder]
            public_path = Path(existing["public_key"])
            print(f"Repository is already configured as: {existing_folder}")
            if public_path.exists():
                print("\nPUBLIC key:\n")
                print(public_path.read_text(encoding="utf-8").strip())
                print()
            if not prompt_yes_no("Replace its key or Git identity?"):
                return

        collision = records.get(parsed["folder"])
        if collision and collision.get("url") != parsed["url"]:
            raise EnvrError(
                f"folder {parsed['folder']!r} is already used by {collision.get('url')}"
            )

        key_directory = self.git_root / parsed["folder"]
        private_key = key_directory / "id_ed25519"
        public_key = key_directory / "id_ed25519.pub"

        with tempfile.TemporaryDirectory(dir=self.root) as temporary_directory:
            candidate_private = Path(temporary_directory) / "id_ed25519"
            candidate_public = candidate_private.with_suffix(".pub")
            supplied = input(
                "SSH private key path (leave empty to generate one): "
            ).strip()
            if supplied:
                source = Path(supplied).expanduser().resolve()
                if not source.is_file():
                    raise EnvrError(f"SSH private key does not exist: {source}")
                result = run(
                    ["ssh-keygen", "-y", "-P", "", "-f", str(source)],
                    capture=True,
                    check=False,
                )
                if result.returncode != 0 or not result.stdout.strip():
                    raise EnvrError(
                        "SSH private key is invalid or passphrase-protected; "
                        "use a dedicated unencrypted key"
                    )
                atomic_write(candidate_private, source.read_bytes())
                atomic_write_text(
                    candidate_public, result.stdout.strip() + "\n", 0o600
                )
            else:
                run(
                    [
                        "ssh-keygen",
                        "-q",
                        "-t",
                        "ed25519",
                        "-N",
                        "",
                        "-C",
                        f"envr:{parsed['path']}",
                        "-f",
                        str(candidate_private),
                    ]
                )

            author_name = validate_text_field(
                "Git author name", input("Git author name: ")
            )
            author_email = validate_text_field(
                "Git author email", input("Git author email: ")
            )

            print("\nAdd this PUBLIC key to the Git repository or account:\n")
            print(candidate_public.read_text(encoding="utf-8").strip())
            print("\nThe private key is never printed.")
            input("Press Enter after adding the key: ")

            ensure_private_dir(key_directory)
            atomic_write(private_key, candidate_private.read_bytes())
            atomic_write(public_key, candidate_public.read_bytes())

        records[parsed["folder"]] = {
            "url": parsed["url"],
            "folder": parsed["folder"],
            "identity": parsed["identity"],
            "host": parsed["host"],
            "private_key": str(private_key),
            "public_key": str(public_key),
            "author_name": author_name,
            "author_email": author_email,
        }
        self.save_repositories(repositories)
        print(f"\nSaved repository as: {parsed['folder']}")
        print(f"Run: envr up 4 {parsed['folder']}")

    def repository(self, folder: str) -> dict[str, Any]:
        if not FOLDER_RE.fullmatch(folder):
            raise EnvrError(f"invalid repository folder: {folder!r}")
        record = self.repositories()["repositories"].get(folder)
        if not isinstance(record, dict):
            raise EnvrError(f'Repository "{folder}" is not configured. Run: envr git')
        required = {
            "url",
            "folder",
            "identity",
            "host",
            "private_key",
            "author_name",
            "author_email",
        }
        if not required.issubset(record):
            raise EnvrError(f"repository configuration for {folder!r} is incomplete")
        private_key = Path(record["private_key"])
        if not private_key.is_file():
            raise EnvrError(f"repository key is missing: {private_key}")
        private_key.chmod(0o600)
        return record

    def ensure_vps_key(self) -> str:
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        self.ensure_layout()
        if not self.vps_key.exists() or not self.vps_public_key.exists():
            with tempfile.TemporaryDirectory(dir=self.root) as temporary_directory:
                temporary_key = Path(temporary_directory) / "id_ed25519"
                run(
                    [
                        "ssh-keygen",
                        "-q",
                        "-t",
                        "ed25519",
                        "-N",
                        "",
                        "-C",
                        f"envr-device:{platform.node() or 'device'}",
                        "-f",
                        str(temporary_key),
                    ]
                )
                atomic_write(self.vps_key, temporary_key.read_bytes())
                atomic_write(
                    self.vps_public_key, temporary_key.with_suffix(".pub").read_bytes()
                )
        self.vps_key.chmod(0o600)
        self.vps_public_key.chmod(0o600)
        return self.vps_public_key.read_text(encoding="utf-8").strip()

    def ensure_vultr_ssh_key(self, api: VultrAPI, public_key: str) -> str:
        response = api.get("ssh-keys", query={"per_page": 500})
        keys = response.get("ssh_keys")
        if not isinstance(keys, list):
            raise EnvrError("Vultr API returned an invalid SSH-key list")
        normalized = public_key.strip()
        for key in keys:
            if isinstance(key, dict) and str(key.get("ssh_key", "")).strip() == normalized:
                return str(key["id"])
        created = api.post(
            "ssh-keys",
            {
                "name": DEVICE_KEY_PREFIX
                + hashlib.sha256(normalized.encode()).hexdigest()[:12],
                "ssh_key": normalized,
            },
        ).get("ssh_key")
        if not isinstance(created, dict) or not created.get("id"):
            raise EnvrError("Vultr API did not return the uploaded SSH-key ID")
        return str(created["id"])

    def managed_vultr_ssh_keys(
        self, api: VultrAPI, *, timeout: int = 30
    ) -> list[dict[str, Any]]:
        response = api.get("ssh-keys", query={"per_page": 500}, timeout=timeout)
        keys = response.get("ssh_keys")
        if not isinstance(keys, list):
            raise EnvrError("Vultr API returned an invalid SSH-key list")
        managed = [
            key
            for key in keys
            if isinstance(key, dict)
            and str(key.get("name", "")).startswith(("envr-", DEVICE_KEY_PREFIX))
            and key.get("id")
            and key.get("ssh_key")
        ]
        return sorted(managed, key=lambda key: str(key.get("id")))

    def managed_instances(self, api: VultrAPI) -> list[dict[str, Any]]:
        response = api.get("instances", query={"per_page": 500})
        instances = response.get("instances")
        if not isinstance(instances, list):
            raise EnvrError("Vultr API returned an invalid instance list")
        tag = self.management_tag()
        managed = [
            instance
            for instance in instances
            if isinstance(instance, dict)
            and any(
                str(instance_tag) == tag
                or str(instance_tag).startswith(tag + "-")
                for instance_tag in (instance.get("tags") or [])
            )
            and instance.get("label") == LABEL
        ]
        return sorted(managed, key=lambda item: str(item.get("date_created", "")))

    def resolve_single_instance(
        self, api: VultrAPI, *, allow_none: bool = True
    ) -> dict[str, Any] | None:
        instances = self.managed_instances(api)
        if len(instances) > 1:
            raise EnvrError(
                f"conflict: {len(instances)} envr-managed instances exist; "
                "run envr status, then envr destroy"
            )
        if not instances:
            if allow_none:
                return None
            raise EnvrError("envr-codex is not running")
        instance = instances[0]
        self.save_instance_state(instance)
        return instance

    def plan_catalog(self, api: VultrAPI) -> dict[str, dict[str, Any]]:
        response = api.get("plans", query={"type": "vc2", "per_page": 500})
        plans = response.get("plans")
        if not isinstance(plans, list):
            raise EnvrError("Vultr API returned an invalid plan catalog")
        return {
            str(plan["id"]): plan
            for plan in plans
            if isinstance(plan, dict) and plan.get("id")
        }

    def ubuntu_os_id(self, api: VultrAPI) -> int:
        response = api.get("os", query={"per_page": 500})
        systems = response.get("os")
        if not isinstance(systems, list):
            raise EnvrError("Vultr API returned an invalid OS catalog")
        exact = [
            system
            for system in systems
            if isinstance(system, dict)
            and system.get("name") == "Ubuntu 24.04 LTS x64"
            and system.get("family") == "ubuntu"
            and system.get("arch") == "x64"
        ]
        if len(exact) != 1:
            raise EnvrError("Ubuntu 24.04 LTS x64 is not uniquely available")
        return int(exact[0]["id"])

    def available_regions(
        self, api: VultrAPI, plan_id: str, plan: dict[str, Any]
    ) -> list[str]:
        advertised = plan.get("locations", [])
        candidates = [region for region in REGIONS if region in advertised]
        available = []
        for region in candidates:
            response = api.get(f"regions/{region}/availability")
            plans = response.get("available_plans")
            if isinstance(plans, list) and plan_id in plans:
                available.append(region)
        if not available:
            raise EnvrError(
                f"{plan_id} is unavailable in configured regions: "
                + ", ".join(REGIONS)
            )
        return available

    def cloud_init(self, public_keys: Sequence[str]) -> str:
        if not public_keys:
            raise EnvrError("at least one device SSH key is required")
        authorized_keys = "\n".join(
            f"      - {json.dumps(public_key)}" for public_key in public_keys
        )
        codex_config_command = json.dumps(
            "printf '%s\\n' 'cli_auth_credentials_store = \"file\"' "
            f"> {REMOTE_HOME}/.codex/config.toml && "
            f"chown {REMOTE_USER}:{REMOTE_USER} {REMOTE_HOME}/.codex/config.toml && "
            f"chmod 600 {REMOTE_HOME}/.codex/config.toml"
        )
        scodex_encoded = base64.b64encode(SCODEX_SCRIPT.encode()).decode()
        return f"""#cloud-config
package_update: true
package_upgrade: false
ssh_pwauth: true
disable_root: false
users:
  - default
  - name: {REMOTE_USER}
    gecos: Codex
    shell: /bin/bash
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
{authorized_keys}
packages:
  - git
  - curl
  - ca-certificates
  - build-essential
  - tmux
  - jq
  - rsync
  - unzip
  - nodejs
  - npm
  - bubblewrap
  - docker.io
  - ufw
  - fail2ban
  - unattended-upgrades
write_files:
  - path: /etc/ssh/sshd_config.d/00-envr.conf
    permissions: '0644'
    content: |
      PasswordAuthentication yes
      PermitRootLogin yes
      PermitEmptyPasswords no
  - path: /etc/fail2ban/jail.d/envr.conf
    permissions: '0644'
    content: |
      [sshd]
      enabled = true
      maxretry = 5
      findtime = 10m
      bantime = 1h
  - path: /usr/local/bin/scodex
    permissions: '0755'
    encoding: b64
    content: {scodex_encoded}
runcmd:
  - [bash, -lc, "usermod -aG docker {REMOTE_USER}"]
  - [bash, -lc, "install -d -m 700 -o {REMOTE_USER} -g {REMOTE_USER} {REMOTE_HOME}/.ssh {REMOTE_HOME}/.ssh/envr {REMOTE_HOME}/.codex {REMOTE_CONFIG_ROOT}"]
  - [bash, -lc, {codex_config_command}]
  - [bash, -lc, "install -d -m 755 -o {REMOTE_USER} -g {REMOTE_USER} {REMOTE_ROOT}"]
  - [bash, -lc, "for i in 1 2 3; do npm install -g @openai/codex@latest && break; sleep 10; done; command -v codex"]
  - [bash, -lc, "ufw default deny incoming"]
  - [bash, -lc, "ufw default allow outgoing"]
  - [bash, -lc, "ufw allow 22/tcp"]
  - [bash, -lc, "ufw --force enable"]
  - [bash, -lc, "systemctl enable --now fail2ban docker"]
  - [bash, -lc, "systemctl restart ssh"]
  - [bash, -lc, "touch /var/lib/envr-ready"]
"""

    @staticmethod
    def retryable_region_error(error: ApiError) -> bool:
        if error.status in {409, 429, 500, 502, 503, 504}:
            return True
        if error.status != 400:
            return False
        message = error.message.lower()
        return any(
            word in message
            for word in ("capacity", "available", "availability", "stock", "region")
        )

    def create_instance(
        self,
        api: VultrAPI,
        ram_gb: int,
        repository: dict[str, Any] | None,
    ) -> dict[str, Any]:
        plan_id = PLAN_IDS[ram_gb]
        catalog = self.plan_catalog(api)
        plan = catalog.get(plan_id)
        if not plan:
            raise EnvrError(f"Vultr plan {plan_id} is not present in the live catalog")
        if int(plan.get("ram", 0)) != ram_gb * 1024:
            raise EnvrError(f"Vultr plan {plan_id} no longer matches {ram_gb} GB")
        os_id = self.ubuntu_os_id(api)
        regions = self.available_regions(api, plan_id, plan)
        public_key = self.ensure_vps_key()
        vultr_key_id = self.ensure_vultr_ssh_key(api, public_key)
        account_keys = self.managed_vultr_ssh_keys(api)
        if not any(str(key.get("id")) == vultr_key_id for key in account_keys):
            account_keys.append(
                {
                    "id": vultr_key_id,
                    "ssh_key": public_key,
                    "name": DEVICE_KEY_PREFIX + "current",
                }
            )
        key_ids = [str(key["id"]) for key in account_keys]
        public_keys = [str(key["ssh_key"]).strip() for key in account_keys]
        user_data = base64.b64encode(self.cloud_init(public_keys).encode()).decode()

        last_error: Exception | None = None
        for region in regions:
            print(f"Creating {ram_gb} GB envr VPS in {region}...")
            payload = {
                "region": region,
                "plan": plan_id,
                "os_id": os_id,
                "label": LABEL,
                "hostname": REMOTE_HOSTNAME,
                "tags": [self.management_tag()],
                "sshkey_id": key_ids,
                "user_data": user_data,
                "backups": "disabled",
                "enable_ipv6": False,
                "ddos_protection": False,
                "activation_email": False,
                "user_scheme": "root",
            }
            try:
                response = api.post("instances", payload)
                instance = response.get("instance")
                if not isinstance(instance, dict) or not instance.get("id"):
                    raise EnvrError("Vultr did not return the created instance ID")
            except ApiError as error:
                wait_seconds = 20 if error.status == 0 or error.status >= 500 else 0
                discovered = self.reconcile_creation(api, wait_seconds=wait_seconds)
                if len(discovered) == 1:
                    instance = discovered[0]
                elif len(discovered) > 1:
                    raise EnvrError(
                        "ambiguous creation produced multiple envr instances; "
                        "run envr status"
                    ) from error
                elif error.status == 0:
                    raise EnvrError(
                        "instance creation outcome is unknown after a network "
                        "failure; run envr status before retrying"
                    ) from error
                elif self.retryable_region_error(error):
                    last_error = error
                    eprint(f"Creation in {region} failed: {error}")
                    continue
                else:
                    raise

            self.save_instance_state(instance, ram_gb=ram_gb, region=region)
            try:
                active = self.wait_for_instance(api, str(instance["id"]))
                self.wait_for_ssh(active)
                self.wait_for_cloud_init(active)
            except (EnvrError, subprocess.TimeoutExpired) as error:
                raise EnvrError(
                    f"VPS {instance.get('id')} was created and remains running "
                    f"and billable, but setup did not finish: {error}. "
                    f"Run envr up {ram_gb} to resume it"
                ) from error

            try:
                self.ensure_remote_runtime(active)
                self.ensure_recovery_password(active)
                self.install_cached_auth(active)
                if repository is not None:
                    self.ensure_remote_repository(active, repository)
                self.record_successful_connection(active)
            except (EnvrError, subprocess.TimeoutExpired) as error:
                raise EnvrError(
                    f"VPS {active.get('id')} is running and billable, but "
                    f"workspace setup failed: {error}"
                ) from error
            return active

        raise EnvrError(f"all configured regions failed: {last_error}")

    def reconcile_creation(
        self, api: VultrAPI, *, wait_seconds: int
    ) -> list[dict[str, Any]]:
        deadline = time.monotonic() + wait_seconds
        while True:
            instances = self.managed_instances(api)
            if instances or time.monotonic() >= deadline:
                return instances
            time.sleep(2)

    def wait_for_instance(self, api: VultrAPI, instance_id: str) -> dict[str, Any]:
        deadline = time.monotonic() + INSTANCE_TIMEOUT
        last: dict[str, Any] | None = None
        while time.monotonic() < deadline:
            response = api.get(f"instances/{instance_id}")
            instance = response.get("instance")
            if isinstance(instance, dict):
                last = instance
                ip = str(instance.get("main_ip", ""))
                if (
                    instance.get("status") == "active"
                    and instance.get("power_status") == "running"
                    and ip
                    and ip != "0.0.0.0"
                ):
                    self.save_instance_state(instance)
                    return instance
            time.sleep(5)
        status = (
            last.get("status") or last.get("server_status") or "unknown"
        ) if last else "unknown"
        raise EnvrError(f"instance did not become active (last status: {status})")

    def ssh_options(
        self,
        *,
        connect_timeout: int = SSH_CONNECT_TIMEOUT,
        strict_host_key_checking: str = "accept-new",
    ) -> list[str]:
        ensure_private_dir(self.vps_known_hosts.parent)
        self.vps_known_hosts.touch(mode=0o600, exist_ok=True)
        self.vps_known_hosts.chmod(0o600)
        return [
            "-i",
            str(self.vps_key),
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "BatchMode=yes",
            "-o",
            f"StrictHostKeyChecking={strict_host_key_checking}",
            "-o",
            f"UserKnownHostsFile={self.vps_known_hosts}",
            "-o",
            f"ConnectTimeout={connect_timeout}",
            "-o",
            "ServerAliveInterval=30",
            "-o",
            "ServerAliveCountMax=3",
        ]

    def ssh_target(self, instance: dict[str, Any]) -> str:
        ip = str(instance.get("main_ip", ""))
        if not ip or ip == "0.0.0.0":
            raise EnvrError("instance does not have a usable public IPv4 address")
        return f"{REMOTE_USER}@{ip}"

    def root_ssh_target(self, instance: dict[str, Any]) -> str:
        ip = str(instance.get("main_ip", ""))
        if not ip or ip == "0.0.0.0":
            raise EnvrError("instance does not have a usable public IPv4 address")
        return f"root@{ip}"

    def instance_password(
        self, api: VultrAPI, instance: dict[str, Any]
    ) -> str:
        password = str(instance.get("default_password") or "").strip()
        if not password and instance.get("id"):
            response = api.get(f"instances/{instance['id']}")
            current = response.get("instance")
            if isinstance(current, dict):
                password = str(current.get("default_password") or "").strip()
                instance.update(current)
        if (
            not password
            and self.state().get("instance_id") == instance.get("id")
            and self.password_path.exists()
        ):
            password = self.password_path.read_text(encoding="utf-8").strip()
        if not password:
            raise EnvrError(
                "Vultr did not return the instance password; authorize this "
                "device from an already-connected device or the Vultr console"
            )
        return password

    @staticmethod
    def valid_recovery_password(password: str) -> bool:
        return (
            16 <= len(password) <= 128
            and ":" not in password
            and not any(
                character.isspace() or ord(character) < 32
                for character in password
            )
        )

    def generate_recovery_password(self) -> str:
        alphabet = (
            "ABCDEFGHJKLMNPQRSTUVWXYZ"
            "abcdefghijkmnopqrstuvwxyz"
            "23456789"
            "@#%+=_,.-"
        )
        return "".join(secrets.choice(alphabet) for _ in range(24))

    def ensure_recovery_password(self, instance: dict[str, Any]) -> None:
        result = self.remote_command(
            instance,
            f"test -s {shlex.quote(REMOTE_RECOVERY_PASSWORD)} && "
            f"cat {shlex.quote(REMOTE_RECOVERY_PASSWORD)}",
            capture=True,
            check=False,
            quiet=True,
            timeout=30,
        )
        password = result.stdout.strip() if result.returncode == 0 else ""
        if password and not self.valid_recovery_password(password):
            raise EnvrError("the VPS recovery password cache is invalid")
        if not password:
            password = ""
            if (
                self.state().get("instance_id") == instance.get("id")
                and self.password_path.is_file()
            ):
                password = self.password_path.read_text(encoding="utf-8").strip()
            if not self.valid_recovery_password(password):
                password = self.generate_recovery_password()

        self.remote_command(
            instance,
            "sudo chpasswd",
            input_data=f"root:{password}\n",
            quiet=True,
            timeout=30,
        )
        store_command = (
            f"install -d -m 700 {shlex.quote(REMOTE_CONFIG_ROOT)} && "
            f"temporary=$(mktemp {shlex.quote(REMOTE_CONFIG_ROOT)}/"
            ".recovery-password.XXXXXX) && "
            "trap 'rm -f \"$temporary\"' EXIT && "
            "cat > \"$temporary\" && chmod 600 \"$temporary\" && "
            f"mv -f \"$temporary\" {shlex.quote(REMOTE_RECOVERY_PASSWORD)} && "
            "trap - EXIT"
        )
        self.remote_command(
            instance,
            store_command,
            input_data=password + "\n",
            quiet=True,
            timeout=30,
        )
        atomic_write_text(self.password_path, password + "\n")

    def record_successful_connection(self, instance: dict[str, Any]) -> None:
        self.save_instance_state(instance)
        for path, mode in (
            (self.vps_key, 0o600),
            (self.vps_public_key, 0o600),
            (self.vps_known_hosts, 0o600),
        ):
            if not path.is_file():
                raise EnvrError(f"successful SSH connection was not cached: {path}")
            path.chmod(mode)
            descriptor = os.open(path, os.O_RDONLY)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        fsync_directory(self.root)
        fsync_directory(self.ssh_root)

    def enroll_device_key(
        self, api: VultrAPI, instance: dict[str, Any]
    ) -> None:
        try:
            password = self.instance_password(api, instance)
        except EnvrError:
            if not sys.stdin.isatty():
                raise EnvrError(
                    "this device key is not authorized on the running VPS; "
                    "retry interactively with the root SSH password, or run "
                    "envr up once from an already-authorized device"
                ) from None
            password = getpass.getpass(
                f"Root SSH password for {instance.get('main_ip')}: "
            ).strip()
            if not password:
                raise EnvrError("root SSH password cannot be empty") from None
        public_key = self.ensure_vps_key()
        self.ensure_layout()
        secret_fd, secret_name = tempfile.mkstemp(
            prefix=".askpass-secret.", dir=self.root
        )
        os.close(secret_fd)
        secret_path = Path(secret_name)
        helper_path = self.root / f".askpass-{secrets.token_hex(6)}"
        try:
            atomic_write_text(secret_path, password + "\n")
            helper = (
                "#!/bin/sh\n"
                f"exec cat {shlex.quote(str(secret_path))}\n"
            )
            atomic_write_text(helper_path, helper, 0o700)
            environment = os.environ.copy()
            environment["DISPLAY"] = "envr"
            environment["SSH_ASKPASS"] = str(helper_path)
            environment["SSH_ASKPASS_REQUIRE"] = "force"
            quoted_key = shlex.quote(public_key)
            command = (
                "set -e; "
                f"install -d -m 700 -o {REMOTE_USER} -g {REMOTE_USER} "
                f"{REMOTE_HOME}/.ssh; "
                f"touch {REMOTE_HOME}/.ssh/authorized_keys; "
                f"chown {REMOTE_USER}:{REMOTE_USER} "
                f"{REMOTE_HOME}/.ssh/authorized_keys; "
                f"chmod 600 {REMOTE_HOME}/.ssh/authorized_keys; "
                f"key={quoted_key}; "
                f"grep -qxF \"$key\" {REMOTE_HOME}/.ssh/authorized_keys || "
                f"printf '%s\\n' \"$key\" >> {REMOTE_HOME}/.ssh/authorized_keys"
            )
            ssh = [
                "ssh",
                "-T",
                "-o",
                "StrictHostKeyChecking=accept-new",
                "-o",
                f"UserKnownHostsFile={self.vps_known_hosts}",
                "-o",
                f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
                "-o",
                "PreferredAuthentications=password,keyboard-interactive",
                "-o",
                "PubkeyAuthentication=no",
                "-o",
                "NumberOfPasswordPrompts=1",
                self.root_ssh_target(instance),
                command,
            ]
            run(ssh, env=environment, quiet=True, timeout=60)
            atomic_write_text(self.password_path, password + "\n")
        finally:
            with contextlib.suppress(FileNotFoundError):
                secret_path.unlink()
            with contextlib.suppress(FileNotFoundError):
                helper_path.unlink()
            fsync_directory(self.root)

    def ensure_device_access(
        self, api: VultrAPI, instance: dict[str, Any]
    ) -> None:
        public_key = self.ensure_vps_key()
        self.ensure_vultr_ssh_key(api, public_key)
        try:
            result = self.remote_command(
                instance, "true", check=False, quiet=True, timeout=15
            )
        except subprocess.TimeoutExpired as error:
            raise EnvrError(
                f"SSH at {instance.get('main_ip')} is unreachable from the "
                "current network; the device key remains installed. Check "
                "the network or reconnect the VPN"
            ) from error
        if result.returncode == 0:
            self.sync_managed_device_keys(api, instance)
            return
        failure = (result.stderr or "").lower()
        authentication_failed = any(
            marker in failure
            for marker in (
                "permission denied",
                "authentication failed",
                "no supported authentication methods",
                "too many authentication failures",
            )
        )
        if not authentication_failed:
            if "host identification has changed" in failure:
                raise EnvrError(
                    "the VPS SSH host key changed; refusing to connect"
                )
            raise EnvrError(
                f"SSH at {instance.get('main_ip')} is unreachable from the "
                "current network; the device key remains installed. Check "
                "the network or reconnect the VPN"
            )
        print("Authorizing this device on the running VPS...")
        self.enroll_device_key(api, instance)
        result = self.remote_command(
            instance, "true", check=False, quiet=True, timeout=15
        )
        if result.returncode != 0:
            raise EnvrError("the device SSH key was installed but login still failed")
        self.sync_managed_device_keys(api, instance)

    def sync_managed_device_keys(
        self,
        api: VultrAPI,
        instance: dict[str, Any],
        *,
        api_timeout: int = 30,
    ) -> None:
        public_keys: list[str] = []
        for key in self.managed_vultr_ssh_keys(api, timeout=api_timeout):
            public_key = str(key.get("ssh_key") or "").strip()
            if (
                not public_key
                or "\n" in public_key
                or "\r" in public_key
                or not public_key.startswith(("ssh-", "ecdsa-", "sk-"))
            ):
                raise EnvrError("Vultr returned an invalid managed SSH public key")
            public_keys.append(public_key)
        if not public_keys:
            return
        encoded_keys = base64.b64encode(
            ("\n".join(public_keys) + "\n").encode()
        ).decode()
        script = r"""set -euo pipefail
install -d -m 700 "$HOME/.ssh"
touch "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"
printf '%s' "$1" | base64 -d | while IFS= read -r key; do
    test -n "$key" || continue
    grep -qxF "$key" "$HOME/.ssh/authorized_keys" ||
        printf '%s\n' "$key" >> "$HOME/.ssh/authorized_keys"
done
"""
        self.remote_script(
            instance,
            script,
            [encoded_keys],
            quiet=True,
            timeout=30,
        )

    def try_cached_device_key_sync(self, instance: dict[str, Any]) -> None:
        if not self.token_path.is_file():
            return
        try:
            token = self.token_path.read_text(encoding="utf-8").strip()
            if not token:
                return
            self.sync_managed_device_keys(
                VultrAPI(token),
                instance,
                api_timeout=5,
            )
        except (OSError, EnvrError, subprocess.TimeoutExpired):
            return

    def remote_command(
        self,
        instance: dict[str, Any],
        command: str,
        *,
        input_data: str | None = None,
        capture: bool = False,
        check: bool = True,
        timeout: int | None = None,
        tty: bool = False,
        quiet: bool = False,
        connect_timeout: int = SSH_CONNECT_TIMEOUT,
        strict_host_key_checking: str = "accept-new",
    ) -> subprocess.CompletedProcess[str]:
        ssh = [
            "ssh",
            *self.ssh_options(
                connect_timeout=connect_timeout,
                strict_host_key_checking=strict_host_key_checking,
            ),
        ]
        if tty:
            ssh.append("-tt")
        ssh.extend([self.ssh_target(instance), command])
        return run(
            ssh,
            input_data=input_data,
            capture=capture,
            check=check,
            timeout=timeout,
            quiet=quiet,
        )

    def remote_script(
        self,
        instance: dict[str, Any],
        script: str,
        arguments: Sequence[str] = (),
        *,
        capture: bool = False,
        check: bool = True,
        timeout: int | None = None,
        quiet: bool = False,
    ) -> subprocess.CompletedProcess[str]:
        command = "bash -s --"
        if arguments:
            command += " " + " ".join(shlex.quote(argument) for argument in arguments)
        return self.remote_command(
            instance,
            command,
            input_data=script,
            capture=capture,
            check=check,
            timeout=timeout,
            quiet=quiet,
        )

    def wait_for_ssh(self, instance: dict[str, Any]) -> None:
        print(f"Waiting for SSH at {instance.get('main_ip')}...")
        deadline = time.monotonic() + INSTANCE_TIMEOUT
        while time.monotonic() < deadline:
            result = self.remote_command(
                instance, "true", check=False, quiet=True, timeout=15
            )
            if result.returncode == 0:
                return
            time.sleep(5)
        raise EnvrError("SSH did not become reachable")

    def wait_for_cloud_init(self, instance: dict[str, Any]) -> None:
        print("Waiting for cloud-init...")
        result = self.remote_command(
            instance,
            "sudo cloud-init status --wait >/dev/null 2>&1 || true; "
            "if test -f /var/lib/envr-ready && command -v codex >/dev/null; "
            "then exit 0; fi; "
            "sudo cloud-init status --long >&2; exit 1",
            check=False,
            capture=True,
            timeout=CLOUD_INIT_TIMEOUT,
        )
        if result.returncode != 0:
            detail = result.stderr.strip() if result.stderr else "cloud-init failed"
            raise EnvrError(detail)

    def scp_options(self) -> list[str]:
        return self.ssh_options()

    def copy_to_remote(
        self, instance: dict[str, Any], local: Path, remote: str
    ) -> None:
        run(
            [
                "scp",
                *self.scp_options(),
                str(local),
                f"{self.ssh_target(instance)}:{remote}",
            ],
            quiet=True,
            timeout=120,
        )

    def install_cached_auth(self, instance: dict[str, Any]) -> None:
        if not self.auth_path.exists():
            return
        self.validate_auth_file(self.auth_path)
        self.remote_command(
            instance, f"install -d -m 700 {REMOTE_HOME}/.codex", quiet=True
        )
        temporary = (
            f"{REMOTE_HOME}/.codex/.auth.json.envr-{secrets.token_hex(4)}"
        )
        self.copy_to_remote(instance, self.auth_path, temporary)
        self.remote_command(
            instance,
            f"chmod 600 {shlex.quote(temporary)} && "
            f"mv -f {shlex.quote(temporary)} {REMOTE_HOME}/.codex/auth.json",
            quiet=True,
        )

    def ensure_remote_runtime(self, instance: dict[str, Any]) -> None:
        encoded = base64.b64encode(SCODEX_SCRIPT.encode()).decode()
        script = f"""set -euo pipefail
if ! command -v bwrap >/dev/null 2>&1; then
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y bubblewrap
fi
temporary=$(mktemp)
trap 'rm -f "$temporary"' EXIT
printf '%s' "$1" | base64 -d > "$temporary"
sudo install -m 755 "$temporary" /usr/local/bin/scodex
install -d -m 700 {REMOTE_HOME}/.codex
printf '%s\n' 'cli_auth_credentials_store = "file"' \
    > {REMOTE_HOME}/.codex/config.toml
chmod 600 {REMOTE_HOME}/.codex/config.toml
"""
        self.remote_script(instance, script, (encoded,), timeout=300)

    @staticmethod
    def validate_auth_file(path: Path) -> None:
        if not path.is_file() or path.stat().st_size == 0:
            raise EnvrError(f"Codex auth file is empty: {path}")
        try:
            value = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as error:
            raise EnvrError(f"Codex auth file is invalid JSON: {path}") from error
        if not isinstance(value, dict) or not value:
            raise EnvrError(f"Codex auth file does not contain credentials: {path}")

    def pull_auth(self, instance: dict[str, Any]) -> bool:
        result = self.remote_command(
            instance,
            f"test -s {REMOTE_HOME}/.codex/auth.json && "
            f"sha256sum {REMOTE_HOME}/.codex/auth.json",
            capture=True,
            check=False,
            timeout=30,
        )
        if result.returncode != 0 or not result.stdout.strip():
            return False
        remote_hash = result.stdout.split()[0]
        if self.auth_path.exists():
            local_hash = hashlib.sha256(self.auth_path.read_bytes()).hexdigest()
            if local_hash == remote_hash:
                return True

        ensure_private_dir(self.auth_path.parent)
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=".auth.json.", dir=self.auth_path.parent
        )
        os.close(descriptor)
        temporary = Path(temporary_name)
        try:
            run(
                [
                    "scp",
                    *self.scp_options(),
                    f"{self.ssh_target(instance)}:{REMOTE_HOME}/.codex/auth.json",
                    str(temporary),
                ],
                quiet=True,
                timeout=120,
            )
            temporary.chmod(0o600)
            self.validate_auth_file(temporary)
            downloaded_hash = hashlib.sha256(temporary.read_bytes()).hexdigest()
            if downloaded_hash != remote_hash:
                raise EnvrError("Codex auth changed during download; retry")
            os.replace(temporary, self.auth_path)
            self.auth_path.chmod(0o600)
            fsync_directory(self.auth_path.parent)
            return True
        finally:
            with contextlib.suppress(FileNotFoundError):
                temporary.unlink()

    @staticmethod
    def portable_repository(repository: dict[str, Any]) -> dict[str, str]:
        return {
            key: str(repository[key])
            for key in (
                "url",
                "folder",
                "identity",
                "host",
                "author_name",
                "author_email",
            )
        }

    def update_remote_manifest(
        self, instance: dict[str, Any], repository: dict[str, Any]
    ) -> None:
        record = self.portable_repository(repository)
        encoded = base64.b64encode(
            json.dumps(record, separators=(",", ":")).encode()
        ).decode()
        script = f"""set -euo pipefail
install -d -m 700 {shlex.quote(REMOTE_CONFIG_ROOT)}
python3 - "$1" {shlex.quote(REMOTE_REPOS)} <<'PY'
import base64
import json
import os
import sys
import tempfile

record = json.loads(base64.b64decode(sys.argv[1]).decode())
path = sys.argv[2]
value = {{"schema": {SCHEMA_VERSION}, "repositories": {{}}}}
try:
    with open(path, encoding="utf-8") as source:
        existing = json.load(source)
    if (
        isinstance(existing, dict)
        and existing.get("schema") == {SCHEMA_VERSION}
        and isinstance(existing.get("repositories"), dict)
    ):
        value = existing
except FileNotFoundError:
    pass
value["repositories"][record["folder"]] = record
descriptor, temporary = tempfile.mkstemp(prefix=".repos.", dir=os.path.dirname(path))
try:
    os.fchmod(descriptor, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as output:
        json.dump(value, output, indent=2, sort_keys=True)
        output.write("\\n")
        output.flush()
        os.fsync(output.fileno())
    os.replace(temporary, path)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
"""
        self.remote_script(instance, script, (encoded,), timeout=60)

    def sync_from_server(self, instance: dict[str, Any]) -> bool:
        auth_synchronized = self.pull_auth(instance)
        available = self.remote_command(
            instance,
            f"test -s {shlex.quote(REMOTE_REPOS)}",
            check=False,
            quiet=True,
            timeout=30,
        )
        if available.returncode != 0:
            return auth_synchronized

        self.ensure_layout()
        descriptor, manifest_name = tempfile.mkstemp(
            prefix=".server-repos.", dir=self.root
        )
        os.close(descriptor)
        manifest_path = Path(manifest_name)
        try:
            run(
                [
                    "scp",
                    *self.scp_options(),
                    f"{self.ssh_target(instance)}:{REMOTE_REPOS}",
                    str(manifest_path),
                ],
                quiet=True,
                timeout=120,
            )
            manifest_path.chmod(0o600)
            remote_manifest = load_json(manifest_path)
        finally:
            with contextlib.suppress(FileNotFoundError):
                manifest_path.unlink()

        remote_records = remote_manifest.get("repositories")
        if not isinstance(remote_records, dict):
            raise EnvrError("server repository manifest is invalid")
        local_manifest = self.repositories()
        local_records = local_manifest["repositories"]
        for folder, record in remote_records.items():
            if not isinstance(folder, str) or not isinstance(record, dict):
                raise EnvrError("server repository manifest contains an invalid entry")
            parsed = parse_repository_url(str(record.get("url", "")))
            if folder != parsed["folder"] or record.get("folder") != folder:
                raise EnvrError("server repository manifest has a folder mismatch")
            if (
                record.get("identity") != parsed["identity"]
                or record.get("host") != parsed["host"]
            ):
                raise EnvrError("server repository manifest has an identity mismatch")
            for field in ("identity", "host", "author_name", "author_email"):
                validate_text_field(field, str(record.get(field, "")))

            key_directory = self.git_root / folder
            ensure_private_dir(key_directory)
            private_key = key_directory / "id_ed25519"
            public_key = key_directory / "id_ed25519.pub"
            descriptor, candidate_name = tempfile.mkstemp(
                prefix=".id_ed25519.", dir=key_directory
            )
            os.close(descriptor)
            candidate = Path(candidate_name)
            try:
                run(
                    [
                        "scp",
                        *self.scp_options(),
                        f"{self.ssh_target(instance)}:"
                        f"{REMOTE_HOME}/.ssh/envr/{folder}",
                        str(candidate),
                    ],
                    quiet=True,
                    timeout=120,
                )
                candidate.chmod(0o600)
                derived = run(
                    ["ssh-keygen", "-y", "-P", "", "-f", str(candidate)],
                    capture=True,
                    quiet=True,
                ).stdout.strip()
                if not derived:
                    raise EnvrError(f"server repository key is invalid: {folder}")
                atomic_write(private_key, candidate.read_bytes())
                atomic_write_text(public_key, derived + "\n")
            finally:
                with contextlib.suppress(FileNotFoundError):
                    candidate.unlink()

            local_records[folder] = {
                **self.portable_repository(record),
                "private_key": str(private_key),
                "public_key": str(public_key),
            }
        self.save_repositories(local_manifest)

        return auth_synchronized

    def ensure_remote_repository(
        self, instance: dict[str, Any], repository: dict[str, Any]
    ) -> None:
        folder = str(repository["folder"])
        remote_key = f"{REMOTE_HOME}/.ssh/envr/{folder}"
        self.remote_command(
            instance,
            f"install -d -m 700 {REMOTE_HOME}/.ssh {REMOTE_HOME}/.ssh/envr",
            quiet=True,
        )
        temporary_key = remote_key + f".tmp-{secrets.token_hex(4)}"
        self.copy_to_remote(instance, Path(repository["private_key"]), temporary_key)
        self.remote_command(
            instance,
            f"chmod 600 {shlex.quote(temporary_key)} && "
            f"mv -f {shlex.quote(temporary_key)} {shlex.quote(remote_key)}",
            quiet=True,
        )

        remote_known_hosts = f"{REMOTE_HOME}/.ssh/envr/known_hosts"
        self.remote_command(
            instance,
            f"touch {shlex.quote(remote_known_hosts)} && "
            f"chmod 600 {shlex.quote(remote_known_hosts)}",
            quiet=True,
        )

        script = r"""set -euo pipefail
url=$1
folder=$2
key=$3
known_hosts=$4
author_name=$5
author_email=$6
root=/home/remote/envr
target="$root/$folder"
ssh_command="ssh -i $key -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -o UserKnownHostsFile=$known_hosts"
if [ ! -e "$target" ]; then
    temporary="$root/.${folder}.clone.$$"
    trap 'rm -rf -- "$temporary"' EXIT
    GIT_SSH_COMMAND="$ssh_command" git clone --quiet -- "$url" "$temporary"
    mv -- "$temporary" "$target"
    trap - EXIT
elif ! git -C "$target" rev-parse --git-dir >/dev/null 2>&1; then
    echo "existing path is not a Git repository: $target" >&2
    exit 20
fi
origin=$(git -C "$target" remote get-url origin)
if [ "$origin" != "$url" ]; then
    echo "origin mismatch in $target: $origin" >&2
    exit 21
fi
GIT_SSH_COMMAND="$ssh_command" git ls-remote "$url" >/dev/null
git -C "$target" config --local user.name "$author_name"
git -C "$target" config --local user.email "$author_email"
git -C "$target" config --local core.sshCommand "$ssh_command"
"""
        self.remote_script(
            instance,
            script,
            (
                str(repository["url"]),
                folder,
                remote_key,
                remote_known_hosts,
                str(repository["author_name"]),
                str(repository["author_email"]),
            ),
            timeout=300,
        )
        self.update_remote_manifest(instance, repository)
        print(f"Repository ready: {folder}")

    def connect_shell(
        self,
        instance: dict[str, Any],
        repository: dict[str, Any] | None,
    ) -> None:
        if repository is None:
            display_name = "workspace"
            target = REMOTE_ROOT
        else:
            display_name = str(repository["folder"])
            target = f"{REMOTE_ROOT}/{display_name}"
        command = (
            f"cd {shlex.quote(target)} && "
            'exec "${SHELL:-/bin/bash}" -l'
        )
        print(f"Connecting to {display_name}. Exit the shell to disconnect.")
        try:
            self.remote_command(instance, command, tty=True, check=False)
        finally:
            try:
                self.sync_from_server(instance)
            except EnvrError as error:
                eprint(f"Warning: could not refresh the local envr cache: {error}")

    def prepare_existing_instance(
        self,
        instance: dict[str, Any],
        folder: str | None,
    ) -> tuple[dict[str, Any], dict[str, Any] | None]:
        self.wait_for_cloud_init(instance)
        self.ensure_remote_runtime(instance)
        self.ensure_recovery_password(instance)
        synchronized = self.sync_from_server(instance)
        if not synchronized:
            self.install_cached_auth(instance)
        repository = self.repository(folder) if folder is not None else None
        if repository is not None:
            self.ensure_remote_repository(instance, repository)
        self.record_successful_connection(instance)
        return instance, repository

    def up(
        self, ram_gb: int, folder: str | None
    ) -> tuple[dict[str, Any], dict[str, Any] | None]:
        if ram_gb not in PLAN_IDS:
            raise EnvrError("RAM must be one of: 1, 2, 4, 8")
        ensure_commands(("ssh", "scp", "ssh-keygen"))

        cached = self.cached_instance(ram_gb)
        if cached is not None:
            try:
                reachable = self.remote_command(
                    cached,
                    "true",
                    check=False,
                    quiet=True,
                    timeout=7,
                    connect_timeout=5,
                    strict_host_key_checking="yes",
                )
            except subprocess.TimeoutExpired:
                reachable = None
            if reachable is not None and reachable.returncode == 0:
                print(f"Using cached VPS at {cached['main_ip']}...")
                prepared = self.prepare_existing_instance(cached, folder)
                self.try_cached_device_key_sync(cached)
                return prepared

        api = self.api()
        api.get("account")
        instances = self.managed_instances(api)
        if len(instances) > 1:
            raise EnvrError(
                f"conflict: {len(instances)} envr instances exist; "
                "run envr status, then envr destroy"
            )
        if instances:
            instance = instances[0]
            current_ram = int(instance.get("ram", 0)) // 1024
            if current_ram != ram_gb:
                raise EnvrError(
                    f"existing envr VPS has {current_ram} GB; requested {ram_gb} GB. "
                    "Run envr destroy before changing size."
                )
            self.save_instance_state(instance, ram_gb=current_ram)
            if instance.get("power_status") == "stopped":
                api.request("POST", f"instances/{instance.get('id')}/start")
            instance = self.wait_for_instance(api, str(instance.get("id")))
            self.ensure_device_access(api, instance)
            return self.prepare_existing_instance(instance, folder)
        else:
            repository = self.repository(folder) if folder is not None else None
            instance = self.create_instance(api, ram_gb, repository)
        return instance, repository

    def status(self) -> int:
        api = self.api()
        account_response = api.get("account")
        account = account_response.get("account")
        if not isinstance(account, dict):
            raise EnvrError("Vultr API returned invalid account information")
        instances = self.managed_instances(api)
        if len(instances) == 1:
            self.save_instance_state(instances[0])
        plans = self.plan_catalog(api)

        balance = float(account.get("balance", 0))
        pending = float(account.get("pending_charges", 0))
        credit = available_prepaid_credit(balance, pending)
        if balance < 0:
            balance_text = f"${-balance:.2f} credit"
        elif balance > 0:
            balance_text = f"${balance:.2f} due"
        else:
            balance_text = "$0.00"
        print("Vultr")
        print(f"  Balance:          {balance_text}")
        print(f"  Pending charges:  ${pending:.2f}")
        print(f"  Available credit: ${credit:.2f}")

        if len(instances) == 1:
            plan = plans.get(str(instances[0].get("plan")), {})
            hourly = float(plan.get("hourly_cost", 0) or 0)
            if hourly > 0 and credit > 0:
                days = credit / (hourly * 24)
                print(
                    f"  Credit runway:    about {days:.1f} days at ${hourly:.3f}/hour"
                )
            else:
                print("  Credit runway:    n/a")
        else:
            print("  Credit runway:    n/a")

        if not instances:
            print("\nenvr-codex: not running")
            return 0

        conflict = len(instances) > 1
        if conflict:
            print(f"\nCONFLICT: {len(instances)} envr-managed instances are running")
        for instance in instances:
            plan = plans.get(str(instance.get("plan")), {})
            try:
                password = self.instance_password(api, instance)
            except EnvrError:
                password = "unavailable from API"
            print(f"\n{LABEL}")
            print(f"  ID:         {instance.get('id', '')}")
            print(f"  Region:     {instance.get('region', '')}")
            print(f"  RAM:        {int(instance.get('ram', 0)) // 1024} GB")
            print(f"  CPU:        {instance.get('vcpu_count', '')}")
            print(f"  IP:         {instance.get('main_ip', '')}")
            print(f"  SSH user:   {REMOTE_USER} (key)")
            print("  Root user:  root")
            print(f"  Password:   {password}")
            print(f"  Status:     {instance.get('status', '')}")
            print(f"  Power:      {instance.get('power_status', '')}")
            hourly = plan.get("hourly_cost")
            monthly = plan.get("monthly_cost")
            if hourly is not None and monthly is not None:
                print(f"  Price:      ${float(hourly):.3f}/hour · ${monthly}/month")
            else:
                print("  Price:      unavailable")
        return 2 if conflict else 0

    def port_open(self, port: int) -> None:
        if not 1 <= port <= 65535:
            raise EnvrError("port must be an integer from 1 through 65535")
        ensure_commands(("ssh", "ssh-keygen"))
        api = self.api()
        instance = self.resolve_single_instance(api)
        if instance is None:
            raise EnvrError(
                "envr-codex is not running. Start it with "
                "envr up RAM."
            )
        self.ensure_device_access(api, instance)
        script = r"""set -euo pipefail
port=$1
sudo ufw allow "$port/tcp"
sudo ufw allow "$port/udp"
sudo ufw status | grep -Eq "^${port}/tcp[[:space:]]+ALLOW"
sudo ufw status | grep -Eq "^${port}/udp[[:space:]]+ALLOW"
"""
        self.remote_script(instance, script, (str(port),), timeout=60)
        print(f"Opened port {port} (TCP and UDP) on envr-codex.")

    def git_safety(self, instance: dict[str, Any]) -> list[tuple[str, str]]:
        script = r"""set -u
root=/home/remote/envr
found=0
for directory in "$root"/*; do
    [ -d "$directory" ] || continue
    if ! git -C "$directory" rev-parse --git-dir >/dev/null 2>&1; then
        continue
    fi
    found=1
    folder=${directory##*/}
    if [ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]; then
        printf '%s\t%s\n' "$folder" "UNCOMMITTED"
        continue
    fi
    if ! git -C "$directory" symbolic-ref -q HEAD >/dev/null 2>&1; then
        printf '%s\t%s\n' "$folder" "DETACHED HEAD"
        continue
    fi
    branches=$(git -C "$directory" for-each-ref \
        --format='%(refname:short)|%(upstream:short)' refs/heads) || {
            printf '%s\t%s\n' "$folder" "CHECK FAILED"
            continue
        }
    missing_upstream=""
    total_ahead=0
    check_failed=0
    while IFS='|' read -r branch upstream; do
        [ -n "$branch" ] || continue
        if [ -z "$upstream" ]; then
            missing_upstream=$branch
            break
        fi
        ahead=$(git -C "$directory" rev-list --count "$upstream..$branch" 2>/dev/null) || {
            check_failed=1
            break
        }
        total_ahead=$((total_ahead + ahead))
    done <<EOF
$branches
EOF
    if [ -n "$missing_upstream" ]; then
        printf '%s\t%s\n' "$folder" "NO UPSTREAM ($missing_upstream)"
    elif [ "$check_failed" -ne 0 ]; then
        printf '%s\t%s\n' "$folder" "CHECK FAILED"
    elif [ "$total_ahead" -gt 0 ]; then
        printf '%s\t%s\n' "$folder" "$total_ahead UNPUSHED COMMITS"
    else
        printf '%s\t%s\n' "$folder" "clean and pushed"
    fi
done
if [ "$found" -eq 0 ]; then
    printf '%s\t%s\n' "(none)" "no repositories"
fi
"""
        result = self.remote_script(
            instance, script, capture=True, timeout=60, check=False
        )
        if result.returncode != 0:
            return [("(check)", "CHECK FAILED")]
        rows = []
        for line in result.stdout.splitlines():
            if "\t" in line:
                folder, status = line.split("\t", 1)
                rows.append((folder, status))
        return rows or [("(check)", "CHECK FAILED")]

    def delete_instance(self, api: VultrAPI, instance: dict[str, Any]) -> None:
        instance_id = str(instance.get("id", ""))
        if not instance_id:
            raise EnvrError("cannot delete instance without an ID")
        api.delete(f"instances/{instance_id}")
        deadline = time.monotonic() + DELETE_TIMEOUT
        while time.monotonic() < deadline:
            instances = self.managed_instances(api)
            if not any(item.get("id") == instance_id for item in instances):
                self.remove_known_host(str(instance.get("main_ip", "")))
                return
            time.sleep(3)
        raise EnvrError(f"Vultr did not confirm deletion of {instance_id}")

    def remove_known_host(self, ip: str) -> None:
        if not ip or not self.vps_known_hosts.exists():
            return
        ensure_commands(("ssh-keygen",))
        run(
            ["ssh-keygen", "-q", "-R", ip, "-f", str(self.vps_known_hosts)],
            check=False,
            quiet=True,
        )

    def destroy(self) -> None:
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        api = self.api()
        instances = self.managed_instances(api)
        if not instances:
            print("envr-codex: not running")
            self.clear_instance_state()
            return

        state_id = self.state().get("instance_id")
        instances.sort(key=lambda item: item.get("id") == state_id)
        auth_ok = True
        summaries: list[tuple[dict[str, Any], list[tuple[str, str]]]] = []
        for instance in instances:
            try:
                self.ensure_device_access(api, instance)
                if not self.sync_from_server(instance):
                    auth_ok = False
                safety = self.git_safety(instance)
            except (EnvrError, subprocess.TimeoutExpired):
                auth_ok = False
                safety = [("(connection)", "CHECK FAILED")]
            summaries.append((instance, safety))

        print("\nRepository safety:")
        unsafe = False
        for instance, rows in summaries:
            if len(instances) > 1:
                print(
                    f"  Instance {instance.get('id')} ({instance.get('main_ip')}):"
                )
                indent = "    "
            else:
                indent = "  "
            width = max((len(folder) for folder, _ in rows), default=1)
            for folder, status in rows:
                print(f"{indent}{folder:<{width}}  {status}")
                if status not in {"clean and pushed", "no repositories"}:
                    unsafe = True

        if not auth_ok:
            print("\nWarning: the newest Codex authentication could not be preserved.")
        if unsafe:
            print("\nSome work may be permanently lost.")
        else:
            print("\nAll repositories are committed and pushed.")
        if len(instances) > 1:
            print(
                f"Warning: {len(instances)} conflicting envr instances will be destroyed."
            )
        confirmation = "Destroy envr VPS permanently?"
        if not auth_ok or unsafe:
            confirmation = "Destroy permanently despite the warnings above?"
        if not prompt_yes_no(confirmation):
            print("Cancelled.")
            return

        failures = []
        for instance in instances:
            try:
                self.delete_instance(api, instance)
                print(f"Deleted {instance.get('id')}.")
            except EnvrError as error:
                failures.append(str(error))
        if failures:
            raise EnvrError("; ".join(failures))
        self.clear_instance_state()
        print("envr-codex destroyed; compute billing has stopped.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="envr", description="Disposable Vultr Codex environment"
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("git", help="configure one Git repository")

    up = subparsers.add_parser("up", help="create or reconnect to the VPS")
    up.add_argument("ram", type=int, choices=sorted(PLAN_IDS))
    up.add_argument("repository_folder", nargs="?")

    subparsers.add_parser("status", help="show account and VPS status")

    port_open = subparsers.add_parser("port-open", help="open one TCP/UDP port")
    port_open.add_argument("port", type=int)

    subparsers.add_parser("destroy", help="check work and destroy the VPS")
    return parser


def main(arguments: Sequence[str] | None = None) -> int:
    if sys.version_info < (3, 10):
        eprint("envr requires Python 3.10 or newer")
        return 1
    parser = build_parser()
    namespace = parser.parse_args(arguments)
    app = Envr()
    try:
        attachment: tuple[dict[str, Any], dict[str, Any] | None] | None = None
        with exclusive_lock(app.root):
            if namespace.command == "git":
                app.configure_git()
                return 0
            if namespace.command == "up":
                attachment = app.up(namespace.ram, namespace.repository_folder)
            elif namespace.command == "status":
                return app.status()
            elif namespace.command == "port-open":
                app.port_open(namespace.port)
                return 0
            elif namespace.command == "destroy":
                app.destroy()
                return 0
        if attachment is not None:
            app.connect_shell(*attachment)
            return 0
    except KeyboardInterrupt:
        eprint("\nenvr: interrupted")
        return 130
    except (EnvrError, subprocess.TimeoutExpired) as error:
        eprint(f"envr: error: {error}")
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
