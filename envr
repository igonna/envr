def compact_price(plan: dict[str, Any]) -> str:
    hourly = plan.get("hourly_cost")
    if hourly in (None, ""):
        return "price unavailable"
    currency = str(plan.get("currency") or "USD")
    prefix = "$" if currency == "USD" else f"{currency} "
    text = f"{prefix}{float(hourly):.3f}/hour"
    monthly = plan.get("monthly_cost")
    if monthly not in (None, ""):
        text += f" · {prefix}{float(monthly):g}/month"
    return text


REPO_URL_RE = re.compile(
    r"^(?P<user>[^@\s/:]+)@(?P<host>[^:\s/]+):(?P<repo_path>[^\s]+)$"
)
FOLDER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def parse_repository_url(url: str) -> dict[str, str]:
    match = REPO_URL_RE.fullmatch(url.strip())
    if not match:
        raise EnvrError("repository URL must look like git@HOST:OWNER/REPOSITORY.git")
    repository_path = match.group("repo_path").strip("/")
    if repository_path.endswith(".git"):
        repository_path = repository_path[:-4]
    pieces = repository_path.split("/")
    if len(pieces) < 2 or any(piece in {"", ".", ".."} for piece in pieces):
        raise EnvrError("repository URL must contain an owner and repository")
    folder = pieces[-1]
    if not FOLDER_RE.fullmatch(folder):
        raise EnvrError(f"repository folder {folder!r} is not safe")
    identity = "-".join(pieces[-2:])
    return {
        "url": url.strip(),
        "user": match.group("user"),
        "host": match.group("host"),
        "path": repository_path,
        "folder": folder,
        "identity": identity,
    }


def validate_text_field(label: str, value: str) -> str:
    value = value.strip()
    if not value:
        raise EnvrError(f"{label} cannot be empty")
    if any(ord(character) < 32 for character in value):
        raise EnvrError(f"{label} contains control characters")
    return value


def ssh_failure_detail(stderr: str) -> str:
    lines = [
        "".join(
            character if character.isprintable() else " "
            for character in line
        ).strip()
        for line in stderr.splitlines()
        if line.strip()
    ]
    if not lines:
        return ""
    return f" ({lines[-1][:300]})"


class RelayConfig(NamedTuple):
    host: str
    port: int
    user: str

    @classmethod
    def from_dict(cls, value: dict[str, Any]) -> RelayConfig:
        host = str(value.get("host") or "").strip()
        user = str(value.get("user") or "").strip()
        try:
            port = int(value.get("port"))
        except (TypeError, ValueError) as error:
            raise EnvrError("relay configuration has an invalid SSH port") from error
        try:
            address = ipaddress.ip_address(host)
        except ValueError as error:
            raise EnvrError("relay IP address is invalid") from error
        if address.version != 4:
            raise EnvrError("envr currently requires an IPv4 relay address")
        if not 1 <= port <= 65535:
            raise EnvrError("relay SSH port must be between 1 and 65535")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*", user):
            raise EnvrError("relay SSH user is invalid")
        return cls(host=str(address), port=port, user=user)

    def as_dict(self) -> dict[str, Any]:
        return {
            "schema": SCHEMA_VERSION,
            "host": self.host,
            "port": self.port,
            "user": self.user,
        }

    @property
    def target(self) -> str:
        return f"{self.user}@{self.host}"


class UnixSocketHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS whose TCP stream is supplied by an SSH Unix-socket forward."""

    def __init__(self, host: str, socket_path: Path, **kwargs: Any):
        self.socket_path = socket_path
        super().__init__(host, **kwargs)

    def connect(self) -> None:
        raw_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        raw_socket.settimeout(self.timeout)
        try:
            raw_socket.connect(str(self.socket_path))
            self.sock = self._context.wrap_socket(
                raw_socket,
                server_hostname=self.host,
            )
        except BaseException:
            raw_socket.close()
            raise


class UnixSocketHTTPSHandler(urllib.request.HTTPSHandler):
    def __init__(self, socket_path: Path):
        super().__init__(context=ssl.create_default_context())
        self.socket_path = socket_path

    def https_open(self, request: urllib.request.Request) -> Any:
        def connection(host: str, **kwargs: Any) -> UnixSocketHTTPSConnection:
            return UnixSocketHTTPSConnection(host, self.socket_path, **kwargs)

        return self.do_open(
            connection,
            request,
            context=self._context,
        )


class RelayAPITunnel:
    """One temporary, end-to-end TLS transport through the SSH relay."""

    def __init__(
        self,
        ssh_options: Sequence[str],
        target: str,
        api_ipv4: str,
        api_host: str,
    ):
        self.ssh_options = list(ssh_options)
        self.target = target
        self.api_ipv4 = api_ipv4
        self.api_host = api_host
        self.process: subprocess.Popen[str] | None = None
        self.temporary_directory: Path | None = None
        self.socket_path: Path | None = None

    def start(self) -> urllib.request.OpenerDirector:
        if self.process is not None or self.socket_path is not None:
            raise EnvrError("relay API tunnel is already running")
        self.temporary_directory = Path(tempfile.mkdtemp(prefix="envr-api-"))
        self.temporary_directory.chmod(0o700)
        self.socket_path = self.temporary_directory / "api.sock"
        command = [
            "ssh",
            *self.ssh_options,
            "-N",
            "-o",
            "ExitOnForwardFailure=yes",
            "-L",
            f"{self.socket_path}:{self.api_ipv4}:443",
            self.target,
        ]
        self.process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            if self.socket_path.exists():
                return urllib.request.build_opener(
                    urllib.request.ProxyHandler({}),
                    UnixSocketHTTPSHandler(self.socket_path),
                )
            return_code = self.process.poll()
            if return_code is not None:
                detail = (
                    self.process.stderr.read() if self.process.stderr else ""
                ).strip()
                suffix = ssh_failure_detail(detail)
                self.close()
                raise EnvrError(f"could not establish the relay API tunnel{suffix}")
            time.sleep(0.05)
        self.close()
        raise EnvrError("timed out establishing the relay API tunnel")

    def verify_tls(self) -> None:
        if self.socket_path is None:
            raise EnvrError("relay API tunnel is not running")
        raw_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        raw_socket.settimeout(10)
        try:
            raw_socket.connect(str(self.socket_path))
            context = ssl.create_default_context()
            with context.wrap_socket(
                raw_socket,
                server_hostname=self.api_host,
            ):
                pass
        except (OSError, ssl.SSLError) as error:
            raw_socket.close()
            raise EnvrError(
                f"relay cannot securely reach {self.api_host}: {error}"
            ) from error

    def close(self) -> None:
        if self.process is not None:
            if self.process.poll() is None:
                self.process.terminate()
                try:
                    self.process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    self.process.kill()
                    self.process.wait(timeout=3)
            if self.process.stderr is not None:
                self.process.stderr.close()
            self.process = None
        if self.socket_path is not None:
            with contextlib.suppress(FileNotFoundError):
                self.socket_path.unlink()
            self.socket_path = None
        if self.temporary_directory is not None:
            with contextlib.suppress(FileNotFoundError):
                self.temporary_directory.rmdir()
            self.temporary_directory = None


class VultrAPI:
    provider_name = "vultr"
    display_name = "Vultr"
    api_host = "api.vultr.com"
    plan_ids = PROVIDER_PLAN_IDS["vultr"]
    regions = PROVIDER_REGIONS["vultr"]

    def __init__(
        self,
        token: str,
        base_url: str | None = None,
        opener: urllib.request.OpenerDirector | None = None,
    ):
        self.token = token
        self.base_url = (base_url or os.environ.get("ENVR_VULTR_API") or API_BASE).rstrip(
            "/"
        )
        self.opener = opener

    def request(
        self,
        method: str,
        resource: str,
        *,
        payload: dict[str, Any] | None = None,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        url = self.base_url + "/" + resource.lstrip("/")
        if query:
            url += "?" + urllib.parse.urlencode(query)
        body = None
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json",
            "User-Agent": f"envr/{VERSION}",
        }
        if payload is not None:
            body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(url, data=body, headers=headers, method=method)
        try:
            open_request = (
                self.opener.open if self.opener is not None else urllib.request.urlopen
            )
            with open_request(request, timeout=timeout) as response:
                content = response.read()
        except urllib.error.HTTPError as error:
            try:
                content = error.read()
            finally:
                error.close()
            message = self._error_message(content, error.reason)
            retry_after = None
            with contextlib.suppress(TypeError, ValueError):
                retry_after = int(error.headers.get("Retry-After", ""))
            operation = f"{method} /v2/{resource.lstrip('/')}"
            raise ApiError(
                error.code,
                message,
                retry_after=retry_after,
                operation=operation,
                provider=self.display_name,
            ) from error
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            raise ApiError(
                0,
                f"{self.display_name} API network error: {error}",
                provider=self.display_name,
            ) from error

        if not content:
            return {}
        try:
            value = json.loads(content.decode("utf-8"))
        except (UnicodeError, json.JSONDecodeError) as error:
            raise EnvrError(f"{self.display_name} API returned malformed JSON") from error
        if not isinstance(value, dict):
            raise EnvrError(f"{self.display_name} API returned an unexpected response")
        return value

    @staticmethod
    def _error_message(content: bytes, fallback: object) -> str:
        try:
            value = json.loads(content.decode("utf-8"))
            if isinstance(value, dict):
                for key in ("error", "message"):
                    candidate = value.get(key)
                    if isinstance(candidate, str) and candidate:
                        return candidate
                    if isinstance(candidate, dict):
                        for nested in ("error_message", "message", "reason"):
                            if candidate.get(nested):
                                return str(candidate[nested])
                errors = value.get("errors")
                if isinstance(errors, list) and errors:
                    first = errors[0]
                    if isinstance(first, dict):
                        for nested in ("reason", "message", "error"):
                            if first.get(nested):
                                return str(first[nested])
        except (UnicodeError, json.JSONDecodeError):
            pass
        decoded = content.decode("utf-8", errors="replace").strip()
        return decoded or str(fallback)

    def get(
        self,
        resource: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        return self.request("GET", resource, query=query, timeout=timeout)

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        return self.request("POST", resource, payload=payload)

    def patch(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        return self.request("PATCH", resource, payload=payload)

    def delete(self, resource: str) -> None:
        self.request("DELETE", resource)


class JSONAPI:
    """Small provider-neutral JSON transport with precise errors."""

    def __init__(
        self,
        token: str,
        base_url: str,
        display_name: str,
        *,
        opener: urllib.request.OpenerDirector | None = None,
        auth_scheme: str = "Bearer",
    ):
        self.token = token
        self.base_url = base_url.rstrip("/")
        self.display_name = display_name
        self.opener = opener
        self.auth_scheme = auth_scheme

    def request(
        self,
        method: str,
        resource: str,
        *,
        payload: dict[str, Any] | None = None,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        url = self.base_url + "/" + resource.lstrip("/")
        if query:
            url += "?" + urllib.parse.urlencode(query)
        body = None
        headers = {
            "Authorization": f"{self.auth_scheme} {self.token}",
            "Accept": "application/json",
            "User-Agent": f"envr/{VERSION}",
        }
        if payload is not None:
            body = json.dumps(payload, separators=(",", ":")).encode()
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(url, data=body, headers=headers, method=method)
        try:
            open_request = self.opener.open if self.opener else urllib.request.urlopen
            with open_request(request, timeout=timeout) as response:
                content = response.read()
        except urllib.error.HTTPError as error:
            try:
                content = error.read()
            finally:
                error.close()
            message = VultrAPI._error_message(content, error.reason)
            retry_after = None
            with contextlib.suppress(TypeError, ValueError):
                retry_after = int(error.headers.get("Retry-After", ""))
            path = urllib.parse.urlsplit(url).path
            raise ApiError(
                error.code,
                message,
                retry_after=retry_after,
                operation=f"{method} {path}",
                provider=self.display_name,
            ) from error
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            raise ApiError(
                0,
                f"{self.display_name} API network error: {error}",
                provider=self.display_name,
            ) from error
        if not content:
            return {}
        try:
            value = json.loads(content.decode())
        except (UnicodeError, json.JSONDecodeError) as error:
            raise EnvrError(
                f"{self.display_name} API returned malformed JSON"
            ) from error
        if not isinstance(value, dict):
            raise EnvrError(f"{self.display_name} API returned an unexpected response")
        return value


class ExoscaleAPI:
    """Exoscale v2 adapter exposing envr's normalized cloud contract."""

    provider_name = "exoscale"
    display_name = "Exoscale"
    api_host = "api-de-fra-1.exoscale.com"
    plan_ids = PROVIDER_PLAN_IDS["exoscale"]
    regions = PROVIDER_REGIONS["exoscale"]
    security_group_name = "envr-managed"

    @staticmethod
    def memory_mib(value: Any) -> int:
        """Normalize Exoscale's byte-sized memory field to envr's MiB contract."""
        memory = int(value or 0)
        return memory // (1024 * 1024) if memory >= 1024 * 1024 else memory

    def __init__(
        self,
        credentials: str,
        base_url: str | None = None,
        opener: urllib.request.OpenerDirector | None = None,
        opener_factory: Callable[[str], urllib.request.OpenerDirector] | None = None,
    ):
        values = credentials.splitlines()
        if len(values) != 2 or not all(value.strip() for value in values):
            raise EnvrError("Exoscale credentials must contain an API key and secret")
        self.api_key, self.api_secret = (value.strip() for value in values)
        self.base_url = base_url.rstrip("/") if base_url else None
        self.opener = opener
        self.opener_factory = opener_factory
        self._plans: dict[str, dict[str, Any]] = {}
        self._instance_types: dict[str, dict[str, Any]] = {}
        self._template_zones: set[str] = set()
        self._instance_zones: dict[str, str] = {}
        self._key_material: dict[str, str] = {}
        self._security_group_ids: dict[str, str] = {}

    @staticmethod
    def api_host_for_zone(zone: str) -> str:
        return f"api-{zone}.exoscale.com"

    @staticmethod
    def authorization(
        api_key: str,
        api_secret: str,
        method: str,
        path: str,
        body: bytes,
        query: dict[str, str | int] | None,
        expires: int,
    ) -> str:
        signed = sorted(str(name) for name in (query or {}))
        values = "".join(str((query or {})[name]) for name in signed)
        message = "\n".join(
            (f"{method} {path}", body.decode("utf-8"), values, "", str(expires))
        )
        signature = base64.b64encode(
            hmac.new(api_secret.encode(), message.encode(), hashlib.sha256).digest()
        ).decode()
        parts = [f"EXO2-HMAC-SHA256 credential={api_key}"]
        if signed:
            parts.append("signed-query-args=" + ";".join(signed))
        parts.extend((f"expires={expires}", f"signature={signature}"))
        return ",".join(parts)

    def raw_request(
        self,
        zone: str,
        method: str,
        resource: str,
        *,
        payload: dict[str, Any] | None = None,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        host = self.api_host_for_zone(zone)
        base = self.base_url or f"https://{host}/v2"
        path = "/v2/" + resource.lstrip("/")
        url = base + "/" + resource.lstrip("/")
        if query:
            url += "?" + urllib.parse.urlencode(query)
        body = b"" if payload is None else json.dumps(
            payload, separators=(",", ":")
        ).encode()
        expires = int(time.time()) + 600
        headers = {
            "Authorization": self.authorization(
                self.api_key, self.api_secret, method, path, body, query, expires
            ),
            "Accept": "application/json",
            "User-Agent": f"envr/{VERSION}",
        }
        if payload is not None:
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(
            url, data=body if payload is not None else None, headers=headers, method=method
        )
        try:
            if self.opener_factory is not None:
                open_request = self.opener_factory(host).open
            elif self.opener is not None:
                open_request = self.opener.open
            else:
                open_request = urllib.request.urlopen
            with open_request(request, timeout=timeout) as response:
                content = response.read()
        except urllib.error.HTTPError as error:
            try:
                content = error.read()
            finally:
                error.close()
            raise ApiError(
                error.code,
                VultrAPI._error_message(content, error.reason),
                operation=f"{method} {path}",
                provider=self.display_name,
            ) from error
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            raise ApiError(
                0,
                f"{self.display_name} API network error: {error}",
                provider=self.display_name,
            ) from error
        if not content:
            return {}
        try:
            value = json.loads(content.decode())
        except (UnicodeError, json.JSONDecodeError) as error:
            raise EnvrError("Exoscale API returned malformed JSON") from error
        if not isinstance(value, dict):
            raise EnvrError("Exoscale API returned an unexpected response")
        return value

    def _operation(
        self, zone: str, value: dict[str, Any], *, timeout: int = 300
    ) -> dict[str, Any]:
        operation = value
        identifier = operation.get("id")
        deadline = time.monotonic() + timeout
        while operation.get("state") in (None, "pending"):
            if not identifier:
                raise EnvrError("Exoscale did not return an operation ID")
            if time.monotonic() >= deadline:
                raise ApiError(504, "operation timed out", provider=self.display_name)
            time.sleep(1)
            operation = self.raw_request(zone, "GET", f"operation/{identifier}")
        if operation.get("state") != "success":
            reason = str(operation.get("reason") or "operation failed")
            message = str(operation.get("message") or reason)
            status = 409 if reason in {"busy", "conflict", "unavailable"} else 400
            raise ApiError(status, message, provider=self.display_name)
        return operation

    def _instance(self, value: dict[str, Any], zone: str) -> dict[str, Any]:
        instance_type = value.get("instance-type")
        if not isinstance(instance_type, dict):
            instance_type = {}
        type_id = str(instance_type.get("id") or "")
        if type_id and not instance_type.get("family"):
            instance_type = self._instance_types.get(type_id, instance_type)
        labels = value.get("labels") if isinstance(value.get("labels"), dict) else {}
        state = str(value.get("state") or "pending")
        running = state == "running"
        return {
            "id": str(value.get("id") or ""),
            "provider": "exoscale",
            "label": value.get("name"),
            "hostname": value.get("name"),
            "tags": [MANAGEMENT_TAG] if labels.get("envr") == "managed" else [],
            "region": zone,
            "ram": ExoscaleAPI.memory_mib(instance_type.get("memory")),
            "vcpu_count": int(instance_type.get("cpus") or 0),
            "disk": int(value.get("disk-size") or 0),
            "main_ip": str(value.get("public-ip") or "0.0.0.0"),
            "status": "active" if running else state,
            "power_status": "running" if running else "stopped",
            "plan": (
                f"{instance_type.get('family')}.{instance_type.get('size')}"
                if instance_type.get("family") and instance_type.get("size") else ""
            ),
            "date_created": value.get("created-at") or "",
        }

    def _all_zone(self, zone: str, resource: str, key: str, timeout: int = 30) -> list[dict[str, Any]]:
        response = self.raw_request(zone, "GET", resource, timeout=timeout)
        values = response.get(key)
        if not isinstance(values, list):
            raise EnvrError(f"Exoscale API returned an invalid {key} list")
        return [value for value in values if isinstance(value, dict)]

    def _zone_for_instance(self, identifier: str, timeout: int = 30) -> str:
        cached = self._instance_zones.get(identifier)
        if cached:
            return cached
        for zone in self.regions:
            try:
                values = self._all_zone(zone, "instance", "instances", timeout)
            except ApiError as error:
                if error.status == 404:
                    continue
                raise
            if any(str(value.get("id")) == identifier for value in values):
                self._instance_zones[identifier] = zone
                return zone
        raise ApiError(404, "instance not found", provider=self.display_name)

    def get(self, resource: str, *, query: dict[str, str | int] | None = None, timeout: int = 30) -> dict[str, Any]:
        primary = self.regions[0]
        if resource == "account":
            value = self.raw_request(primary, "GET", "live-balance", timeout=timeout)
            return {"account": {
                "balance": -float(value.get("balance") or 0),
                "pending_charges": 0,
                "currency": str(value.get("currency") or "CHF"),
                "credit_model": "prepaid",
            }}
        if resource == "ssh-keys":
            values = self._all_zone(primary, "ssh-key", "ssh-keys", timeout)
            return {"ssh_keys": [{
                "id": str(value.get("name") or ""),
                "name": value.get("name"),
                "ssh_key": self._key_material.get(str(value.get("name") or "")),
            } for value in values]}
        if resource == "instances":
            instances = []
            for zone in self.regions:
                types = self._all_zone(zone, "instance-type", "instance-types", timeout)
                self._instance_types.update({
                    str(value["id"]): value for value in types if value.get("id")
                })
                for value in self._all_zone(zone, "instance", "instances", timeout):
                    identifier = str(value.get("id") or "")
                    if identifier:
                        self._instance_zones[identifier] = zone
                    instances.append(self._instance(value, zone))
            return {"instances": instances}
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            zone = self._zone_for_instance(identifier, timeout)
            types = self._all_zone(zone, "instance-type", "instance-types", timeout)
            self._instance_types.update({
                str(value["id"]): value for value in types if value.get("id")
            })
            value = self.raw_request(zone, "GET", f"instance/{identifier}", timeout=timeout)
            return {"instance": self._instance(value, zone)}
        if resource == "plans":
            values = self._all_zone(primary, "instance-type", "instance-types", timeout)
            self._instance_types.update({
                str(value["id"]): value for value in values if value.get("id")
            })
            plans = []
            wanted = {alias: (name.split(".", 1)[1]) for alias, name in self.plan_ids.items()}
            for requested, size in wanted.items():
                candidates = [value for value in values if value.get("family") == "standard" and value.get("size") == size]
                if len(candidates) != 1:
                    continue
                backing = candidates[0]
                alias = {
                    "id": self.plan_ids[requested],
                    "provider_plan": str(backing.get("id") or ""),
                    "ram": self.memory_mib(backing.get("memory")),
                    "vcpu_count": int(backing.get("cpus") or 0),
                    "disk": 50,
                    "hourly_cost": None,
                    "monthly_cost": None,
                    "locations": [str(zone) for zone in (backing.get("zones") or [])],
                }
                plans.append(alias)
                self._plans[str(alias["id"])] = alias
            return {"plans": list({str(plan["id"]): plan for plan in plans}.values())}
        if resource == "os":
            values = self._all_zone(primary, "template", "templates", timeout)
            candidates = []
            for value in values:
                name = str(value.get("name") or "")
                version = str(value.get("version") or "")
                if "ubuntu" in name.lower() and ("24.04" in name or version.startswith("24.04")) and value.get("id"):
                    candidates.append(value)
            if not candidates:
                return {"os": []}
            selected = max(
                candidates,
                key=lambda value: (
                    str(value.get("name") or "") == "Linux Ubuntu 24.04 LTS 64-bit",
                    str(value.get("build") or ""),
                    str(value.get("id") or ""),
                ),
            )
            self._template_zones = {
                str(zone) for zone in (selected.get("zones") or [])
            }
            return {"os": [{"id": selected["id"], "name": "Ubuntu 24.04 LTS x64", "family": "ubuntu", "arch": "x64"}]}
        if resource.startswith("regions/") and resource.endswith("/availability"):
            zone = resource.split("/")[1]
            template_available = not self._template_zones or zone in self._template_zones
            return {"available_plans": [
                identifier
                for identifier, plan in self._plans.items()
                if template_available and zone in plan.get("locations", [])
            ]}
        raise EnvrError(f"unsupported Exoscale operation: GET {resource}")

    def _ensure_security_group(self, zone: str) -> str:
        cached = self._security_group_ids.get(zone)
        if cached:
            return cached
        groups = self._all_zone(zone, "security-group", "security-groups")
        group = next((value for value in groups if value.get("name") == self.security_group_name), None)
        if group is None:
            operation = self._operation(zone, self.raw_request(zone, "POST", "security-group", payload={"name": self.security_group_name, "description": "envr managed ingress"}))
            reference = operation.get("reference")
            identifier = str(reference.get("id") or "") if isinstance(reference, dict) else ""
        else:
            identifier = str(group.get("id") or "")
        if not identifier:
            raise EnvrError("Exoscale did not return the managed security-group ID")
        self._security_group_ids[zone] = identifier
        self._ensure_security_rule(zone, identifier, 22, "tcp")
        return identifier

    def _ensure_security_rule(self, zone: str, group_id: str, port: int, protocol: str) -> None:
        group = self.raw_request(zone, "GET", f"security-group/{group_id}")
        rules = group.get("rules") if isinstance(group.get("rules"), list) else []
        if any(value.get("flow-direction") == "ingress" and value.get("protocol") == protocol and int(value.get("start-port") or 0) == port and int(value.get("end-port") or 0) == port and value.get("network") == "0.0.0.0/0" for value in rules if isinstance(value, dict)):
            return
        self._operation(zone, self.raw_request(zone, "POST", f"security-group/{group_id}/rules", payload={"flow-direction": "ingress", "protocol": protocol, "start-port": port, "end-port": port, "network": "0.0.0.0/0", "description": f"envr port {port}"}))

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        primary = self.regions[0]
        if resource == "ssh-keys":
            name, public_key = str(payload["name"]), str(payload["ssh_key"])
            try:
                self._operation(primary, self.raw_request(primary, "POST", "ssh-key", payload={"name": name, "public-key": public_key}))
            except ApiError as error:
                if error.status != 409:
                    raise
            self._key_material[name] = public_key
            return {"ssh_key": {"id": name, "name": name, "ssh_key": public_key}}
        if resource == "instances":
            zone = str(payload["region"])
            plan = self._plans.get(str(payload["plan"])) or {}
            security_group = self._ensure_security_group(zone)
            operation = self._operation(zone, self.raw_request(zone, "POST", "instance", payload={
                "name": payload["label"],
                "instance-type": {"id": plan.get("provider_plan")},
                "template": {"id": payload["os_id"]},
                "disk-size": int(plan.get("disk") or 50),
                "public-ip-assignment": "inet4",
                "labels": {"envr": "managed"},
                "security-groups": [{"id": security_group}],
                "ssh-keys": [{"name": name} for name in (payload.get("sshkey_id") or [])],
                "user-data": payload["user_data"],
                "auto-start": True,
            }))
            reference = operation.get("reference")
            identifier = str(reference.get("id") or "") if isinstance(reference, dict) else ""
            if not identifier:
                raise EnvrError("Exoscale did not return the created instance ID")
            self._instance_zones[identifier] = zone
            value = self.raw_request(zone, "GET", f"instance/{identifier}")
            return {"instance": self._instance(value, zone)}
        raise EnvrError(f"unsupported Exoscale operation: POST {resource}")

    def patch(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            zone = self._zone_for_instance(identifier)
            self._operation(zone, self.raw_request(zone, "PUT", f"instance/{identifier}", payload={"name": payload["label"]}))
            return {}
        raise EnvrError(f"unsupported Exoscale operation: PATCH {resource}")

    def delete(self, resource: str) -> None:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            zone = self._zone_for_instance(identifier)
            self._operation(zone, self.raw_request(zone, "DELETE", f"instance/{identifier}"))
            return
        raise EnvrError(f"unsupported Exoscale operation: DELETE {resource}")

    def request(self, method: str, resource: str, **kwargs: Any) -> dict[str, Any]:
        if method == "POST" and resource.startswith("instances/") and resource.endswith("/start"):
            identifier = resource.split("/")[1]
            zone = self._zone_for_instance(identifier)
            self._operation(zone, self.raw_request(zone, "PUT", f"instance/{identifier}:start", payload={}))
            return {}
        if method == "GET":
            return self.get(resource, query=kwargs.get("query"), timeout=kwargs.get("timeout", 30))
        raise EnvrError(f"unsupported Exoscale operation: {method} {resource}")

    def open_port(self, instance: dict[str, Any], port: int) -> None:
        zone = str(instance.get("region") or self.regions[0])
        identifier = self._ensure_security_group(zone)
        self._ensure_security_rule(zone, identifier, port, "tcp")
        self._ensure_security_rule(zone, identifier, port, "udp")


class AkamaiAPI:
    """Akamai/Linode adapter exposing envr's normalized cloud contract."""

    provider_name = "akamai"
    display_name = "Akamai Cloud"
    api_host = "api.linode.com"
    plan_ids = PROVIDER_PLAN_IDS["akamai"]
    regions = PROVIDER_REGIONS["akamai"]

    def __init__(
        self,
        token: str,
        base_url: str | None = None,
        opener: urllib.request.OpenerDirector | None = None,
    ):
        self.raw = JSONAPI(
            token,
            base_url or AKAMAI_API_BASE,
            self.display_name,
            opener=opener,
        )
        self._keys: dict[str, dict[str, Any]] = {}

    @staticmethod
    def _tags(value: object) -> list[str]:
        return [str(item) for item in value] if isinstance(value, list) else []

    def _instance(self, value: dict[str, Any]) -> dict[str, Any]:
        specs = value.get("specs") if isinstance(value.get("specs"), dict) else {}
        addresses = value.get("ipv4") if isinstance(value.get("ipv4"), list) else []
        main_ip = next(
            (str(item) for item in addresses if not str(item).startswith("192.168.")),
            "0.0.0.0",
        )
        running = value.get("status") == "running"
        return {
            "id": str(value.get("id") or ""),
            "provider": self.provider_name,
            "label": value.get("label"),
            "hostname": value.get("label"),
            "tags": self._tags(value.get("tags")),
            "region": value.get("region"),
            "ram": int(specs.get("memory") or 0),
            "vcpu_count": int(specs.get("vcpus") or 0),
            "disk": int(specs.get("disk") or 0) // 1024,
            "main_ip": main_ip,
            "status": "active" if running else str(value.get("status") or "pending"),
            "power_status": "running" if running else "stopped",
            "plan": value.get("type"),
            "date_created": value.get("created") or "",
        }

    def _all(self, resource: str, *, timeout: int = 30) -> list[dict[str, Any]]:
        response = self.raw.request(
            "GET", resource, query={"page_size": 500}, timeout=timeout
        )
        values = response.get("data")
        if not isinstance(values, list):
            raise EnvrError(f"{self.display_name} API returned an invalid list")
        return [value for value in values if isinstance(value, dict)]

    def get(
        self,
        resource: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        if resource == "account":
            value = self.raw.request("GET", "account", timeout=timeout)
            return {
                "account": {
                    "balance": float(value.get("balance") or 0),
                    "pending_charges": float(value.get("balance_uninvoiced") or 0),
                    "currency": "USD",
                    "credit_model": "postpaid",
                }
            }
        if resource == "ssh-keys":
            values = self._all("profile/sshkeys", timeout=timeout)
            keys = [
                {
                    "id": str(value.get("id") or ""),
                    "name": value.get("label"),
                    "ssh_key": value.get("ssh_key"),
                }
                for value in values
            ]
            self._keys = {str(key["id"]): key for key in keys}
            return {"ssh_keys": keys}
        if resource == "instances":
            return {"instances": [self._instance(v) for v in self._all("linode/instances", timeout=timeout)]}
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            value = self.raw.request("GET", f"linode/instances/{identifier}", timeout=timeout)
            return {"instance": self._instance(value)}
        if resource == "plans":
            plans = []
            for value in self._all("linode/types", timeout=timeout):
                price = value.get("price") if isinstance(value.get("price"), dict) else {}
                plans.append(
                    {
                        "id": value.get("id"),
                        "ram": int(value.get("memory") or 0),
                        "vcpu_count": int(value.get("vcpus") or 0),
                        "disk": int(value.get("disk") or 0) // 1024,
                        "hourly_cost": price.get("hourly"),
                        "monthly_cost": price.get("monthly"),
                        "locations": list(self.regions),
                    }
                )
            return {"plans": plans}
        if resource == "os":
            systems = []
            for value in self._all("images", timeout=timeout):
                identifier = str(value.get("id") or "")
                label = str(value.get("label") or "")
                capabilities = value.get("capabilities") or []
                if (
                    identifier == "linode/ubuntu24.04"
                    or label == "Ubuntu 24.04 LTS"
                ) and "cloud-init" in capabilities:
                    systems.append(
                        {
                            "id": identifier,
                            "name": "Ubuntu 24.04 LTS x64",
                            "family": "ubuntu",
                            "arch": "x64",
                        }
                    )
            return {"os": systems}
        if resource.startswith("regions/") and resource.endswith("/availability"):
            region = resource.split("/")[1]
            regions = self._all("regions", timeout=timeout)
            exists = any(
                value.get("id") == region and "Metadata" in (value.get("capabilities") or [])
                for value in regions
            )
            return {"available_plans": list(self.plan_ids.values()) if exists else []}
        raise EnvrError(f"unsupported {self.display_name} operation: GET {resource}")

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource == "ssh-keys":
            value = self.raw.request(
                "POST",
                "profile/sshkeys",
                payload={"label": payload["name"], "ssh_key": payload["ssh_key"]},
            )
            key = {
                "id": str(value.get("id") or ""),
                "name": value.get("label"),
                "ssh_key": value.get("ssh_key"),
            }
            self._keys[str(key["id"])] = key
            return {"ssh_key": key}
        if resource == "instances":
            password = strong_password()
            raw_payload = {
                "region": payload["region"],
                "type": payload["plan"],
                "image": payload["os_id"],
                "label": payload["label"],
                "tags": payload["tags"],
                "authorized_keys": payload.get("public_keys") or [],
                "root_pass": password,
                "metadata": {"user_data": payload["user_data"]},
                "booted": True,
                "backups_enabled": False,
            }
            value = self.raw.request("POST", "linode/instances", payload=raw_payload)
            instance = self._instance(value)
            instance["default_password"] = password
            return {"instance": instance}
        raise EnvrError(f"unsupported {self.display_name} operation: POST {resource}")

    def patch(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            self.raw.request(
                "PUT", f"linode/instances/{identifier}", payload={"label": payload["label"]}
            )
            return {}
        raise EnvrError(f"unsupported {self.display_name} operation: PATCH {resource}")

    def delete(self, resource: str) -> None:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            self.raw.request("DELETE", f"linode/instances/{identifier}")
            return
        raise EnvrError(f"unsupported {self.display_name} operation: DELETE {resource}")

    def request(self, method: str, resource: str, **kwargs: Any) -> dict[str, Any]:
        if method == "POST" and resource.startswith("instances/") and resource.endswith("/start"):
            identifier = resource.split("/")[1]
            return self.raw.request("POST", f"linode/instances/{identifier}/boot")
        if method == "GET":
            return self.get(resource, query=kwargs.get("query"), timeout=kwargs.get("timeout", 30))
        raise EnvrError(f"unsupported {self.display_name} operation: {method} {resource}")


class DigitalOceanAPI:
    """DigitalOcean adapter exposing envr's normalized cloud contract."""

    provider_name = "digitalocean"
    display_name = "DigitalOcean"
    api_host = "api.digitalocean.com"
    plan_ids = PROVIDER_PLAN_IDS["digitalocean"]
    regions = PROVIDER_REGIONS["digitalocean"]

    def __init__(
        self,
        token: str,
        base_url: str | None = None,
        opener: urllib.request.OpenerDirector | None = None,
    ):
        self.raw = JSONAPI(
            token,
            base_url or DIGITALOCEAN_API_BASE,
            self.display_name,
            opener=opener,
        )

    def _all(
        self,
        resource: str,
        key: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> list[dict[str, Any]]:
        parameters = {"per_page": 200, **(query or {})}
        result: list[dict[str, Any]] = []
        for page in range(1, 101):
            response = self.raw.request(
                "GET",
                resource,
                query={**parameters, "page": page},
                timeout=timeout,
            )
            values = response.get(key)
            if not isinstance(values, list):
                raise EnvrError(
                    f"{self.display_name} API returned an invalid {key} list"
                )
            result.extend(value for value in values if isinstance(value, dict))
            links = response.get("links")
            pages = links.get("pages") if isinstance(links, dict) else None
            if not isinstance(pages, dict) or not pages.get("next"):
                return result
        raise EnvrError(f"{self.display_name} API pagination did not terminate")

    @staticmethod
    def _instance(value: dict[str, Any]) -> dict[str, Any]:
        networks = value.get("networks")
        ipv4 = networks.get("v4") if isinstance(networks, dict) else []
        main_ip = "0.0.0.0"
        if isinstance(ipv4, list):
            for item in ipv4:
                if (
                    isinstance(item, dict)
                    and item.get("type") == "public"
                    and item.get("ip_address")
                ):
                    main_ip = str(item["ip_address"])
                    break
        region = value.get("region")
        region_slug = region.get("slug") if isinstance(region, dict) else region
        status = str(value.get("status") or "new")
        running = status == "active"
        return {
            "id": str(value.get("id") or ""),
            "provider": "digitalocean",
            "label": value.get("name"),
            "hostname": value.get("name"),
            "tags": [str(item) for item in (value.get("tags") or [])],
            "region": region_slug,
            "ram": int(value.get("memory") or 0),
            "vcpu_count": int(value.get("vcpus") or 0),
            "disk": int(value.get("disk") or 0),
            "main_ip": main_ip,
            "status": "active" if running else status,
            "power_status": "running" if running else "stopped",
            "plan": value.get("size_slug"),
            "date_created": value.get("created_at") or "",
        }

    def get(
        self,
        resource: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        if resource == "account":
            # Validate the token independently of the optional billing scope.
            self.raw.request("GET", "account", timeout=timeout)
            try:
                balance = self.raw.request(
                    "GET", "customers/my/balance", timeout=timeout
                )
            except ApiError as error:
                if error.status != 403:
                    raise
                return {
                    "account": {
                        "balance": 0,
                        "pending_charges": 0,
                        "currency": "USD",
                        "credit_model": "postpaid",
                        "billing_available": False,
                    }
                }
            return {
                "account": {
                    "balance": float(balance.get("account_balance") or 0),
                    "pending_charges": float(
                        balance.get("month_to_date_usage") or 0
                    ),
                    "currency": "USD",
                    "credit_model": "postpaid",
                    "billing_available": True,
                }
            }
        if resource == "ssh-keys":
            keys = []
            for value in self._all("account/keys", "ssh_keys", timeout=timeout):
                keys.append(
                    {
                        "id": str(value.get("id") or ""),
                        "name": value.get("name"),
                        "ssh_key": value.get("public_key"),
                    }
                )
            return {"ssh_keys": keys}
        if resource == "instances":
            values = self._all("droplets", "droplets", timeout=timeout)
            return {"instances": [self._instance(value) for value in values]}
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            response = self.raw.request(
                "GET", f"droplets/{identifier}", timeout=timeout
            )
            value = response.get("droplet")
            if not isinstance(value, dict):
                raise EnvrError("DigitalOcean returned invalid Droplet details")
            return {"instance": self._instance(value)}
        if resource == "plans":
            plans = []
            for value in self._all("sizes", "sizes", timeout=timeout):
                if not value.get("available"):
                    continue
                plans.append(
                    {
                        "id": value.get("slug"),
                        "ram": int(value.get("memory") or 0),
                        "vcpu_count": int(value.get("vcpus") or 0),
                        "disk": int(value.get("disk") or 0),
                        "hourly_cost": value.get("price_hourly"),
                        "monthly_cost": value.get("price_monthly"),
                        "locations": [str(item) for item in (value.get("regions") or [])],
                    }
                )
            return {"plans": plans}
        if resource == "os":
            systems = []
            for value in self._all(
                "images",
                "images",
                query={"type": "distribution"},
                timeout=timeout,
            ):
                if (
                    value.get("slug") == "ubuntu-24-04-x64"
                    and value.get("distribution") == "Ubuntu"
                    and value.get("available", True)
                ):
                    systems.append(
                        {
                            "id": "ubuntu-24-04-x64",
                            "name": "Ubuntu 24.04 LTS x64",
                            "family": "ubuntu",
                            "arch": "x64",
                        }
                    )
            return {"os": systems}
        if resource.startswith("regions/") and resource.endswith("/availability"):
            region = resource.split("/")[1]
            values = self._all("regions", "regions", timeout=timeout)
            available = any(
                value.get("slug") == region and value.get("available")
                for value in values
            )
            return {
                "available_plans": list(dict.fromkeys(self.plan_ids.values()))
                if available
                else []
            }
        raise EnvrError(f"unsupported DigitalOcean operation: GET {resource}")

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource == "ssh-keys":
            response = self.raw.request(
                "POST",
                "account/keys",
                payload={
                    "name": payload["name"],
                    "public_key": payload["ssh_key"],
                },
            )
            value = response.get("ssh_key")
            if not isinstance(value, dict):
                raise EnvrError("DigitalOcean did not return the created SSH key")
            return {
                "ssh_key": {
                    "id": str(value.get("id") or ""),
                    "name": value.get("name"),
                    "ssh_key": value.get("public_key"),
                }
            }
        if resource == "instances":
            ssh_keys = [
                int(value) if str(value).isdigit() else value
                for value in (payload.get("sshkey_id") or [])
            ]
            raw_payload = {
                "name": payload["label"],
                "region": payload["region"],
                "size": payload["plan"],
                "image": payload["os_id"],
                "ssh_keys": ssh_keys,
                "backups": False,
                "ipv6": False,
                "monitoring": False,
                "tags": payload.get("tags") or [],
                "user_data": base64.b64decode(payload["user_data"]).decode(),
                "with_droplet_agent": False,
            }
            response = self.raw.request("POST", "droplets", payload=raw_payload)
            value = response.get("droplet")
            if not isinstance(value, dict):
                raise EnvrError("DigitalOcean did not return the created Droplet")
            return {"instance": self._instance(value)}
        raise EnvrError(f"unsupported DigitalOcean operation: POST {resource}")

    def patch(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            self.raw.request(
                "PUT", f"droplets/{identifier}", payload={"name": payload["label"]}
            )
            return {}
        raise EnvrError(f"unsupported DigitalOcean operation: PATCH {resource}")

    def delete(self, resource: str) -> None:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            self.raw.request("DELETE", f"droplets/{identifier}")
            return
        raise EnvrError(f"unsupported DigitalOcean operation: DELETE {resource}")

    def request(self, method: str, resource: str, **kwargs: Any) -> dict[str, Any]:
        if (
            method == "POST"
            and resource.startswith("instances/")
            and resource.endswith("/start")
        ):
            identifier = resource.split("/")[1]
            return self.raw.request(
                "POST", f"droplets/{identifier}/actions", payload={"type": "power_on"}
            )
        if method == "GET":
            return self.get(
                resource,
                query=kwargs.get("query"),
                timeout=kwargs.get("timeout", 30),
            )
        raise EnvrError(
            f"unsupported DigitalOcean operation: {method} {resource}"
        )


class GcoreAPI:
    """Gcore Cloud adapter exposing envr's normalized cloud contract."""

    provider_name = "gcore"
    display_name = "Gcore"
    api_host = "api.gcore.com"
    plan_ids = PROVIDER_PLAN_IDS["gcore"]
    regions = PROVIDER_REGIONS["gcore"]
    security_group_name = "envr-managed"

    def __init__(
        self,
        token: str,
        base_url: str | None = None,
        opener: urllib.request.OpenerDirector | None = None,
    ):
        self.raw = JSONAPI(
            token,
            base_url or GCORE_API_BASE,
            self.display_name,
            opener=opener,
            auth_scheme="APIKey",
        )
        self._project_id: int | None = None
        self._region_ids: dict[str, int] = {}
        self._volume_types: dict[str, list[str]] = {}
        self._plans: dict[str, dict[str, Any]] = {}
        self._region_plans: dict[tuple[str, str], dict[str, Any]] = {}
        self._region_images: dict[str, str] = {}
        self._instance_regions: dict[str, str] = {}
        self._security_group_ids: dict[str, str] = {}

    def ensure_writable(self, *, timeout: int = 30) -> None:
        value = self.raw.request("GET", "iam/clients/me", timeout=timeout)
        status = str(value.get("status") or "").lower()
        if status == "preparation":
            raise EnvrError(
                "Gcore account is still in preparation; finish the portal's "
                "account upgrade/activation before creating a VPS"
            )
        if status in {"blocked", "deleted", "suspended"}:
            raise EnvrError(f"Gcore account is not writable (status: {status})")

    def _all(
        self,
        resource: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> list[dict[str, Any]]:
        offset = 0
        values: list[dict[str, Any]] = []
        while True:
            page_query = dict(query or {})
            page_query.update({"limit": 1000, "offset": offset})
            response = self.raw.request(
                "GET", resource, query=page_query, timeout=timeout
            )
            page = response.get("results")
            if not isinstance(page, list):
                raise EnvrError(f"Gcore API returned an invalid {resource} list")
            items = [item for item in page if isinstance(item, dict)]
            values.extend(items)
            count = response.get("count")
            if len(page) < 1000 or (
                isinstance(count, int) and len(values) >= count
            ):
                return values
            offset += len(page)

    def _project(self, *, timeout: int = 30) -> int:
        if self._project_id is not None:
            return self._project_id
        projects = self._all("cloud/v1/projects", timeout=timeout)
        defaults = [
            item for item in projects
            if item.get("is_default") is True
            and str(item.get("state") or "ACTIVE").upper() == "ACTIVE"
        ]
        if len(defaults) != 1:
            raise EnvrError("Gcore account must have exactly one active default project")
        try:
            self._project_id = int(defaults[0]["id"])
        except (KeyError, TypeError, ValueError) as error:
            raise EnvrError("Gcore default project has no valid ID") from error
        return self._project_id

    def _load_regions(self, *, timeout: int = 30) -> None:
        if self._region_ids:
            return
        values = self._all(
            "cloud/v1/regions",
            query={"show_volume_types": "true"},
            timeout=timeout,
        )
        wanted = set(self.regions)
        for value in values:
            slug = str(value.get("slug") or "")
            if (
                slug not in wanted
                or str(value.get("state") or "ACTIVE").upper() != "ACTIVE"
                or value.get("has_kvm") is False
            ):
                continue
            try:
                self._region_ids[slug] = int(value["id"])
            except (KeyError, TypeError, ValueError):
                continue
            volume_types = value.get("available_volume_types")
            if isinstance(volume_types, list):
                self._volume_types[slug] = [str(item) for item in volume_types]

    def _region_id(self, region: str, *, timeout: int = 30) -> int:
        self._load_regions(timeout=timeout)
        if region not in self._region_ids:
            raise EnvrError(f"Gcore region {region} is unavailable")
        return self._region_ids[region]

    def _tasks(
        self, response: dict[str, Any], *, timeout: int = 600
    ) -> list[dict[str, Any]]:
        identifiers = response.get("tasks")
        if not isinstance(identifiers, list) or not identifiers:
            raise EnvrError("Gcore did not return an operation task")
        completed = []
        deadline = time.monotonic() + timeout
        for raw_identifier in identifiers:
            identifier = str(raw_identifier)
            while True:
                task = self.raw.request("GET", f"cloud/v1/tasks/{identifier}")
                state = str(task.get("state") or "").upper()
                if state == "FINISHED":
                    completed.append(task)
                    break
                if state == "ERROR":
                    raise ApiError(
                        400,
                        str(task.get("error") or "operation failed"),
                        provider=self.display_name,
                    )
                if time.monotonic() >= deadline:
                    raise ApiError(504, "operation timed out", provider=self.display_name)
                time.sleep(1)
        return completed

    @staticmethod
    def _tags(value: dict[str, Any]) -> dict[str, str]:
        tags = value.get("tags")
        if isinstance(tags, dict):
            return {str(key): str(item) for key, item in tags.items()}
        tags_v2 = tags if isinstance(tags, list) else value.get("tags_v2")
        if isinstance(tags_v2, list):
            return {
                str(item.get("key")): str(item.get("value"))
                for item in tags_v2 if isinstance(item, dict) and item.get("key")
            }
        return {}

    def _instance(self, value: dict[str, Any], region: str) -> dict[str, Any]:
        flavor = value.get("flavor") if isinstance(value.get("flavor"), dict) else {}
        assignments = value.get("fixed_ip_assignments")
        main_ip = "0.0.0.0"
        if isinstance(assignments, list):
            for item in assignments:
                if not isinstance(item, dict) or item.get("external") is not True:
                    continue
                candidate = str(item.get("ip_address") or "")
                if candidate:
                    main_ip = candidate
                    break
        addresses = value.get("addresses")
        if main_ip == "0.0.0.0" and isinstance(addresses, dict):
            public = addresses.get("pub_net")
            if isinstance(public, list):
                for item in public:
                    if not isinstance(item, dict):
                        continue
                    candidate = str(item.get("addr") or "")
                    if candidate and ":" not in candidate:
                        main_ip = candidate
                        break
        status = str(value.get("status") or value.get("vm_state") or "pending")
        running = status.lower() in {"active", "running"}
        identifier = str(value.get("id") or "")
        if identifier:
            self._instance_regions[identifier] = region
        return {
            "id": identifier,
            "provider": self.provider_name,
            "label": value.get("name"),
            "hostname": value.get("name"),
            "tags": [MANAGEMENT_TAG] if self._tags(value).get("envr") == "managed" else [],
            "region": region,
            "ram": int(flavor.get("ram") or value.get("ram") or 0),
            "vcpu_count": int(flavor.get("vcpus") or value.get("vcpus") or 0),
            "main_ip": main_ip,
            "status": "active" if running else status.lower(),
            "power_status": "running" if running else "stopped",
            "plan": str(flavor.get("flavor_id") or value.get("flavor_id") or ""),
            "date_created": value.get("created_at") or "",
        }

    def _region_for_instance(self, identifier: str, *, timeout: int = 30) -> str:
        cached = self._instance_regions.get(identifier)
        if cached:
            return cached
        self._load_regions(timeout=timeout)
        for region in self.regions:
            if region not in self._region_ids:
                continue
            region_id = self._region_id(region, timeout=timeout)
            values = self._all(
                f"cloud/v1/instances/{self._project()}/{region_id}",
                timeout=timeout,
            )
            if any(str(item.get("id") or "") == identifier for item in values):
                self._instance_regions[identifier] = region
                return region
        raise ApiError(404, "instance not found", provider=self.display_name)

    def _flavors(self, region: str, *, timeout: int = 30) -> list[dict[str, Any]]:
        return self._all(
            f"cloud/v1/flavors/{self._project()}/{self._region_id(region)}",
            query={"include_prices": "true"},
            timeout=timeout,
        )

    def get(
        self,
        resource: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        project = self._project(timeout=timeout)
        if resource == "account":
            value = self.raw.request("GET", "iam/clients/me", timeout=timeout)
            return {"account": {
                "billing_available": False,
                "billing_reason": "not exposed by the Gcore Cloud API",
                "currency": "EUR",
                "credit_model": "unknown",
                "status": value.get("status"),
            }}
        if resource == "ssh-keys":
            values = self._all(f"cloud/v1/ssh_keys/{project}", timeout=timeout)
            return {"ssh_keys": [{
                "id": str(value.get("id") or value.get("name") or ""),
                "name": value.get("name"),
                "ssh_key": value.get("public_key"),
            } for value in values]}
        if resource == "instances":
            result = []
            self._load_regions(timeout=timeout)
            for region in self.regions:
                if region not in self._region_ids:
                    continue
                region_id = self._region_id(region, timeout=timeout)
                result.extend(
                    self._instance(value, region)
                    for value in self._all(
                        f"cloud/v1/instances/{project}/{region_id}", timeout=timeout
                    )
                )
            return {"instances": result}
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            region = self._region_for_instance(identifier, timeout=timeout)
            value = self.raw.request(
                "GET",
                f"cloud/v1/instances/{project}/{self._region_id(region)}/{identifier}",
                timeout=timeout,
            )
            return {"instance": self._instance(value, region)}
        if resource == "plans":
            self._load_regions(timeout=timeout)
            by_region = {
                region: [
                    item for item in self._flavors(region, timeout=timeout)
                    if not item.get("disabled")
                    and str(item.get("architecture") or "x86_64") == "x86_64"
                    and str(item.get("os_type") or "linux").lower() == "linux"
                    and any(
                        marker in str(
                            item.get("flavor_name") or item.get("flavor_id") or ""
                        ).lower()
                        for marker in ("standard", "basic")
                    )
                ]
                for region in self.regions if region in self._region_ids
            }
            backing_plans: dict[str, dict[str, Any]] = {}
            for region, values in by_region.items():
                for item in values:
                    identifier = str(item.get("flavor_id") or "")
                    if not identifier:
                        continue
                    plan = backing_plans.setdefault(identifier, {
                        "id": identifier,
                        "ram": int(item.get("ram") or 0),
                        "vcpu_count": int(item.get("vcpus") or 0),
                        "disk": 50,
                        "hourly_cost": (
                            float(item["price_per_hour"])
                            if item.get("price_per_hour") is not None else None
                        ),
                        "monthly_cost": (
                            float(item["price_per_month"])
                            if item.get("price_per_month") is not None else None
                        ),
                        "currency": str(item.get("currency_code") or "USD"),
                        "locations": [],
                    })
                    plan["locations"].append(region)
            plans = list(backing_plans.values())
            desired_cpu = {1: 1, 2: 1, 4: 2, 8: 4, 12: 4, 16: 6, 24: 8, 32: 8}
            for requested, alias_id in self.plan_ids.items():
                available_sizes = sorted({
                    int(item.get("ram") or 0)
                    for values in by_region.values() for item in values
                    if int(item.get("ram") or 0) == requested * 1024
                })
                if not available_sizes:
                    continue
                target = available_sizes[0]
                locations = []
                selected: dict[str, Any] | None = None
                for region, values in by_region.items():
                    candidates = [item for item in values if int(item.get("ram") or 0) == target]
                    if not candidates:
                        continue
                    backing = min(candidates, key=lambda item: (
                        "standard" not in str(item.get("flavor_name") or item.get("flavor_id") or "").lower(),
                        abs(int(item.get("vcpus") or 0) - desired_cpu[requested]),
                        int(item.get("vcpus") or 0),
                    ))
                    self._region_plans[(alias_id, region)] = backing
                    locations.append(region)
                    selected = selected or backing
                if selected is None:
                    continue
                hourly = selected.get("price_per_hour")
                monthly = selected.get("price_per_month")
                plan = {
                    "id": alias_id,
                    "provider_plan": str(selected.get("flavor_id") or ""),
                    "ram": target,
                    "vcpu_count": int(selected.get("vcpus") or 0),
                    "disk": 50,
                    "hourly_cost": float(hourly) if hourly is not None else None,
                    "monthly_cost": float(monthly) if monthly is not None else None,
                    "currency": str(selected.get("currency_code") or "USD"),
                    "locations": locations,
                }
                plans.append(plan)
                self._plans[alias_id] = plan
            return {"plans": plans}
        if resource == "os":
            self._load_regions(timeout=timeout)
            for region in self.regions:
                if region not in self._region_ids:
                    continue
                values = self._all(
                    f"cloud/v1/images/{project}/{self._region_id(region)}",
                    query={
                        "os_distro": "ubuntu", "os_version": "24.04",
                        "architecture": "x86_64", "visibility": "public",
                    },
                    timeout=timeout,
                )
                candidates = [
                    item for item in values
                    if item.get("id") and str(item.get("status") or "active").lower() == "active"
                ]
                if candidates:
                    selected = max(candidates, key=lambda item: (
                        "24.04" in str(item.get("name") or ""),
                        str(item.get("updated_at") or item.get("created_at") or ""),
                    ))
                    self._region_images[region] = str(selected["id"])
            return {"os": ([{
                "id": "gcore-ubuntu-24.04-x86_64",
                "name": "Ubuntu 24.04 LTS x64", "family": "ubuntu", "arch": "x64",
            }] if self._region_images else [])}
        if resource.startswith("regions/") and resource.endswith("/availability"):
            region = resource.split("/")[1]
            return {"available_plans": [
                plan_id for plan_id in self.plan_ids.values()
                if (plan_id, region) in self._region_plans and region in self._region_images
            ]}
        raise EnvrError(f"unsupported Gcore operation: GET {resource}")

    def _ensure_security_group(self, region: str) -> str:
        cached = self._security_group_ids.get(region)
        if cached:
            return cached
        project, region_id = self._project(), self._region_id(region)
        groups = self._all(f"cloud/v1/securitygroups/{project}/{region_id}")
        group = next(
            (item for item in groups if item.get("name") == self.security_group_name), None
        )
        if group is None:
            tasks = self._tasks(self.raw.request(
                "POST", f"cloud/v2/security_groups/{project}/{region_id}",
                payload={
                    "name": self.security_group_name,
                    "description": "envr managed ingress",
                    "tags": {"envr": "managed"},
                    "rules": [{
                        "direction": "ingress", "ethertype": "IPv4",
                        "protocol": "tcp", "port_range_min": 22,
                        "port_range_max": 22, "remote_ip_prefix": "0.0.0.0/0",
                    }, {
                        "direction": "egress", "ethertype": "IPv4",
                        "protocol": None, "remote_ip_prefix": "0.0.0.0/0",
                    }, {
                        "direction": "egress", "ethertype": "IPv6",
                        "protocol": None, "remote_ip_prefix": "::/0",
                    }],
                },
            ))
            created = [
                item
                for task in tasks
                for item in (
                    task.get("created_resources", {}).get("security_groups", [])
                    if isinstance(task.get("created_resources"), dict) else []
                )
            ]
            identifier = str(created[0]) if created else ""
            if not identifier:
                groups = self._all(f"cloud/v1/securitygroups/{project}/{region_id}")
                group = next((item for item in groups if item.get("name") == self.security_group_name), None)
                identifier = str(group.get("id") or "") if group else ""
        else:
            identifier = str(group.get("id") or "")
        if not identifier:
            raise EnvrError("Gcore did not return the managed security-group ID")
        self._security_group_ids[region] = identifier
        self._ensure_security_rule(region, identifier, 22, "tcp")
        self._ensure_security_egress(region, identifier, "IPv4", "0.0.0.0/0")
        self._ensure_security_egress(region, identifier, "IPv6", "::/0")
        return identifier

    def _ensure_security_egress(
        self, region: str, group_id: str, ethertype: str, prefix: str
    ) -> None:
        project, region_id = self._project(), self._region_id(region)
        groups = self._all(f"cloud/v1/securitygroups/{project}/{region_id}")
        group = next((item for item in groups if str(item.get("id")) == group_id), {})
        rules = group.get("security_group_rules") if isinstance(group, dict) else []
        if isinstance(rules, list) and any(
            isinstance(item, dict)
            and item.get("direction") == "egress"
            and item.get("ethertype") == ethertype
            and item.get("protocol") in {None, "any"}
            and item.get("remote_ip_prefix") == prefix
            for item in rules
        ):
            return
        self._tasks(self.raw.request(
            "POST", f"cloud/v2/security_groups/{project}/{region_id}/{group_id}/rules",
            payload={
                "direction": "egress", "ethertype": ethertype,
                "protocol": None, "remote_ip_prefix": prefix,
            },
        ))

    def _ensure_security_rule(self, region: str, group_id: str, port: int, protocol: str) -> None:
        project, region_id = self._project(), self._region_id(region)
        groups = self._all(f"cloud/v1/securitygroups/{project}/{region_id}")
        group = next((item for item in groups if str(item.get("id")) == group_id), {})
        rules = group.get("security_group_rules") if isinstance(group, dict) else []
        if isinstance(rules, list) and any(
            isinstance(item, dict)
            and item.get("direction") == "ingress"
            and item.get("protocol") == protocol
            and int(item.get("port_range_min") or 0) == port
            and int(item.get("port_range_max") or 0) == port
            for item in rules
        ):
            return
        self._tasks(self.raw.request(
            "POST", f"cloud/v2/security_groups/{project}/{region_id}/{group_id}/rules",
            payload={
                "direction": "ingress", "ethertype": "IPv4", "protocol": protocol,
                "port_range_min": port, "port_range_max": port,
                "remote_ip_prefix": "0.0.0.0/0",
            },
        ))

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        project = self._project()
        if resource == "ssh-keys":
            value = self.raw.request(
                "POST", f"cloud/v1/ssh_keys/{project}",
                payload={
                    "name": payload["name"], "public_key": payload["ssh_key"],
                    "shared_in_project": True,
                },
            )
            return {"ssh_key": {
                "id": str(value.get("id") or value.get("name") or ""),
                "name": value.get("name") or payload["name"],
                "ssh_key": value.get("public_key") or payload["ssh_key"],
            }}
        if resource == "instances":
            region = str(payload["region"])
            region_id = self._region_id(region)
            backing = self._region_plans.get((str(payload["plan"]), region))
            image_id = self._region_images.get(region)
            if not backing or not image_id:
                raise EnvrError(f"Gcore catalog for {region} is incomplete")
            group_id = self._ensure_security_group(region)
            volume_types = self._volume_types.get(region, [])
            volume_type = "standard" if "standard" in volume_types or not volume_types else volume_types[0]
            keys = self.get("ssh-keys")["ssh_keys"]
            key_ids = {str(item) for item in (payload.get("sshkey_id") or [])}
            key = next((item for item in keys if str(item.get("id")) in key_ids), None)
            if key is None or not key.get("name"):
                raise EnvrError("Gcore could not resolve the managed SSH key name")
            tasks = self._tasks(self.raw.request(
                "POST", f"cloud/v2/instances/{project}/{region_id}",
                payload={
                    "name": payload["label"],
                    "flavor": backing["flavor_id"],
                    "interfaces": [{
                        "type": "external", "ip_family": "ipv4",
                        "security_groups": [{"id": group_id}],
                    }],
                    "volumes": [{
                        "source": "image", "image_id": image_id,
                        "size": 50, "type_name": volume_type,
                        "boot_index": 0, "delete_on_termination": True,
                    }],
                    "ssh_key_name": key["name"],
                    "tags": {"envr": "managed"},
                    "user_data": payload["user_data"],
                },
            ))
            created = [
                item
                for task in tasks
                for item in (
                    task.get("created_resources", {}).get("instances", [])
                    if isinstance(task.get("created_resources"), dict) else []
                )
            ]
            identifier = str(created[0]) if created else ""
            if not identifier:
                candidates = self._all(f"cloud/v1/instances/{project}/{region_id}")
                matches = [item for item in candidates if item.get("name") == payload["label"]]
                if len(matches) != 1:
                    raise EnvrError("Gcore completed creation but did not identify the instance")
                identifier = str(matches[0].get("id") or "")
            self._instance_regions[identifier] = region
            return self.get(f"instances/{identifier}")
        raise EnvrError(f"unsupported Gcore operation: POST {resource}")

    def patch(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            region = self._region_for_instance(identifier)
            value = self.raw.request(
                "PATCH",
                f"cloud/v1/instances/{self._project()}/{self._region_id(region)}/{identifier}",
                payload={"name": payload["label"]},
            )
            return {"instance": self._instance(value, region)}
        raise EnvrError(f"unsupported Gcore operation: PATCH {resource}")

    def delete(self, resource: str) -> None:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            region = self._region_for_instance(identifier)
            response = self.raw.request(
                "DELETE",
                f"cloud/v1/instances/{self._project()}/{self._region_id(region)}/{identifier}",
            )
            if response:
                self._tasks(response)
            return
        raise EnvrError(f"unsupported Gcore operation: DELETE {resource}")

    def request(self, method: str, resource: str, **kwargs: Any) -> dict[str, Any]:
        if method == "POST" and resource.startswith("instances/") and resource.endswith("/start"):
            identifier = resource.split("/")[1]
            region = self._region_for_instance(identifier)
            response = self.raw.request(
                "POST",
                f"cloud/v2/instances/{self._project()}/{self._region_id(region)}/{identifier}/action",
                payload={"action": "start"},
            )
            self._tasks(response)
            return {}
        if method == "GET":
            return self.get(resource, query=kwargs.get("query"), timeout=kwargs.get("timeout", 30))
        raise EnvrError(f"unsupported Gcore operation: {method} {resource}")

    def open_port(self, instance: dict[str, Any], port: int) -> None:
        region = str(instance.get("region") or self._region_for_instance(str(instance["id"])))
        group = self._ensure_security_group(region)
        for protocol in ("tcp", "udp"):
            self._ensure_security_rule(region, group, port, protocol)


class UpCloudAPI:
    """UpCloud adapter exposing envr's normalized cloud contract."""

    provider_name = "upcloud"
    display_name = "UpCloud"
    api_host = "api.upcloud.com"
    plan_ids = PROVIDER_PLAN_IDS["upcloud"]
    regions = PROVIDER_REGIONS["upcloud"]

    def __init__(
        self,
        token: str,
        base_url: str | None = None,
        opener: urllib.request.OpenerDirector | None = None,
    ):
        self.raw = JSONAPI(
            token,
            base_url or UPCLOUD_API_BASE,
            self.display_name,
            opener=opener,
        )
        self._plans: dict[str, dict[str, Any]] = {}
        self._template: str | None = None
        self._deleted_storages: dict[str, list[str]] = {}
        self._currency = "USD"

    @staticmethod
    def _labels(value: object) -> dict[str, str]:
        if not isinstance(value, dict):
            return {}
        items = value.get("label")
        if not isinstance(items, list):
            return {}
        return {
            str(item.get("key")): str(item.get("value"))
            for item in items
            if isinstance(item, dict) and item.get("key")
        }

    @staticmethod
    def _items(value: object, outer: str, inner: str) -> list[dict[str, Any]]:
        if not isinstance(value, dict):
            return []
        container = value.get(outer)
        if not isinstance(container, dict):
            return []
        items = container.get(inner)
        return [item for item in items if isinstance(item, dict)] if isinstance(items, list) else []

    def _instance(self, value: dict[str, Any]) -> dict[str, Any]:
        addresses = value.get("ip_addresses")
        address_items = []
        if isinstance(addresses, dict) and isinstance(addresses.get("ip_address"), list):
            address_items = addresses["ip_address"]
        main_ip = "0.0.0.0"
        for item in address_items:
            if not isinstance(item, dict) or item.get("family") != "IPv4":
                continue
            candidate = str(item.get("address") or "")
            if candidate and item.get("access") == "public":
                main_ip = candidate
                break
        labels = self._labels(value.get("labels"))
        state = str(value.get("state") or "pending")
        return {
            "id": str(value.get("uuid") or ""),
            "provider": self.provider_name,
            "label": value.get("title"),
            "hostname": value.get("hostname"),
            "tags": [MANAGEMENT_TAG] if labels.get("envr") == "managed" else [],
            "region": value.get("zone"),
            "ram": int(value.get("memory_amount") or 0),
            "vcpu_count": int(value.get("core_number") or 0),
            "main_ip": main_ip,
            "status": "active" if state == "started" else state,
            "power_status": "running" if state == "started" else "stopped",
            "plan": value.get("plan"),
            "date_created": value.get("created") or "",
        }

    def _server_details(self, identifier: str, *, timeout: int = 30) -> dict[str, Any]:
        response = self.raw.request("GET", f"server/{identifier}", timeout=timeout)
        value = response.get("server")
        if not isinstance(value, dict):
            raise EnvrError("UpCloud API returned invalid server details")
        return value

    def _zones(self, *, timeout: int = 30) -> list[str]:
        response = self.raw.request("GET", "zone", timeout=timeout)
        values = self._items(response, "zones", "zone")
        return [str(value.get("id")) for value in values if value.get("id")]

    def _zone_prices(self, region: str, *, timeout: int = 30) -> dict[str, Any]:
        response = self.raw.request("GET", "price", timeout=timeout)
        prices = response.get("prices")
        if isinstance(prices, dict) and prices.get("currency"):
            self._currency = str(prices["currency"])
        zones = prices.get("zone") if isinstance(prices, dict) else None
        if not isinstance(zones, list):
            raise EnvrError("UpCloud API returned an invalid price list")
        value = next(
            (
                item for item in zones
                if isinstance(item, dict) and str(item.get("name")) == region
            ),
            None,
        )
        if value is None:
            raise EnvrError(f"UpCloud has no live pricing for {region}")
        return value

    @staticmethod
    def _hourly_price(price: object) -> float | None:
        if not isinstance(price, dict):
            return None
        try:
            # UpCloud's price list is expressed in hundredths of the account
            # currency per hour.
            return float(price["price"]) / 100
        except (KeyError, TypeError, ValueError):
            return None

    def get(
        self,
        resource: str,
        *,
        query: dict[str, str | int] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        if resource == "account":
            response = self.raw.request("GET", "account", timeout=timeout)
            value = response.get("account")
            if not isinstance(value, dict):
                raise EnvrError("UpCloud API returned invalid account information")
            credits = float(value.get("credits") or 0) / 100
            return {
                "account": {
                    "balance": -credits,
                    "pending_charges": 0,
                    # UpCloud's account response omits currency. Its live price
                    # catalog is USD unless it explicitly reports otherwise.
                    "currency": str(value.get("currency") or self._currency),
                    "credit_model": "prepaid",
                }
            }
        if resource == "ssh-keys":
            # UpCloud injects keys directly at creation. Running VPS enrollment
            # and the copied authorized_keys file remain authoritative.
            return {"ssh_keys": []}
        if resource == "instances":
            response = self.raw.request("GET", "server", timeout=timeout)
            values = self._items(response, "servers", "server")
            normalized = []
            for value in values:
                if value.get("title") in {LABEL, RESIZE_TARGET_LABEL, RESIZE_SOURCE_LABEL}:
                    value = self._server_details(str(value.get("uuid")), timeout=timeout)
                normalized.append(self._instance(value))
            return {"instances": normalized}
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            return {"instance": self._instance(self._server_details(identifier, timeout=timeout))}
        if resource == "plans":
            response = self.raw.request("GET", "plan", timeout=timeout)
            values = self._items(response, "plans", "plan")
            available_zones = set(self._zones(timeout=timeout))
            regions = [region for region in self.regions if region in available_zones]
            if not regions:
                raise EnvrError("UpCloud has no configured European region")
            prices = self._zone_prices(regions[0], timeout=timeout)
            plans = []
            for value in values:
                offering = value.get("current_offering", "yes")
                if str(offering).lower() not in {"yes", "true", "1"}:
                    continue
                plan = {
                    "id": value.get("name"),
                    "ram": int(value.get("memory_amount") or 0),
                    "vcpu_count": int(value.get("core_number") or 0),
                    "disk": int(value.get("storage_size") or 0),
                    "storage_tier": str(value.get("storage_tier") or "maxiops"),
                    "hourly_cost": self._hourly_price(
                        prices.get(f"server_plan_{value.get('name')}")
                    ),
                    "currency": self._currency,
                    "locations": regions,
                }
                if plan["hourly_cost"] is not None:
                    plan["monthly_cost"] = round(plan["hourly_cost"] * 672, 2)
                else:
                    plan["monthly_cost"] = None
                plans.append(plan)
                self._plans[str(plan["id"])] = plan
            # UpCloud plan names evolve. Present stable envr aliases while
            # retaining a live backing plan selected by memory, CPU and total
            # deployable cost. Cloud Native plans do not bundle a boot disk or
            # IPv4 address, so include both explicitly in their displayed cost.
            def deployment_candidate(item: dict[str, Any]) -> dict[str, Any]:
                candidate = dict(item)
                if int(candidate.get("disk") or 0) > 0:
                    return candidate
                candidate["disk"] = 50
                candidate["storage_tier"] = "maxiops"
                candidate["unbundled_resources"] = True
                hourly = candidate.get("hourly_cost")
                for name, quantity in (("storage_maxiops", 50), ("ipv4_address", 1)):
                    component = self._hourly_price(prices.get(name))
                    if hourly is None or component is None:
                        hourly = None
                        break
                    hourly = float(hourly) + component * quantity
                candidate["hourly_cost"] = hourly
                candidate["monthly_cost"] = (
                    round(float(hourly) * 672, 2)
                    if hourly is not None else None
                )
                return candidate

            # There is currently no exact deployable 12 GB plan. It is omitted
            # instead of pretending that a larger plan or sales-only custom
            # configuration is the requested size.
            desired_cpu = {1: 1, 2: 1, 4: 2, 8: 4, 16: 6, 24: 8, 32: 8}
            for ram_gb, cpu in desired_cpu.items():
                candidates = [
                    deployment_candidate(item) for item in plans
                    if int(item.get("ram") or 0) == ram_gb * 1024
                ]
                if not candidates:
                    continue
                backing = min(
                    candidates,
                    key=lambda item: (
                        abs(int(item.get("vcpu_count") or 0) - cpu),
                        int(item.get("vcpu_count") or 0) < cpu,
                        float(item.get("hourly_cost") or float("inf")),
                    ),
                )
                alias = dict(backing)
                alias["id"] = self.plan_ids[ram_gb]
                alias["provider_plan"] = backing["id"]
                plans.append(alias)
                self._plans[str(alias["id"])] = alias
            return {"plans": plans}
        if resource == "os":
            response = self.raw.request("GET", "storage/template", timeout=timeout)
            values = self._items(response, "storages", "storage")
            systems = []
            for value in values:
                title = str(value.get("title") or "")
                normalized_title = title.lower()
                if (
                    ("ubuntu server 24.04" in normalized_title
                     or normalized_title == "ubuntu 24.04 lts")
                    and "nvidia" not in normalized_title
                    and "cuda" not in normalized_title
                    and str(value.get("state") or "online") == "online"
                ):
                    identifier = str(value.get("uuid") or "")
                    systems.append(
                        {
                            "id": identifier,
                            "name": "Ubuntu 24.04 LTS x64",
                            "family": "ubuntu",
                            "arch": "x64",
                        }
                    )
                    self._template = identifier
            return {"os": systems}
        if resource.startswith("regions/") and resource.endswith("/availability"):
            region = resource.split("/")[1]
            return {
                "available_plans": list(self.plan_ids.values())
                if region in self._zones(timeout=timeout)
                else []
            }
        raise EnvrError(f"unsupported UpCloud operation: GET {resource}")

    def post(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource == "ssh-keys":
            identifier = hashlib.sha256(str(payload["ssh_key"]).encode()).hexdigest()[:12]
            return {
                "ssh_key": {
                    "id": identifier,
                    "name": payload["name"],
                    "ssh_key": payload["ssh_key"],
                }
            }
        if resource == "instances":
            plan = self._plans.get(str(payload["plan"])) or {}
            disk = int(plan.get("disk") or 160)
            custom = bool(plan.get("custom"))
            server: dict[str, Any] = {
                "zone": payload["region"],
                "title": payload["label"],
                "hostname": payload["hostname"],
                "metadata": "yes",
                "user_data": base64.b64decode(payload["user_data"]).decode(),
                "password_delivery": "none",
                "login_user": {
                    "username": "root",
                    "create_password": "no",
                    "ssh_keys": {"ssh_key": payload.get("public_keys") or []},
                },
                "labels": {"label": [{"key": "envr", "value": "managed"}]},
                "storage_devices": {
                    "storage_device": [
                        {
                            "action": "clone",
                            "storage": payload["os_id"],
                            "title": f"{payload['label']}-system",
                            "size": str(disk),
                            "tier": str(plan.get("storage_tier") or "maxiops"),
                        }
                    ]
                },
            }
            if custom:
                server.update(
                    {
                        "plan": "custom",
                        "core_number": int(plan.get("vcpu_count") or 8),
                        "memory_amount": int(plan.get("ram") or 24 * 1024),
                    }
                )
            else:
                server["plan"] = str(plan.get("provider_plan") or payload["plan"])
            response = self.raw.request("POST", "server", payload={"server": server})
            value = response.get("server")
            if not isinstance(value, dict):
                raise EnvrError("UpCloud did not return the created server")
            return {"instance": self._instance(value)}
        raise EnvrError(f"unsupported UpCloud operation: POST {resource}")

    def patch(self, resource: str, payload: dict[str, Any]) -> dict[str, Any]:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            self.raw.request(
                "PUT", f"server/{identifier}", payload={"server": {"title": payload["label"]}}
            )
            return {}
        raise EnvrError(f"unsupported UpCloud operation: PATCH {resource}")

    def delete(self, resource: str) -> None:
        if resource.startswith("instances/"):
            identifier = resource.split("/", 1)[1]
            details = self._server_details(identifier)
            state = str(details.get("state") or "")
            if state == "started":
                self.raw.request(
                    "POST",
                    f"server/{identifier}/stop",
                    payload={
                        "stop_server": {"stop_type": "soft", "timeout": "60"}
                    },
                )
            deadline = time.monotonic() + DELETE_TIMEOUT
            while state != "stopped":
                if time.monotonic() >= deadline:
                    raise EnvrError(
                        f"UpCloud server {identifier} did not stop before deletion"
                    )
                time.sleep(2)
                details = self._server_details(identifier)
                state = str(details.get("state") or "")
            devices = details.get("storage_devices")
            device_items = (
                devices.get("storage_device") if isinstance(devices, dict) else []
            )
            storage_ids = [
                str(item.get("storage"))
                for item in device_items
                if isinstance(item, dict) and item.get("storage")
            ] if isinstance(device_items, list) else []
            self.raw.request(
                "DELETE",
                f"server/{identifier}",
                query={"storages": 1, "backups": "delete"},
            )
            self._deleted_storages[identifier] = storage_ids
            return
        raise EnvrError(f"unsupported UpCloud operation: DELETE {resource}")

    def verify_instance_deleted(self, identifier: str) -> bool:
        for storage_id in self._deleted_storages.get(identifier, []):
            try:
                self.raw.request("GET", f"storage/{storage_id}", timeout=10)
            except ApiError as error:
                if error.status == 404:
                    continue
                raise
            return False
        self._deleted_storages.pop(identifier, None)
        return True

    def request(self, method: str, resource: str, **kwargs: Any) -> dict[str, Any]:
        if method == "POST" and resource.startswith("instances/") and resource.endswith("/start"):
            identifier = resource.split("/")[1]
            return self.raw.request("POST", f"server/{identifier}/start")
        if method == "GET":
            return self.get(resource, query=kwargs.get("query"), timeout=kwargs.get("timeout", 30))
        raise EnvrError(f"unsupported UpCloud operation: {method} {resource}")


class Envr:
    def __init__(self, root: Path | None = None):
        self.root = root or data_root()
        self.token_path = self.root / "api"
        self.cloud_path = self.root / "cloud.json"
        self.providers_root = self.root / "providers"
        self.auth_path = self.root / "codex" / "auth.json"
        self.git_root = self.root / "git"
        self.ssh_root = self.root / "ssh"
        self.vps_key = self.ssh_root / "id_ed25519"
        self.vps_public_key = self.ssh_root / "id_ed25519.pub"
        self.vps_known_hosts = self.ssh_root / "known_hosts"
        self.relay_root = self.root / "relay"
        self.relay_config_path = self.relay_root / "config.json"
        self.relay_key = self.relay_root / "id_ed25519"
        self.relay_public_key = self.relay_root / "id_ed25519.pub"
        self.relay_known_hosts = self.relay_root / "known_hosts"
        self._api_tunnels: dict[str, RelayAPITunnel] = {}
        self._api_openers: dict[str, urllib.request.OpenerDirector] = {}
        self._apis: dict[str, Any] = {}
        self._plan_catalogs: dict[str, dict[str, dict[str, Any]]] = {}
        self._ubuntu_os_ids: dict[str, str | int] = {}
        self._account_responses: dict[str, dict[str, Any]] = {}
        self._managed_ssh_keys: dict[str, list[dict[str, Any]]] = {}
        self._region_availability: dict[tuple[str, str], set[str]] = {}
        self._authorized_instances: set[tuple[str, str]] = set()
        self._resize_markers: dict[str, tuple[str, int | None] | None] = {}
        self.repos_path = self.root / "repos.json"
        self.state_path = self.root / "state.json"
        self.password_path = self.root / "instance-password"
        self._ssh_session_id = secrets.token_hex(4)
        if root is None:
            self.migrate_legacy_layout()

    def migrate_legacy_layout(self) -> None:
        legacy = Path.home() / "envr"
        if self.root == legacy or not legacy.is_dir():
            return
        names = (
            "api",
            "codex",
            "git",
            "ssh",
            "repos.json",
            "state.json",
            "instance-password",
            "client-id",
            "relay",
            "cloud.json",
            "providers",
        )
        candidates = [name for name in names if (legacy / name).exists()]
        if not candidates:
            return
        ensure_private_dir(self.root)
        moved = []
        for name in candidates:
            source = legacy / name
            destination = self.root / name
            if destination.exists():
                continue
            ensure_private_dir(destination.parent)
            os.replace(source, destination)
            moved.append(name)
        if moved:
            print(f"Migrated envr state to {self.root}")

    def ensure_layout(self) -> None:
        ensure_private_dir(self.root)
        ensure_private_dir(self.git_root)
        ensure_private_dir(self.ssh_root)
        ensure_private_dir(self.auth_path.parent)
        ensure_private_dir(self.providers_root)
        if self.relay_root.exists():
            ensure_private_dir(self.relay_root)

    def management_tag(self) -> str:
        return MANAGEMENT_TAG

    def repositories(self) -> dict[str, Any]:
        default = {"schema": SCHEMA_VERSION, "repositories": {}}
        value = load_json(self.repos_path, default=default)
        repositories = value.get("repositories")
        if not isinstance(repositories, dict):
            raise EnvrError(f"{self.repos_path} has an invalid repositories object")
        return value

    def save_repositories(self, value: dict[str, Any]) -> None:
        value["schema"] = SCHEMA_VERSION
        atomic_write_json(self.repos_path, value)

    def state(self) -> dict[str, Any]:
        value = load_json(
            self.state_path,
            default={"schema": SCHEMA_VERSION, "instance_id": None},
        )
        if value.get("instance_id") and not value.get("provider"):
            value["provider"] = "vultr"
        return value

    def save_state(self, value: dict[str, Any]) -> None:
        value["schema"] = SCHEMA_VERSION
        atomic_write_json(self.state_path, value)

    def save_instance_state(
        self,
        instance: dict[str, Any],
        *,
        ram_gb: int | None = None,
        region: str | None = None,
    ) -> None:
        instance_id = str(instance.get("id") or "")
        if not instance_id:
            raise EnvrError("cannot cache an instance without an ID")
        existing = self.state()
        provider = str(instance.get("provider") or existing.get("provider") or "vultr")
        identity_changed = (
            existing.get("instance_id") != instance_id
            or str(existing.get("provider") or "vultr") != provider
        )
        if identity_changed:
            existing = {}
        main_ip = str(instance.get("main_ip") or existing.get("main_ip") or "")
        detected_ram = int(instance.get("ram") or 0) // 1024
        instance_plan = str(instance.get("plan") or "")
        requested_matches = [
            requested
            for requested, plan_id in PROVIDER_PLAN_IDS.get(provider, {}).items()
            if instance_plan == plan_id
        ]
        if len(requested_matches) == 1:
            detected_ram = requested_matches[0]
        elif detected_ram not in requested_matches and requested_matches:
            detected_ram = requested_matches[0]
        value: dict[str, Any] = {
            "schema": SCHEMA_VERSION,
            "instance_id": instance_id,
            "provider": provider,
            "ram_gb": (
                ram_gb
                if ram_gb is not None
                else int(
                    existing.get("ram_gb")
                    or detected_ram
                )
            ),
            "region": region or instance.get("region") or existing.get("region"),
        }
        if main_ip and main_ip != "0.0.0.0":
            try:
                address = ipaddress.ip_address(main_ip)
            except ValueError as error:
                raise EnvrError("provider returned an invalid instance IP address") from error
            if address.version != 4:
                raise EnvrError("envr requires a public IPv4 address")
            value["main_ip"] = main_ip
        self.save_state(value)
        password = str(instance.get("default_password") or "").strip()
        if password:
            atomic_write_text(self.password_path, password + "\n")
        elif identity_changed:
            with contextlib.suppress(FileNotFoundError):
                self.password_path.unlink()

    def cached_instance(self, ram_gb: int | None = None) -> dict[str, Any] | None:
        state = self.state()
        instance_id = str(state.get("instance_id") or "")
        main_ip = str(state.get("main_ip") or "")
        try:
            cached_ram_gb = int(state.get("ram_gb") or 0)
        except (TypeError, ValueError):
            return None
        if (
            not instance_id
            or (ram_gb is not None and cached_ram_gb != ram_gb)
            or not self.vps_key.is_file()
            or not self.vps_known_hosts.is_file()
        ):
            return None
        if not main_ip:
            main_ip = self.single_known_host_ip() or ""
            if main_ip:
                self.save_instance_state(
                    {
                        "id": instance_id,
                        "main_ip": main_ip,
                        "ram": cached_ram_gb * 1024,
                        "region": state.get("region"),
                    }
                )
        if not main_ip:
            return None
        try:
            address = ipaddress.ip_address(main_ip)
        except ValueError:
            return None
        if address.version != 4:
            return None
        return {
            "id": instance_id,
            "main_ip": main_ip,
            "ram": cached_ram_gb * 1024,
            "region": state.get("region"),
            "status": "active",
            "power_status": "running",
            "provider": str(state.get("provider") or "vultr"),
        }

    def single_known_host_ip(self) -> str | None:
        try:
            lines = self.vps_known_hosts.read_text(encoding="utf-8").splitlines()
        except (FileNotFoundError, OSError, UnicodeError):
            return None
        addresses: set[str] = set()
        for line in lines:
            fields = line.strip().split()
            if not fields or fields[0].startswith("#"):
                continue
            host_field_index = 1 if fields[0].startswith("@") else 0
            if len(fields) <= host_field_index:
                continue
            for host in fields[host_field_index].split(","):
                candidate = host
                if host.startswith("[") and "]:" in host:
                    candidate = host[1 : host.index("]:")]
                try:
                    address = ipaddress.ip_address(candidate)
                except ValueError:
                    continue
                if address.version == 4:
                    addresses.add(str(address))
        if len(addresses) == 1:
            return addresses.pop()
        return None

    def clear_instance_state(self) -> None:
        with contextlib.suppress(FileNotFoundError):
            self.state_path.unlink()
        with contextlib.suppress(FileNotFoundError):
            self.password_path.unlink()
        for pattern in ("control-*", "c-*"):
            for control_socket in self.ssh_root.glob(pattern):
                with contextlib.suppress(FileNotFoundError):
                    control_socket.unlink()
        fsync_directory(self.root)

    def relay_config(self) -> RelayConfig | None:
        if not self.relay_config_path.exists():
            return None
        value = load_json(self.relay_config_path)
        return RelayConfig.from_dict(value)

    def ensure_relay_key(self) -> str:
        ensure_commands(("ssh", "ssh-keygen"))
        ensure_private_dir(self.relay_root)
        if not self.relay_key.exists() or not self.relay_public_key.exists():
            with tempfile.TemporaryDirectory(dir=self.root) as temporary_directory:
                temporary_key = Path(temporary_directory) / "id_ed25519"
                run(
                    [
                        "ssh-keygen",
                        "-q",
                        "-t",
                        "ed25519",
                        "-N",
                        "",
                        "-C",
                        f"envr-relay:{platform.node() or 'device'}",
                        "-f",
                        str(temporary_key),
                    ]
                )
                atomic_write(self.relay_key, temporary_key.read_bytes())
                atomic_write(
                    self.relay_public_key,
                    temporary_key.with_suffix(".pub").read_bytes(),
                )
        self.relay_key.chmod(0o600)
        self.relay_public_key.chmod(0o600)
        return self.relay_public_key.read_text(encoding="utf-8").strip()

    def relay_ssh_options(
        self,
        relay: RelayConfig | None = None,
        *,
        multiplex: bool = True,
    ) -> list[str]:
        relay = relay or self.relay_config()
        if relay is None:
            raise EnvrError("SSH relay is not configured")
        ensure_private_dir(self.relay_root)
        self.relay_known_hosts.touch(mode=0o600, exist_ok=True)
        self.relay_known_hosts.chmod(0o600)
        relay_identity = hashlib.sha256(
            f"{relay.user}@{relay.host}:{relay.port}".encode()
        ).hexdigest()[:12]
        control_path = self.relay_root / (
            f"c-{relay_identity}-{self._ssh_session_id}"
        )
        options = [
            "-p",
            str(relay.port),
            "-i",
            str(self.relay_key),
            "-o",
            "IdentitiesOnly=yes",
            "-o",
            "BatchMode=yes",
            "-o",
            "StrictHostKeyChecking=yes",
            "-o",
            f"UserKnownHostsFile={self.relay_known_hosts}",
            "-o",
            "ForwardAgent=no",
            "-o",
            "RequestTTY=no",
            "-o",
            f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
            "-o",
            "ServerAliveInterval=30",
            "-o",
            "ServerAliveCountMax=3",
        ]
        if multiplex:
            options.extend(
                [
                    "-o",
                    "ControlMaster=auto",
                    "-o",
                    "ControlPersist=300",
                    "-o",
                    f"ControlPath={control_path}",
                ]
            )
        return options

    def install_relay_key(self, relay: RelayConfig, public_key: str) -> None:
        ensure_private_dir(self.relay_root)
        self.relay_known_hosts.touch(mode=0o600, exist_ok=True)
        self.relay_known_hosts.chmod(0o600)
        restricted_key = (
            'restrict,port-forwarding,command="/bin/false" ' + public_key.strip()
        )
        remote_install = (
            "set -eu; "
            "IFS= read -r key; "
            'umask 077; mkdir -p "$HOME/.ssh"; '
            'chmod 700 "$HOME/.ssh"; '
            'touch "$HOME/.ssh/authorized_keys"; '
            'chmod 600 "$HOME/.ssh/authorized_keys"; '
            'grep -qxF "$key" "$HOME/.ssh/authorized_keys" || '
            'printf "%s\\n" "$key" >> "$HOME/.ssh/authorized_keys"'
        )
        print("Enter the relay SSH password once. It will not be stored.")
        run(
            [
                "ssh",
                "-T",
                "-p",
                str(relay.port),
                "-o",
                "IdentitiesOnly=yes",
                "-o",
                "PreferredAuthentications=password,keyboard-interactive",
                "-o",
                "PubkeyAuthentication=no",
                "-o",
                "NumberOfPasswordPrompts=1",
                "-o",
                "StrictHostKeyChecking=ask",
                "-o",
                f"UserKnownHostsFile={self.relay_known_hosts}",
                "-o",
                f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
                relay.target,
                remote_install,
            ],
            input_data=restricted_key + "\n",
        )

    @staticmethod
    def relay_api_ipv4(api_host: str = "api.vultr.com") -> str:
        try:
            answers = socket.getaddrinfo(
                api_host,
                443,
                family=socket.AF_INET,
                type=socket.SOCK_STREAM,
            )
        except socket.gaierror as error:
            raise EnvrError(
                f"could not resolve an IPv4 address for {api_host}: {error}"
            ) from error
        addresses = [
            str(answer[4][0])
            for answer in answers
            if answer[4] and answer[4][0]
        ]
        if not addresses:
            raise EnvrError(
                f"{api_host} did not resolve to an IPv4 address"
            )
        return addresses[0]

    def verify_relay(self, relay: RelayConfig) -> None:
        provider = self.selected_provider()
        api_host = PROVIDER_API_HOSTS[provider]
        tunnel = RelayAPITunnel(
            self.relay_ssh_options(relay, multiplex=False),
            relay.target,
            self.relay_api_ipv4(api_host),
            api_host,
        )
        try:
            tunnel.start()
            tunnel.verify_tls()
        finally:
            tunnel.close()

    def configure_relay(self, existing: RelayConfig | None = None) -> None:
        ensure_commands(("ssh", "ssh-keygen"))
        default_host = existing.host if existing is not None else ""
        default_port = existing.port if existing is not None else 22
        default_user = existing.user if existing is not None else ""
        host_prompt = f"Relay IP [{default_host}]: " if default_host else "Relay IP: "
        user_prompt = (
            f"SSH user [{default_user}]: " if default_user else "SSH user: "
        )
        host = input(host_prompt).strip() or default_host
        port_text = input(f"SSH port [{default_port}]: ").strip()
        user = input(user_prompt).strip() or default_user
        candidate = RelayConfig.from_dict(
            {
                "host": host,
                "port": port_text or default_port,
                "user": user,
            }
        )
        public_key = self.ensure_relay_key()
        self.install_relay_key(candidate, public_key)
        print("Verifying secure forwarding...")
        self.verify_relay(candidate)
        atomic_write_json(self.relay_config_path, candidate.as_dict())
        print(f"Relay ready: {candidate.target}:{candidate.port}")

    def delete_relay(self, relay: RelayConfig) -> None:
        self.close_api_tunnel()
        run(
            [
                "ssh",
                *self.relay_ssh_options(relay),
                "-O",
                "exit",
                relay.target,
            ],
            check=False,
            quiet=True,
            timeout=5,
        )
        for path in (
            self.relay_config_path,
            self.relay_key,
            self.relay_public_key,
            self.relay_known_hosts,
        ):
            with contextlib.suppress(FileNotFoundError):
                path.unlink()
        for pattern in ("control-*", "c-*"):
            for control_socket in self.relay_root.glob(pattern):
                with contextlib.suppress(FileNotFoundError):
                    control_socket.unlink()
        for pattern in ("control-relay-*", "c-*"):
            for control_socket in self.ssh_root.glob(pattern):
                with contextlib.suppress(FileNotFoundError):
                    control_socket.unlink()
        with contextlib.suppress(FileNotFoundError, OSError):
            self.relay_root.rmdir()
        fsync_directory(self.root)
        print("Relay configuration deleted. envr will connect directly.")

    def relay_menu(self) -> None:
        relay = self.relay_config()
        if relay is None:
            self.configure_relay()
            return
        while True:
            print("\nRelay")
            print(f"  IP:       {relay.host}")
            print(f"  User:     {relay.user}")
            print(f"  Port:     {relay.port}")
            print("  Password: not stored (key-only)")
            choice = input("\n[E] Edit  [D] Delete  [Q] Quit: ").strip().lower()
            if choice in {"", "q"}:
                return
            if choice == "e":
                self.configure_relay(relay)
                return
            if choice == "d":
                if prompt_yes_no("Delete the local relay configuration?"):
                    self.delete_relay(relay)
                    return
                continue
            print("Choose E, D, or Q.")

    def ensure_api_host_tunnel(
        self, relay: RelayConfig, api_host: str
    ) -> urllib.request.OpenerDirector:
        if api_host in self._api_openers:
            return self._api_openers[api_host]
        ensure_commands(("ssh",))
        tunnel = RelayAPITunnel(
            self.relay_ssh_options(relay, multiplex=False),
            relay.target,
            self.relay_api_ipv4(api_host),
            api_host,
        )
        try:
            opener = tunnel.start()
        except BaseException:
            tunnel.close()
            raise
        self._api_tunnels[api_host] = tunnel
        self._api_openers[api_host] = opener
        return opener

    def ensure_api_tunnel(
        self, relay: RelayConfig, provider: str
    ) -> urllib.request.OpenerDirector:
        api_host = PROVIDER_API_HOSTS[provider]
        custom_api = os.environ.get("ENVR_VULTR_API") if provider == "vultr" else None
        if custom_api:
            parsed = urllib.parse.urlsplit(custom_api)
            if parsed.scheme != "https" or parsed.hostname != api_host:
                raise EnvrError(
                    "a custom Vultr API endpoint cannot use the SSH relay"
                )
        return self.ensure_api_host_tunnel(relay, api_host)

    def close_api_tunnel(self) -> None:
        for tunnel in self._api_tunnels.values():
            tunnel.close()
        self._api_tunnels.clear()
        self._api_openers.clear()

    def provider_token_path(self, provider: str) -> Path:
        if provider == "vultr":
            return self.token_path
        return self.providers_root / provider / "api"

    def cloud_config(self) -> dict[str, Any]:
        value = load_json(
            self.cloud_path,
            default={"schema": SCHEMA_VERSION, "selected": "vultr"},
        )
        selected = str(value.get("selected") or "vultr")
        if selected not in PROVIDER_NAMES:
            raise EnvrError(f"{self.cloud_path} has an invalid selected provider")
        value["selected"] = selected
        return value

    def selected_provider(self) -> str:
        return str(self.cloud_config()["selected"])

    def configured_providers(self) -> list[str]:
        return [
            provider
            for provider in PROVIDER_NAMES
            if self.provider_token_path(provider).is_file()
            and bool(self.provider_token_path(provider).read_text(encoding="utf-8").strip())
        ]

    @staticmethod
    def provider_name(api: Any) -> str:
        return str(getattr(api, "provider_name", "vultr"))

    @staticmethod
    def provider_label(api: Any) -> str:
        return str(getattr(api, "display_name", "Vultr"))

    def instance_api(self, instance: dict[str, Any], *, prompt: bool = False) -> Any:
        return self.api(str(instance.get("provider") or "vultr"), prompt=prompt)

    def provider_inventories(
        self, *, include_selected: bool = False
    ) -> list[tuple[Any, list[dict[str, Any]]]]:
        providers = self.configured_providers()
        selected = self.selected_provider()
        prompt_provider: str | None = None
        if not providers:
            providers.append(selected)
            prompt_provider = selected
        if include_selected and selected not in providers:
            providers.append(selected)
        state_provider = str(self.state().get("provider") or selected)
        ordered = (
            [state_provider] if state_provider in providers else []
        ) + [
            provider for provider in PROVIDER_NAMES
            if provider in providers and provider != state_provider
        ]

        def load(provider: str) -> tuple[Any, list[dict[str, Any]]]:
            api = self.api(
                provider,
                prompt=(provider == prompt_provider)
                or (include_selected and provider == selected),
            )
            return api, self.all_instances(api)

        if prompt_provider is not None:
            prompted = load(prompt_provider)
            return [prompted]
        with concurrent.futures.ThreadPoolExecutor(
            max_workers=len(ordered)
        ) as executor:
            futures = {provider: executor.submit(load, provider) for provider in ordered}
            return [futures[provider].result() for provider in ordered]

    def active_inventory(
        self, *, include_selected: bool = False
    ) -> tuple[Any, dict[str, Any]] | None:
        matches: list[tuple[Any, dict[str, Any]]] = []
        resizing: list[tuple[Any, dict[str, Any]]] = []
        for api, inventory in self.provider_inventories(include_selected=include_selected):
            matches.extend((api, item) for item in self.managed_from(inventory))
            resizing.extend((api, item) for item in self.resize_from(inventory))
        if resizing:
            raise EnvrError("resize is incomplete; run envr resize with its target RAM")
        if len(matches) > 1:
            raise EnvrError(
                f"conflict: {len(matches)} envr instances exist across configured clouds; "
                "run envr status"
            )
        return matches[0] if matches else None

    def api_token(self, provider: str = "vultr", *, prompt: bool = True) -> str:
        self.ensure_layout()
        path = self.provider_token_path(provider)
        if path.exists():
            path.chmod(0o600)
            token = path.read_text(encoding="utf-8").strip()
            if token:
                return token
        if not prompt:
            raise EnvrError(f"{PROVIDER_LABELS[provider]} is not configured")
        return self.prompt_api_credentials(provider)

    @staticmethod
    def prompt_api_credentials(provider: str, *, replacement: bool = False) -> str:
        prefix = "New " if replacement else ""
        if provider == "exoscale":
            api_key = getpass.getpass(f"{prefix}Exoscale API key: ").strip()
            api_secret = getpass.getpass(f"{prefix}Exoscale API secret: ").strip()
            if not api_key or not api_secret:
                raise EnvrError("Exoscale API key and secret cannot be empty")
            return api_key + "\n" + api_secret
        token = getpass.getpass(
            f"{prefix}{PROVIDER_LABELS[provider]} API token: "
        ).strip()
        if not token:
            raise EnvrError(f"{PROVIDER_LABELS[provider]} API token cannot be empty")
        return token

    def api_from_credentials(
        self, provider: str, credentials: str, relay: RelayConfig | None
    ) -> Any:
        if provider == "exoscale":
            factory = (
                (lambda host: self.ensure_api_host_tunnel(relay, host))
                if relay is not None else None
            )
            return ExoscaleAPI(credentials, opener_factory=factory)
        opener = self.ensure_api_tunnel(relay, provider) if relay is not None else None
        classes = {
            "vultr": VultrAPI,
            "akamai": AkamaiAPI,
            "upcloud": UpCloudAPI,
            "digitalocean": DigitalOceanAPI,
            "gcore": GcoreAPI,
        }
        return classes[provider](credentials, opener=opener)

    def api(
        self,
        provider: str | None = None,
        *,
        prompt: bool = True,
        fresh: bool = False,
    ) -> Any:
        provider = provider or self.selected_provider()
        if provider not in PROVIDER_NAMES:
            raise EnvrError(f"unknown cloud provider: {provider}")
        if not fresh and provider in self._apis:
            return self._apis[provider]
        path = self.provider_token_path(provider)
        saved = path.exists() and bool(
            path.read_text(encoding="utf-8").strip()
        )
        token = self.api_token(provider, prompt=prompt)
        relay = self.relay_config()
        api = self.api_from_credentials(provider, token, relay)
        if not saved:
            print(f"Verifying {api.display_name} API credentials...")
            api.get("account")
            atomic_write_text(path, token + "\n")
            print(f"{api.display_name} API credentials verified and saved to {path}")
        if not fresh:
            self._apis[provider] = api
        return api

    def cloud_menu(self) -> None:
        """Configure one provider and choose where the next VPS is created."""
        self.ensure_layout()
        while True:
            selected = self.selected_provider()
            configured = set(self.configured_providers())
            print("\nCloud")
            for index, provider in enumerate(PROVIDER_NAMES, 1):
                marker = "*" if provider == selected else " "
                state = "ready" if provider in configured else "not configured"
                print(f"  {index}. {marker} {PROVIDER_LABELS[provider]:<13} {state}")
            print("\nThe * provider is used by envr up. Resize asks each time.")
            choice = input(
                f"Select 1-{len(PROVIDER_NAMES)}, [R] replace credentials, "
                "[D] forget selected, [Q] quit: "
            ).strip().lower()
            if choice in {"", "q"}:
                return
            if choice == "r":
                provider = selected
                path = self.provider_token_path(provider)
                token = self.prompt_api_credentials(provider, replacement=True)
                relay = self.relay_config()
                candidate = self.api_from_credentials(provider, token, relay)
                candidate.get("account")
                atomic_write_text(path, token + "\n")
                print(f"{candidate.display_name} credentials replaced.")
                return
            if choice == "d":
                state = self.state()
                if (
                    state.get("instance_id")
                    and str(state.get("provider") or "vultr") == selected
                ):
                    raise EnvrError(
                        "cannot forget the provider that owns the cached running VPS"
                    )
                if selected not in configured:
                    print(f"{PROVIDER_LABELS[selected]} is not configured.")
                    return
                if not prompt_yes_no(f"Forget the local {PROVIDER_LABELS[selected]} credentials?"):
                    print("Cancelled.")
                    continue
                path = self.provider_token_path(selected)
                path.unlink()
                remaining = [item for item in PROVIDER_NAMES if item in configured and item != selected]
                replacement = remaining[0] if remaining else "vultr"
                atomic_write_json(
                    self.cloud_path,
                    {"schema": SCHEMA_VERSION, "selected": replacement},
                )
                print(f"{PROVIDER_LABELS[selected]} credentials forgotten on this device.")
                return
            if not choice.isdigit() or not 1 <= int(choice) <= len(PROVIDER_NAMES):
                numbers = ", ".join(
                    str(index) for index in range(1, len(PROVIDER_NAMES) + 1)
                )
                print(f"Choose {numbers}, R, D, or Q.")
                continue
            provider = PROVIDER_NAMES[int(choice) - 1]
            if provider not in configured:
                self.api(provider)
            atomic_write_json(
                self.cloud_path,
                {"schema": SCHEMA_VERSION, "selected": provider},
            )
            print(f"{PROVIDER_LABELS[provider]} selected.")
            return

    def configure_git(self) -> None:
        ensure_commands(("ssh-keygen",))
        self.ensure_layout()

        parsed = parse_repository_url(input("Repository SSH URL: ").strip())
        repositories = self.repositories()
        records = repositories["repositories"]
        existing_folder = next(
            (
                folder
                for folder, record in records.items()
                if isinstance(record, dict) and record.get("url") == parsed["url"]
            ),
            None,
        )
        if existing_folder is not None:
            existing = records[existing_folder]
            public_path = Path(existing["public_key"])
            print(f"Repository is already configured as: {existing_folder}")
            if public_path.exists():
                print("\nPUBLIC key:\n")
                print(public_path.read_text(encoding="utf-8").strip())
                print()
            if not prompt_yes_no("Replace its key or Git identity?"):
                return

        collision = records.get(parsed["folder"])
        if collision and collision.get("url") != parsed["url"]:
            raise EnvrError(
                f"folder {parsed['folder']!r} is already used by {collision.get('url')}"
            )

        key_directory = self.git_root / parsed["folder"]
        private_key = key_directory / "id_ed25519"
        public_key = key_directory / "id_ed25519.pub"

        with tempfile.TemporaryDirectory(dir=self.root) as temporary_directory:
            candidate_private = Path(temporary_directory) / "id_ed25519"
            candidate_public = candidate_private.with_suffix(".pub")
            supplied = input(
                "SSH private key path (leave empty to generate one): "
            ).strip()
            if supplied:
                source = Path(supplied).expanduser().resolve()
                if not source.is_file():
                    raise EnvrError(f"SSH private key does not exist: {source}")
                result = run(
                    ["ssh-keygen", "-y", "-P", "", "-f", str(source)],
                    capture=True,
                    check=False,
                )
                if result.returncode != 0 or not result.stdout.strip():
                    raise EnvrError(
                        "SSH private key is invalid or passphrase-protected; "
                        "use a dedicated unencrypted key"
                    )
                atomic_write(candidate_private, source.read_bytes())
                atomic_write_text(
                    candidate_public, result.stdout.strip() + "\n", 0o600
                )
            else:
                run(
                    [
                        "ssh-keygen",
                        "-q",
                        "-t",
                        "ed25519",
                        "-N",
                        "",
                        "-C",
                        f"envr:{parsed['path']}",
                        "-f",
                        str(candidate_private),
                    ]
                )

            author_name = validate_text_field(
                "Git author name", input("Git author name: ")
            )
            author_email = validate_text_field(
                "Git author email", input("Git author email: ")
            )

            print("\nAdd this PUBLIC key to the Git repository or account:\n")
            print(candidate_public.read_text(encoding="utf-8").strip())
            print("\nThe private key is never printed.")
            input("Press Enter after adding the key: ")

            ensure_private_dir(key_directory)
            atomic_write(private_key, candidate_private.read_bytes())
            atomic_write(public_key, candidate_public.read_bytes())

        records[parsed["folder"]] = {
            "url": parsed["url"],
            "folder": parsed["folder"],
            "identity": parsed["identity"],
            "host": parsed["host"],
            "private_key": str(private_key),
            "public_key": str(public_key),
            "author_name": author_name,
            "author_email": author_email,
        }
        self.save_repositories(repositories)
        print(f"\nSaved repository as: {parsed['folder']}")
        print(f"Run: envr go {parsed['folder']}")

    def repository(self, folder: str) -> dict[str, Any]:
        if not FOLDER_RE.fullmatch(folder):
            raise EnvrError(f"invalid repository folder: {folder!r}")
        record = self.repositories()["repositories"].get(folder)
        if not isinstance(record, dict):
            raise EnvrError(f'Repository "{folder}" is not configured. Run: envr git')
        required = {
            "url",
            "folder",
            "identity",
            "host",
            "private_key",
            "author_name",
            "author_email",
        }
        if not required.issubset(record):
            raise EnvrError(f"repository configuration for {folder!r} is incomplete")
        private_key = Path(record["private_key"])
        if not private_key.is_file():
            raise EnvrError(f"repository key is missing: {private_key}")
        private_key.chmod(0o600)
        return record

    def ensure_vps_key(self) -> str:
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        self.ensure_layout()
        if not self.vps_key.exists() or not self.vps_public_key.exists():
            with tempfile.TemporaryDirectory(dir=self.root) as temporary_directory:
                temporary_key = Path(temporary_directory) / "id_ed25519"
                run(
                    [
                        "ssh-keygen",
                        "-q",
                        "-t",
                        "ed25519",
                        "-N",
                        "",
                        "-C",
                        f"envr-device:{platform.node() or 'device'}",
                        "-f",
                        str(temporary_key),
                    ]
                )
                atomic_write(self.vps_key, temporary_key.read_bytes())
                atomic_write(
                    self.vps_public_key, temporary_key.with_suffix(".pub").read_bytes()
                )
        self.vps_key.chmod(0o600)
        self.vps_public_key.chmod(0o600)
        return self.vps_public_key.read_text(encoding="utf-8").strip()

    def ensure_vultr_ssh_key(self, api: VultrAPI, public_key: str) -> str:
        response = api.get("ssh-keys", query={"per_page": 500})
        keys = response.get("ssh_keys")
        if not isinstance(keys, list):
            raise EnvrError(
                f"{self.provider_label(api)} API returned an invalid SSH-key list"
            )
        provider = self.provider_name(api)
        managed = [
            dict(key)
            for key in keys
            if isinstance(key, dict)
            and str(key.get("name", "")).startswith(("envr-", DEVICE_KEY_PREFIX))
            and key.get("id")
            and key.get("ssh_key")
        ]
        self._managed_ssh_keys[provider] = sorted(
            managed, key=lambda key: str(key.get("id"))
        )
        normalized = public_key.strip()
        for key in keys:
            if isinstance(key, dict) and str(key.get("ssh_key", "")).strip() == normalized:
                return str(key["id"])
        created = api.post(
            "ssh-keys",
            {
                "name": DEVICE_KEY_PREFIX
                + hashlib.sha256(normalized.encode()).hexdigest()[:12],
                "ssh_key": normalized,
            },
        ).get("ssh_key")
        if not isinstance(created, dict) or not created.get("id"):
            raise EnvrError(
                f"{self.provider_label(api)} API did not return the uploaded SSH-key ID"
            )
        cached = dict(created)
        cached.setdefault("name", DEVICE_KEY_PREFIX + "current")
        cached.setdefault("ssh_key", normalized)
        self._managed_ssh_keys[provider].append(cached)
        self._managed_ssh_keys[provider].sort(key=lambda key: str(key.get("id")))
        return str(created["id"])

    def managed_vultr_ssh_keys(
        self, api: VultrAPI, *, timeout: int = 30
    ) -> list[dict[str, Any]]:
        provider = self.provider_name(api)
        if provider in self._managed_ssh_keys:
            return [dict(key) for key in self._managed_ssh_keys[provider]]
        response = api.get("ssh-keys", query={"per_page": 500}, timeout=timeout)
        keys = response.get("ssh_keys")
        if not isinstance(keys, list):
            raise EnvrError(
                f"{self.provider_label(api)} API returned an invalid SSH-key list"
            )
        managed = [
            key
            for key in keys
            if isinstance(key, dict)
            and str(key.get("name", "")).startswith(("envr-", DEVICE_KEY_PREFIX))
            and key.get("id")
            and key.get("ssh_key")
        ]
        managed = sorted(managed, key=lambda key: str(key.get("id")))
        self._managed_ssh_keys[provider] = [dict(key) for key in managed]
        return managed

    def all_instances(self, api: Any) -> list[dict[str, Any]]:
        response = api.get("instances", query={"per_page": 500})
        instances = response.get("instances")
        if not isinstance(instances, list):
            raise EnvrError(
                f"{self.provider_label(api)} API returned an invalid instance list"
            )
        values = [instance for instance in instances if isinstance(instance, dict)]
        for instance in values:
            instance.setdefault("provider", getattr(api, "provider_name", "vultr"))
        return values

    def managed_instances(self, api: VultrAPI) -> list[dict[str, Any]]:
        return self.managed_from(self.all_instances(api))

    def managed_from(
        self, instances: Sequence[dict[str, Any]]
    ) -> list[dict[str, Any]]:
        tag = self.management_tag()
        managed = [
            instance
            for instance in instances
            if any(
                str(instance_tag) == tag
                or str(instance_tag).startswith(tag + "-")
                for instance_tag in (instance.get("tags") or [])
            )
            and instance.get("label") == LABEL
        ]
        return sorted(managed, key=lambda item: str(item.get("date_created", "")))

    def resize_instances(self, api: VultrAPI) -> list[dict[str, Any]]:
        return self.resize_from(self.all_instances(api))

    def resize_from(
        self, instances: Sequence[dict[str, Any]]
    ) -> list[dict[str, Any]]:
        labels = {RESIZE_TARGET_LABEL, RESIZE_SOURCE_LABEL}
        tag = self.management_tag()
        return sorted(
            [
                instance
                for instance in instances
                if instance.get("label") in labels
                and any(
                    str(value) == tag or str(value).startswith(tag + "-")
                    for value in (instance.get("tags") or [])
                )
            ],
            key=lambda item: str(item.get("date_created", "")),
        )

    def resolve_single_instance(
        self, api: VultrAPI, *, allow_none: bool = True
    ) -> dict[str, Any] | None:
        instances = self.managed_instances(api)
        if len(instances) > 1:
            raise EnvrError(
                f"conflict: {len(instances)} envr-managed instances exist; "
                "run envr status, then envr destroy"
            )
        if not instances:
            if allow_none:
                return None
            raise EnvrError("envr-codex is not running")
        instance = instances[0]
        self.save_instance_state(instance)
        return instance

    def plan_catalog(self, api: Any) -> dict[str, dict[str, Any]]:
        provider = self.provider_name(api)
        if provider in self._plan_catalogs:
            return self._plan_catalogs[provider]
        response = api.get("plans", query={"per_page": 500})
        plans = response.get("plans")
        if not isinstance(plans, list):
            raise EnvrError(
                f"{self.provider_label(api)} API returned an invalid plan catalog"
            )
        catalog = {
            str(plan["id"]): plan
            for plan in plans
            if isinstance(plan, dict) and plan.get("id")
        }
        self._plan_catalogs[provider] = catalog
        return catalog

    def ubuntu_os_id(self, api: Any) -> str | int:
        provider = self.provider_name(api)
        if provider in self._ubuntu_os_ids:
            return self._ubuntu_os_ids[provider]
        response = api.get("os", query={"per_page": 500})
        systems = response.get("os")
        if not isinstance(systems, list):
            raise EnvrError(
                f"{self.provider_label(api)} API returned an invalid OS catalog"
            )
        exact = [
            system
            for system in systems
            if isinstance(system, dict)
            and system.get("name") == "Ubuntu 24.04 LTS x64"
            and system.get("family") == "ubuntu"
            and system.get("arch") == "x64"
        ]
        if len(exact) != 1:
            raise EnvrError("Ubuntu 24.04 LTS x64 is not uniquely available")
        identifier = exact[0].get("id")
        if identifier in (None, ""):
            raise EnvrError("Ubuntu 24.04 image has no provider ID")
        self._ubuntu_os_ids[provider] = identifier
        return identifier

    def account_response(self, api: Any) -> dict[str, Any]:
        """Return one live account result per provider for this command."""
        provider = self.provider_name(api)
        if provider not in self._account_responses:
            self._account_responses[provider] = api.get("account")
        return self._account_responses[provider]

    def available_regions(
        self, api: VultrAPI, plan_id: str, plan: dict[str, Any]
    ) -> list[str]:
        advertised = plan.get("locations", [])
        configured_regions = getattr(api, "regions", REGIONS)
        preferred = (
            tuple(configured_regions)
            if isinstance(configured_regions, (tuple, list))
            else REGIONS
        )
        candidates = [region for region in preferred if region in advertised]
        available = []
        provider = self.provider_name(api)
        for region in candidates:
            key = (provider, str(region))
            if key not in self._region_availability:
                response = api.get(f"regions/{region}/availability")
                plans = response.get("available_plans")
                if not isinstance(plans, list):
                    raise EnvrError(
                        f"{self.provider_label(api)} returned invalid availability "
                        f"for {region}"
                    )
                self._region_availability[key] = {str(value) for value in plans}
            if plan_id in self._region_availability[key]:
                available.append(region)
        if not available:
            raise EnvrError(
                f"{plan_id} is unavailable in configured regions: "
                + ", ".join(preferred)
            )
        return available

