            )
        else:
            print("  Price:      unavailable")

    def status_multiple(self, providers: Sequence[str]) -> int:
        cached_state = self.state()
        current_provider = str(
            cached_state.get("provider") or self.selected_provider()
        )
        ordered_providers = (
            [current_provider] if current_provider in providers else []
        ) + [provider for provider in providers if provider != current_provider]
        cached_active = bool(cached_state.get("instance_id"))

        def query_provider(provider: str) -> dict[str, Any]:
            label = PROVIDER_LABELS[provider]
            lines = [label]
            try:
                api = self.api(provider, prompt=False)
            except (ApiError, EnvrError) as error:
                lines.append(f"  API: unavailable ({error})")
                return {
                    "provider": provider,
                    "api": None,
                    "lines": lines,
                    "managed": [],
                    "resizing": [],
                    "plans": {},
                    "currency": "USD",
                    "failed": True,
                    "inventory_failed": True,
                }

            prefetch_plans = provider == current_provider and cached_active
            try:
                with concurrent.futures.ThreadPoolExecutor(
                    max_workers=3 if prefetch_plans else 2
                ) as provider_executor:
                    account_future = provider_executor.submit(api.get, "account")
                    inventory_api = self.api(provider, prompt=False, fresh=True)
                    inventory_future = provider_executor.submit(
                        self.all_instances, inventory_api
                    )
                    plans_future = None
                    if prefetch_plans:
                        plans_api = self.api(provider, prompt=False, fresh=True)
                        plans_future = provider_executor.submit(
                            self.plan_catalog, plans_api
                        )
            except (ApiError, EnvrError) as error:
                lines.append(f"  API: unavailable ({error})")
                return {
                    "provider": provider,
                    "api": api,
                    "lines": lines,
                    "managed": [],
                    "resizing": [],
                    "plans": {},
                    "currency": "USD",
                    "failed": True,
                    "inventory_failed": True,
                }

            failed = False
            account: dict[str, Any] | None = None
            currency = "USD"
            credit = 0.0
            try:
                account_response = account_future.result()
                account = account_response.get("account")
                if not isinstance(account, dict):
                    raise EnvrError(f"{label} returned invalid account information")
                balance = float(account.get("balance", 0) or 0)
                pending = float(account.get("pending_charges", 0) or 0)
                currency = str(account.get("currency") or "USD")
                credit = available_prepaid_credit(balance, pending)
                if account.get("billing_available") is False:
                    reason = str(
                        account.get("billing_reason") or "token needs billing:read"
                    )
                    lines.append(f"  Billing: unavailable ({reason})")
                elif account.get("credit_model") == "postpaid":
                    if balance > 0:
                        lines.append(f"  Balance: {balance:.2f} {currency} due")
                    elif balance < 0:
                        lines.append(f"  Balance: {-balance:.2f} {currency} credit")
                    else:
                        lines.append(f"  Balance: 0.00 {currency}")
                    lines.append(f"  Uninvoiced: {pending:.2f} {currency}")
                else:
                    lines.append(f"  Available credit: {credit:.2f} {currency}")
            except (ApiError, EnvrError) as error:
                failed = True
                lines.append(f"  Billing: unavailable ({error})")

            inventory_failed = False
            try:
                inventory = inventory_future.result()
                managed = self.managed_from(inventory)
                resizing = self.resize_from(inventory)
            except (ApiError, EnvrError) as error:
                failed = True
                inventory_failed = True
                managed = []
                resizing = []
                lines.append(f"  Inventory: unavailable ({error})")

            plans: dict[str, dict[str, Any]] = {}
            if managed or resizing:
                try:
                    plans = (
                        plans_future.result()
                        if plans_future is not None
                        else self.plan_catalog(api)
                    )
                except (ApiError, EnvrError) as error:
                    failed = True
                    lines.append(f"  Pricing: unavailable ({error})")

            if len(managed) == 1 and not resizing and account is not None:
                active_plan = plans.get(str(managed[0].get("plan")), {})
                active_hourly = float(active_plan.get("hourly_cost", 0) or 0)
                if (
                    account.get("billing_available") is not False
                    and account.get("credit_model") != "postpaid"
                    and active_hourly > 0
                    and credit > 0
                ):
                    lines.append(
                        f"  Credit runway: {format_runway(credit / active_hourly)}"
                    )
            return {
                "provider": provider,
                "api": api,
                "lines": lines,
                "managed": managed,
                "resizing": resizing,
                "plans": plans,
                "currency": currency,
                "failed": failed,
                "inventory_failed": inventory_failed,
            }

        all_managed: list[tuple[Any, dict[str, Any]]] = []
        all_resize: list[tuple[Any, dict[str, Any]]] = []
        failures = 0
        machine_printed = False
        clouds_printed = False

        def render(result: dict[str, Any], *, primary: bool = False) -> None:
            nonlocal failures, machine_printed, clouds_printed
            api = result["api"]
            managed = result["managed"]
            resizing = result["resizing"]
            if result["failed"]:
                failures += 1
            if api is not None:
                all_managed.extend((api, item) for item in managed)
                all_resize.extend((api, item) for item in resizing)
            shown = managed + resizing
            if shown:
                if machine_printed or clouds_printed:
                    print("\nAdditional envr instance")
                for index, instance in enumerate(shown):
                    if index:
                        print()
                    plan = result["plans"].get(str(instance.get("plan")), {})
                    self.print_instance_status(
                        api,
                        instance,
                        plan,
                        result["currency"],
                        show_cloud=True,
                        leading_blank=False,
                    )
                machine_printed = True
            elif primary:
                label = PROVIDER_LABELS[result["provider"]]
                cached_matches = (
                    result["inventory_failed"]
                    and cached_active
                    and str(cached_state.get("provider") or "vultr")
                    == result["provider"]
                    and cached_state.get("main_ip")
                    and cached_state.get("ram_gb")
                )
                if cached_matches:
                    password = "unavailable locally"
                    if self.password_path.is_file():
                        password = self.password_path.read_text(
                            encoding="utf-8"
                        ).strip() or password
                    print("envr-codex")
                    print(f"  Cloud:      {label}")
                    print(f"  ID:         {cached_state.get('instance_id')}")
                    print(f"  Region:     {cached_state.get('region') or ''}")
                    print(f"  RAM:        {cached_state.get('ram_gb')} GB")
                    print(f"  IP:         {cached_state.get('main_ip')}")
                    print(f"  SSH user:   {REMOTE_USER} (key)")
                    print("  Root user:  root")
                    print(f"  Password:   {password}")
                    print("  Status:     cached; live inventory unavailable")
                    print("  Power:      unknown")
                    print("  Price:      unavailable")
                    machine_printed = True
                elif result["inventory_failed"]:
                    print(f"envr-codex: unknown; {label} inventory unavailable")
                else:
                    print(f"envr-codex: not running on {label}")

            if not clouds_printed:
                print("\nClouds")
                clouds_printed = True
            else:
                print()
            print("\n".join(result["lines"]))
            sys.stdout.flush()

        with concurrent.futures.ThreadPoolExecutor(
            max_workers=len(ordered_providers)
        ) as executor:
            futures = {
                provider: executor.submit(query_provider, provider)
                for provider in ordered_providers
            }
            primary = ordered_providers[0]
            render(futures[primary].result(), primary=True)
            remaining = {
                future: provider
                for provider, future in futures.items()
                if provider != primary
            }
            for future in concurrent.futures.as_completed(remaining):
                render(future.result())

        if len(all_managed) == 1 and not all_resize:
            self.save_instance_state(all_managed[0][1])
        if len(all_managed) > 1:
            print(f"CONFLICT: {len(all_managed)} envr instances exist across clouds")
            return 2
        if all_resize:
            print("Resize is incomplete. Resume with: envr resize")
            return 2
        return 1 if failures else 0

    def status(self) -> int:
        providers = self.configured_providers()
        if providers:
            return self.status_multiple(providers)
        try:
            api = self.api(providers[0] if providers else None)
            account_response = api.get("account")
            inventory = self.all_instances(api)
            plans = self.plan_catalog(api)
        except ApiError as error:
            return self.status_api_unavailable(error)
        account = account_response.get("account")
        if not isinstance(account, dict):
            raise EnvrError(
                f"{self.provider_label(api)} API returned invalid account information"
            )
        instances = self.managed_from(inventory)
        resizing = self.resize_from(inventory)
        if len(instances) == 1 and not resizing:
            self.save_instance_state(instances[0])

        balance = float(account.get("balance", 0))
        pending = float(account.get("pending_charges", 0))
        credit = available_prepaid_credit(balance, pending)
        if balance < 0:
            balance_text = f"${-balance:.2f} credit"
        elif balance > 0:
            balance_text = f"${balance:.2f} due"
        else:
            balance_text = "$0.00"
        currency = str(account.get("currency") or "USD")
        credit_model = str(account.get("credit_model") or "prepaid")
        symbol = "$" if currency == "USD" else f"{currency} "
        cloud_lines = [self.provider_label(api)]
        if symbol != "$":
            balance_text = (
                f"{symbol}{-balance:.2f} credit" if balance < 0
                else f"{symbol}{balance:.2f} due"
            )
        if account.get("billing_available") is False:
            reason = str(account.get("billing_reason") or "token needs billing:read")
            cloud_lines.append(f"  Billing:          unavailable ({reason})")
        else:
            cloud_lines.append(f"  Balance:          {balance_text}")
            if credit_model == "postpaid":
                cloud_lines.append(f"  Uninvoiced:       {symbol}{pending:.2f}")
            else:
                cloud_lines.append(f"  Pending charges:  {symbol}{pending:.2f}")
                cloud_lines.append(f"  Available credit: {symbol}{credit:.2f}")

        if len(instances) == 1:
            plan = plans.get(str(instances[0].get("plan")), {})
            hourly = float(plan.get("hourly_cost", 0) or 0)
            if (
                account.get("billing_available") is not False
                and credit_model != "postpaid"
                and hourly > 0
                and credit > 0
            ):
                cloud_lines.append(
                    f"  Credit runway:    {format_runway(credit / hourly)} at "
                    f"{symbol}{hourly:.3f}/hour"
                )
            else:
                cloud_lines.append("  Credit runway:    n/a")
        else:
            cloud_lines.append("  Credit runway:    n/a")

        if not instances:
            print("envr-codex: not running")
        else:
            conflict = len(instances) > 1
            if conflict:
                print(f"CONFLICT: {len(instances)} envr-managed instances are running\n")
            for index, instance in enumerate(instances):
                if index:
                    print()
                plan = plans.get(str(instance.get("plan")), {})
                self.print_instance_status(
                    api, instance, plan, currency, leading_blank=False
                )

        if resizing:
            print("\nResize: incomplete")
            for instance in resizing:
                role = (
                    "source"
                    if instance.get("label") == RESIZE_SOURCE_LABEL
                    else "target"
                )
                print(
                    f"  {role.capitalize()}: {self.instance_ram_gb(instance)} GB · "
                    f"{instance.get('main_ip', '')} · {instance.get('status', '')}"
                )
            print("  Resume with: envr resize")

        print("\nClouds")
        print("\n".join(cloud_lines))
        conflict = len(instances) > 1
        return 2 if conflict or resizing else 0

    def port_open(self, port: int) -> None:
        if not 1 <= port <= 65535:
            raise EnvrError("port must be an integer from 1 through 65535")
        ensure_commands(("ssh", "ssh-keygen"))
        found = self.active_inventory()
        if found is None:
            raise EnvrError(
                "envr-codex is not running. Start it with "
                "envr up RAM."
            )
        api, instance = found
        self.ensure_device_access(api, instance)
        script = r"""set -euo pipefail
port=$1
sudo ufw allow "$port/tcp"
sudo ufw allow "$port/udp"
sudo ufw status | grep -Eq "^${port}/tcp[[:space:]]+ALLOW"
sudo ufw status | grep -Eq "^${port}/udp[[:space:]]+ALLOW"
"""
        self.remote_script(instance, script, (str(port),), timeout=60)
        open_provider_port = getattr(api, "open_port", None)
        if callable(open_provider_port):
            open_provider_port(instance, port)
        print(f"Opened port {port} (TCP and UDP) on envr-codex.")

    def git_safety(self, instance: dict[str, Any]) -> list[tuple[str, str]]:
        script = r"""set -u
root=/home/remote/envr
found=0
for directory in "$root"/*; do
    [ -d "$directory" ] || continue
    if ! git -C "$directory" rev-parse --git-dir >/dev/null 2>&1; then
        continue
    fi
    found=1
    folder=${directory##*/}
    if [ -n "$(git -C "$directory" status --porcelain 2>/dev/null)" ]; then
        printf '%s\t%s\n' "$folder" "UNCOMMITTED"
        continue
    fi
    if ! git -C "$directory" symbolic-ref -q HEAD >/dev/null 2>&1; then
        printf '%s\t%s\n' "$folder" "DETACHED HEAD"
        continue
    fi
    branches=$(git -C "$directory" for-each-ref \
        --format='%(refname:short)|%(upstream:short)' refs/heads) || {
            printf '%s\t%s\n' "$folder" "CHECK FAILED"
            continue
        }
    missing_upstream=""
    total_ahead=0
    check_failed=0
    while IFS='|' read -r branch upstream; do
        [ -n "$branch" ] || continue
        if [ -z "$upstream" ]; then
            missing_upstream=$branch
            break
        fi
        ahead=$(git -C "$directory" rev-list --count "$upstream..$branch" 2>/dev/null) || {
            check_failed=1
            break
        }
        total_ahead=$((total_ahead + ahead))
    done <<EOF
$branches
EOF
    if [ -n "$missing_upstream" ]; then
        printf '%s\t%s\n' "$folder" "NO UPSTREAM ($missing_upstream)"
    elif [ "$check_failed" -ne 0 ]; then
        printf '%s\t%s\n' "$folder" "CHECK FAILED"
    elif [ "$total_ahead" -gt 0 ]; then
        printf '%s\t%s\n' "$folder" "$total_ahead UNPUSHED COMMITS"
    else
        printf '%s\t%s\n' "$folder" "clean and pushed"
    fi
done
if [ "$found" -eq 0 ]; then
    printf '%s\t%s\n' "(none)" "no repositories"
fi
"""
        result = self.remote_script(
            instance, script, capture=True, timeout=60, check=False
        )
        if result.returncode != 0:
            return [("(check)", "CHECK FAILED")]
        rows = []
        for line in result.stdout.splitlines():
            if "\t" in line:
                folder, status = line.split("\t", 1)
                rows.append((folder, status))
        return rows or [("(check)", "CHECK FAILED")]

    def delete_instance(self, api: VultrAPI, instance: dict[str, Any]) -> None:
        instance_id = str(instance.get("id", ""))
        if not instance_id:
            raise EnvrError("cannot delete instance without an ID")
        api.delete(f"instances/{instance_id}")
        deadline = time.monotonic() + DELETE_TIMEOUT
        while time.monotonic() < deadline:
            deleted = False
            try:
                response = api.get(f"instances/{instance_id}")
                current = response.get("instance")
                if isinstance(current, dict) and not current.get("id"):
                    deleted = True
            except ApiError as error:
                if error.status != 404:
                    raise
                deleted = True
            if deleted:
                verifier = getattr(api, "verify_instance_deleted", None)
                if callable(verifier) and not verifier(instance_id):
                    time.sleep(3)
                    continue
                self.remove_known_host(str(instance.get("main_ip", "")))
                return
            time.sleep(3)
        raise EnvrError(
            f"{self.provider_label(api)} did not confirm deletion of {instance_id}"
        )

    def remove_known_host(self, ip: str) -> None:
        if not ip or not self.vps_known_hosts.exists():
            return
        ensure_commands(("ssh-keygen",))
        run(
            ["ssh-keygen", "-q", "-R", ip, "-f", str(self.vps_known_hosts)],
            check=False,
            quiet=True,
        )

    def destroy(self) -> None:
        ensure_commands(("ssh", "scp", "ssh-keygen"))
        inventories = self.provider_inventories()
        if any(self.resize_from(inventory) for _, inventory in inventories):
            raise EnvrError("resize is incomplete; finish it before destroy")
        owned = [
            (api, instance)
            for api, inventory in inventories
            for instance in self.managed_from(inventory)
        ]
        instances = [instance for _, instance in owned]
        if not instances:
            print("envr-codex: not running")
            self.clear_instance_state()
            return

        state_id = self.state().get("instance_id")
        instances.sort(key=lambda item: item.get("id") == state_id)
        auth_ok = True
        summaries: list[tuple[dict[str, Any], list[tuple[str, str]]]] = []
        for instance in instances:
            api = next(api for api, candidate in owned if candidate is instance)
            try:
                self.ensure_device_access(api, instance)
                if not self.sync_from_server(instance):
                    auth_ok = False
                safety = self.git_safety(instance)
            except (EnvrError, subprocess.TimeoutExpired):
                auth_ok = False
                safety = [("(connection)", "CHECK FAILED")]
            summaries.append((instance, safety))

        print("\nRepository safety:")
        unsafe = False
        for instance, rows in summaries:
            if len(instances) > 1:
                print(
                    f"  Instance {instance.get('id')} ({instance.get('main_ip')}):"
                )
                indent = "    "
            else:
                indent = "  "
            width = max((len(folder) for folder, _ in rows), default=1)
            for folder, status in rows:
                print(f"{indent}{folder:<{width}}  {status}")
                if status not in {"clean and pushed", "no repositories"}:
                    unsafe = True

        if not auth_ok:
            print("\nWarning: the newest Codex authentication could not be preserved.")
        if unsafe:
            print("\nSome work may be permanently lost.")
        else:
            print("\nAll repositories are committed and pushed.")
        if len(instances) > 1:
            print(
                f"Warning: {len(instances)} conflicting envr instances will be destroyed."
            )
        confirmation = "Destroy envr VPS permanently?"
        if not auth_ok or unsafe:
            confirmation = "Destroy permanently despite the warnings above?"
        if not prompt_yes_no(confirmation):
            print("Cancelled.")
            return

        failures = []
        for instance in instances:
            api = next(api for api, candidate in owned if candidate is instance)
            try:
                with contextlib.suppress(EnvrError, subprocess.TimeoutExpired):
                    self.remote_command(
                        instance,
                        "envr-codex-supervisor disarm-all 2>/dev/null || true; "
                        "sudo systemctl stop envr-tmux.service 2>/dev/null || true",
                        check=False,
                        quiet=True,
                        timeout=30,
                    )
                self.delete_instance(api, instance)
                print(f"Deleted {instance.get('id')}.")
            except EnvrError as error:
                failures.append(str(error))
        if failures:
            raise EnvrError("; ".join(failures))
        self.clear_instance_state()
        print("envr-codex destroyed; compute billing has stopped.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="envr", description="Disposable cloud Codex environment"
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser(
        "git", help="configure one Git repository",
        description="Configure a repository and its dedicated SSH identity.",
    )
    subparsers.add_parser(
        "relay", help="configure the optional SSH relay",
        description="Show, configure, edit, or remove the optional SSH relay.",
    )
    subparsers.add_parser(
        "cloud", help="configure and select a cloud provider",
        description="Configure providers and choose the default used by envr up.",
    )

    up = subparsers.add_parser(
        "up", help="create the initial VPS",
        description="Create and prepare the one envr VPS; this command does not connect.",
    )
    up.add_argument(
        "ram", type=int, choices=sorted(PLAN_IDS), metavar="RAM_GB",
        help="memory size: %(choices)s",
    )

    go = subparsers.add_parser(
        "go", help="reconnect without specifying RAM",
        description="Attach to the last workspace, or select one repository.",
    )
    go.add_argument(
        "repository_folder", nargs="?", metavar="REPOSITORY",
        help="configured repository folder; omit for the last workspace",
    )

    resize = subparsers.add_parser(
        "resize", help="move the environment to a fresh VPS size",
        description="Choose a live cloud configuration and safely migrate the environment.",
    )

    subparsers.add_parser("status", help="show account and VPS status")

    port_open = subparsers.add_parser("port-open", help="open one TCP/UDP port")
    port_open.add_argument(
        "port", type=int, metavar="PORT", help="TCP and UDP port (1-65535)"
    )

    subparsers.add_parser("destroy", help="check work and destroy the VPS")
    return parser


def main(arguments: Sequence[str] | None = None) -> int:
    if sys.version_info < (3, 10):
        eprint("envr requires Python 3.10 or newer")
        return 1
    parser = build_parser()
    if arguments is None and sys.argv[1:] == ["help"]:
        arguments = ["--help"]
    elif arguments is not None and list(arguments) == ["help"]:
        arguments = ["--help"]
    namespace = parser.parse_args(arguments)
    app = Envr()
    try:
        attachment: tuple[dict[str, Any], dict[str, Any] | None] | None = None
        with exclusive_lock(app.root):
            if namespace.command == "git":
                app.configure_git()
                return 0
            if namespace.command == "relay":
                app.relay_menu()
                return 0
            if namespace.command == "cloud":
                app.cloud_menu()
                return 0
            if namespace.command == "up":
                attachment = app.up(namespace.ram)
            elif namespace.command == "go":
                attachment = app.go(namespace.repository_folder)
            elif namespace.command == "resize":
                attachment = app.resize_menu()
            elif namespace.command == "status":
                return app.status()
            elif namespace.command == "port-open":
                app.port_open(namespace.port)
                return 0
            elif namespace.command == "destroy":
                app.destroy()
                return 0
        if attachment is not None:
            app.close_api_tunnel()
            app.connect_shell(*attachment)
            return 0
        return 0
    except KeyboardInterrupt:
        eprint("\nenvr: interrupted")
        return 130
    except (EnvrError, subprocess.TimeoutExpired) as error:
        eprint(f"envr: error: {error}")
        return 1
    finally:
        app.close_api_tunnel()


if __name__ == "__main__":
    raise SystemExit(main())
