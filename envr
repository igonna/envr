                raise ValueError
        except ValueError as error:
            raise EnvrError("resize source does not have a valid IPv4 address") from error
        key = f"{REMOTE_CONFIG_ROOT}/.resize-key-{token}"
        known_hosts = key + ".known_hosts"
        source_excludes = f"{REMOTE_CONFIG_ROOT}/.resize-excludes-{token}"
        host_fields = host_key.split()
        known_host_line = f"{source_ip} {host_fields[0]} {host_fields[1]}"
        setup = r"""set -euo pipefail
printf '%s\n' "$1" > "$2"
chmod 600 "$2"
install -d -m 755 /home/remote/envr
install -d -m 700 /home/remote/.codex /home/remote/.ssh/envr /home/remote/.config/envr
"""
        self.remote_script(
            target, setup, (known_host_line, known_hosts), quiet=True, timeout=30
        )
        script = r"""set -euo pipefail
source_ip=$1
key=$2
known_hosts=$3
source_excludes=$4
local_excludes="${key}.excludes"
ssh_command="ssh -i $key -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$known_hosts -o ConnectTimeout=10"
rsync -a --no-owner --no-group -e "$ssh_command" \
    "remote@${source_ip}:${source_excludes}" "$local_excludes"
sync_dir() {
    source=$1
    destination=$2
    excludes=${3:-}
    if test -n "$excludes"; then
        rsync -aH --no-owner --no-group --delete --from0 \
            --exclude-from="$excludes" --rsync-path="sudo -n rsync" \
            -e "$ssh_command" \
            "remote@${source_ip}:${source}/" "${destination}/"
    else
        rsync -aH --no-owner --no-group --delete \
            --rsync-path="sudo -n rsync" -e "$ssh_command" \
            "remote@${source_ip}:${source}/" "${destination}/"
    fi
}
sync_file() {
    source=$1
    destination=$2
    if ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes \
        -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$known_hosts" \
        -o ConnectTimeout=10 "remote@$source_ip" "test -f '$source'"; then
        rsync -a --no-owner --no-group --rsync-path="sudo -n rsync" \
            -e "$ssh_command" \
            "remote@${source_ip}:${source}" "$destination"
    else
        rm -f "$destination"
    fi
}
sync_dir /home/remote/envr /home/remote/envr "$local_excludes"
sync_dir /home/remote/.codex /home/remote/.codex
sync_dir /home/remote/.ssh/envr /home/remote/.ssh/envr
sync_file /home/remote/.ssh/authorized_keys /home/remote/.ssh/authorized_keys
sync_file /home/remote/.config/envr/repos.json /home/remote/.config/envr/repos.json
sync_file /home/remote/.config/envr/last-workspace /home/remote/.config/envr/last-workspace
verify_dir() {
    source=$1
