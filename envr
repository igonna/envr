}
verify_dir /home/remote/envr /home/remote/envr "$local_excludes"
verify_dir /home/remote/.codex /home/remote/.codex
verify_dir /home/remote/.ssh/envr /home/remote/.ssh/envr
verify_file /home/remote/.ssh/authorized_keys /home/remote/.ssh/authorized_keys
verify_file /home/remote/.config/envr/repos.json /home/remote/.config/envr/repos.json
verify_file /home/remote/.config/envr/last-workspace /home/remote/.config/envr/last-workspace
"""
        self.remote_script(
