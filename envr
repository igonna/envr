CODEX_SUPERVISOR_SCRIPT = r'''#!/usr/bin/env python3
"""Exact-session Codex supervision for envr hosts."""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import sqlite3
import subprocess
import sys
import tempfile
import time
import uuid


REMOTE_HOME = Path(os.environ.get("ENVR_REMOTE_HOME", "/home/remote")).resolve()
WORKSPACE_ROOT = (REMOTE_HOME / "envr").resolve()
CODEX_HOME = Path(
    os.environ.get("ENVR_CODEX_HOME", str(REMOTE_HOME / ".codex"))
).resolve()
STATE_ROOT = Path(
    os.environ.get(
        "ENVR_SUPERVISION_ROOT",
        str(REMOTE_HOME / ".config" / "envr" / "supervision"),
    )
).resolve()
TMUX = os.environ.get("ENVR_TMUX", "tmux")
CODEX = os.environ.get("ENVR_CODEX", "codex")
os.environ["NPM_CONFIG_PREFIX"] = str(REMOTE_HOME / ".local")
os.environ["PATH"] = str(REMOTE_HOME / ".local/bin") + os.pathsep + os.environ.get("PATH", "")
PROTOCOL_VERSION = "4"
UUID = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)
SESSION = re.compile(r"^envr-(?:workspace|repo-[A-Za-z0-9._-]+)$")
MAX_FAILURES = 3
FAILURE_WINDOW = 600


def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, name = tempfile.mkstemp(prefix=".state-", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, separators=(",", ":"), sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(name, path)
    finally:
        try:
            os.unlink(name)
        except FileNotFoundError:
            pass


def load_state(path: Path) -> dict | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    return value if isinstance(value, dict) and value.get("schema") == 1 else None


def boot_id() -> str:
    override = os.environ.get("ENVR_TEST_BOOT_ID")
    if override:
        return override
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return "unknown"


def memory_events_path() -> Path | None:
    override = os.environ.get("ENVR_MEMORY_EVENTS")
    if override:
        return Path(override)
    try:
        for line in Path("/proc/self/cgroup").read_text().splitlines():
            fields = line.split(":", 2)
            if len(fields) == 3 and fields[0] == "0":
                return Path("/sys/fs/cgroup") / fields[2].lstrip("/") / "memory.events"
    except OSError:
        pass
    return None


def oom_kills() -> int:
    path = memory_events_path()
    if path is None:
        return 0
    try:
        for line in path.read_text().splitlines():
            name, value = line.split(None, 1)
            if name == "oom_kill":
                return int(value)
    except (OSError, ValueError):
        pass
    return 0


def memory_ready() -> bool:
    try:
        values = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            name, value = line.split(":", 1)
            values[name] = int(value.strip().split()[0]) * 1024
        total = values.get("MemTotal", 0)
        available = values.get("MemAvailable", 0)
        required = max(512 * 1024**2, min(2 * 1024**3, total // 8))
        return available >= required
    except (OSError, ValueError, IndexError):
        return True


def run_tmux(*arguments: str, capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        [TMUX, *arguments],
        text=True,
        capture_output=capture,
        check=False,
    )


def tmux_value(format_string: str, target: str | None = None) -> str:
    arguments = ["display-message", "-p"]
    if target:
        arguments.extend(["-t", target])
    arguments.append(format_string)
    result = run_tmux(*arguments, capture=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def pane_identity() -> tuple[str, str, str, str]:
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        raise RuntimeError("scodex must run inside the tmux opened by envr go")
    session = tmux_value("#{session_name}", pane)
    window = tmux_value("#{window_index}", pane)
    if not SESSION.fullmatch(session):
        raise RuntimeError("scodex is not running in an envr workspace session")
    result = run_tmux("show-options", "-p", "-t", pane, "-v", "@envr-codex-slot", capture=True)
    slot = result.stdout.strip() if result.returncode == 0 else ""
    if not UUID.fullmatch(slot):
        slot = str(uuid.uuid4())
        result = run_tmux("set-option", "-p", "-t", pane, "@envr-codex-slot", slot)
        if result.returncode != 0:
            raise RuntimeError("could not bind the Codex supervisor to this tmux pane")
    return slot, session, window, pane


def state_path(slot: str) -> Path:
    if not UUID.fullmatch(slot):
        raise RuntimeError("invalid Codex supervision slot")
    return STATE_ROOT / f"{slot}.json"


def lock_path(slot: str) -> Path:
    return STATE_ROOT / f"{slot}.lock"


def lock_slot(slot: str, *, blocking: bool) -> object | None:
    STATE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = lock_path(slot).open("a+")
    flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
    try:
        fcntl.flock(handle.fileno(), flags)
    except BlockingIOError:
        handle.close()
        return None
    return handle


def sqlite_candidates(cwd: str) -> list[dict]:
    databases = []
    for path in CODEX_HOME.glob("state_*.sqlite"):
        try:
            databases.append((path.stat().st_mtime, path))
        except OSError:
            continue
    databases = [path for _, path in sorted(databases, reverse=True)]
    for database in databases:
        try:
            connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
            columns = {
                row[1] for row in connection.execute("PRAGMA table_info(threads)")
            }
            if not {"id", "cwd"}.issubset(columns):
                connection.close()
                continue
            title = "title" if "title" in columns else "''"
            archived = "archived = 0 AND" if "archived" in columns else ""
            interactive = "source IN ('cli', 'vscode') AND" if "source" in columns else ""
            updated = (
                "updated_at_ms" if "updated_at_ms" in columns
                else "updated_at" if "updated_at" in columns else "0"
            )
            rows = connection.execute(
                f"SELECT id, {title}, {updated} FROM threads "
                f"WHERE {archived} {interactive} cwd = ? ORDER BY {updated} DESC, id DESC",
                (cwd,),
            ).fetchall()
            connection.close()
            return [
                {"id": str(row[0]), "title": str(row[1] or "Untitled"), "updated": int(row[2] or 0)}
                for row in rows if UUID.fullmatch(str(row[0]))
            ]
        except (OSError, sqlite3.Error, ValueError):
            continue
    return []


def rollout_candidates(cwd: str) -> list[dict]:
    result = []
    for path in CODEX_HOME.glob("sessions/**/*.jsonl"):
        try:
            with path.open(encoding="utf-8") as handle:
                value = json.loads(handle.readline())
            payload = value.get("payload", {})
            source = payload.get("source", "cli")
            if not isinstance(source, str) or source not in {"cli", "vscode"}:
                continue
            identifier = str(payload.get("id") or payload.get("session_id") or "")
            if UUID.fullmatch(identifier) and os.path.realpath(str(payload.get("cwd") or "")) == cwd:
                result.append({"id": identifier, "title": "Codex session", "updated": path.stat().st_mtime_ns})
        except (OSError, UnicodeError, json.JSONDecodeError, AttributeError):
            continue
    return sorted(result, key=lambda item: (item["updated"], item["id"]), reverse=True)


def active_thread_ids(except_slot: str) -> set[str]:
    identifiers = set()
    for path in STATE_ROOT.glob("*.json"):
        value = load_state(path)
        if not value or value.get("slot") == except_slot:
            continue
        if value.get("desired") == "running" and UUID.fullmatch(str(value.get("thread_id") or "")):
            identifiers.add(str(value["thread_id"]))
    return identifiers


def choose_thread(slot: str, cwd: str, previous: dict | None, arguments: list[str]) -> str:
    choose = arguments == ["--choose"]
    explicit = arguments[0] if len(arguments) == 1 and UUID.fullmatch(arguments[0]) else None
    if arguments and not choose and explicit is None:
        raise RuntimeError("usage: scodex resume [--choose|SESSION_UUID]")
    if explicit:
        if explicit in active_thread_ids(slot):
            raise RuntimeError("that Codex session is already supervised in another pane")
        candidates = sqlite_candidates(cwd) or rollout_candidates(cwd)
        if explicit not in {str(item["id"]) for item in candidates}:
            raise RuntimeError("that Codex session does not belong to this repository")
        return explicit
    bound = str((previous or {}).get("thread_id") or "")
    if not choose and UUID.fullmatch(bound) and (previous or {}).get("cwd") == cwd:
        if bound in active_thread_ids(slot):
            raise RuntimeError("that Codex session is already supervised in another pane")
        return bound
    candidates = sqlite_candidates(cwd) or rollout_candidates(cwd)
    used = active_thread_ids(slot)
    candidates = [item for item in candidates if item["id"] not in used]
    if not candidates:
        raise RuntimeError("no unbound Codex session exists for this repository")
    if not choose or len(candidates) == 1:
        selected = candidates[0]
        print(f"Resuming {selected['id']}")
        return str(selected["id"])
    candidates = candidates[:10]
    print("Codex sessions in this repository:")
    for index, item in enumerate(candidates, 1):
        title = "".join(
            character if character.isprintable() else " "
            for character in str(item["title"])
        ).strip()[:80]
        print(f"  {index}. {title or 'Untitled'} · {item['id']}")
    while True:
        answer = input(f"Choose 1-{len(candidates)}, or Q to cancel: ").strip().lower()
        if answer == "q" or answer == "":
            raise RuntimeError("cancelled")
        if answer.isdigit() and 1 <= int(answer) <= len(candidates):
            return str(candidates[int(answer) - 1]["id"])
        print(f"Choose 1-{len(candidates)}, or Q.")


def save(state: dict) -> None:
    state["schema"] = 1
    state["updated_at"] = int(time.time())
    atomic_json(state_path(str(state["slot"])), state)


def run_bound(state: dict) -> int:
    # Lock the conversation too: two different panes can select it concurrently.
    thread_lock = (STATE_ROOT / f"thread-{state['thread_id']}.lock").open("a+")
    try:
        fcntl.flock(thread_lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        thread_lock.close()
        state.update({"desired": "stopped", "status": "failed",
                      "reason": "conversation already running"})
        save(state)
        raise RuntimeError("that Codex conversation is already running")
    try:
        return run_child(state)
    except KeyboardInterrupt:
        state.update({"desired": "stopped", "status": "stopped", "last_exit": 130})
        save(state)
        return 130
    finally:
        thread_lock.close()


def run_child(state: dict) -> int:
    while True:
        baseline = oom_kills()
        state.update({
            "desired": "running",
            "status": "running",
            "boot_id": boot_id(),
            "oom_baseline": baseline,
            "pane": os.environ.get("TMUX_PANE", state.get("pane", "")),
        })
        save(state)
        command = [
            CODEX,
            "resume",
            "--dangerously-bypass-approvals-and-sandbox",
            "-C",
            str(state["cwd"]),
            str(state["thread_id"]),
        ]
        try:
            child = subprocess.Popen(command)
            while True:
                try:
                    returncode = child.wait()
                    break
                except KeyboardInterrupt:
                    # The foreground child receives Ctrl-C as well. Let Codex
                    # handle it; never abandon a still-running child process.
                    continue
        except OSError as error:
            state.update({
                "desired": "stopped",
                "status": "failed",
                "reason": f"could not start Codex: {error}",
            })
            save(state)
            print(f"scodex: could not start Codex: {error}", file=sys.stderr)
            return 1
        current_oom = oom_kills()
        oom_exit = returncode in {-9, 137} and current_oom > baseline
        if not oom_exit:
            state.update({"desired": "stopped", "status": "stopped", "last_exit": returncode})
            save(state)
            return returncode if 0 <= returncode <= 255 else 1
        now = int(time.time())
        failures = [
            int(value) for value in state.get("failures", [])
            if now - int(value) <= FAILURE_WINDOW
        ]
        failures.append(now)
        state["failures"] = failures
        state["oom_baseline"] = current_oom
        if len(failures) > MAX_FAILURES:
            state.update({"desired": "stopped", "status": "failed", "reason": "repeated OOM"})
            save(state)
            print("scodex: recovery stopped after repeated OOM failures", file=sys.stderr)
            return 137
        state["status"] = "waiting-memory"
        save(state)
        print("scodex: Codex was killed by OOM; waiting to resume the exact session", file=sys.stderr)
        deadline = time.monotonic() + 120
        while not memory_ready() and time.monotonic() < deadline:
            time.sleep(5)
        if not memory_ready():
            state.update({"desired": "stopped", "status": "failed", "reason": "memory did not recover"})
            save(state)
            return 137


def resume(arguments: list[str]) -> int:
    slot, session, window, pane = pane_identity()
    handle = lock_slot(slot, blocking=False)
    if handle is None:
        raise RuntimeError("this tmux pane already has a supervised Codex process")
    try:
        path = state_path(slot)
        previous = load_state(path)
        cwd = os.path.realpath(os.getcwd())
        if not (cwd == str(WORKSPACE_ROOT) or cwd.startswith(str(WORKSPACE_ROOT) + os.sep)):
            raise RuntimeError("scodex must run inside /home/remote/envr")
        thread_id = choose_thread(slot, cwd, previous, arguments)
        state = {
            "schema": 1,
            "slot": slot,
            "thread_id": thread_id,
            "cwd": cwd,
            "tmux_session": session,
            "tmux_window": window,
            "pane": pane,
            "failures": [],
        }
        # Publish intent under the cutover lock, so resize cannot pass its
        # last check while a supervised conversation is being started.
        with (STATE_ROOT.parent / "tmux.lock").open("a+") as gate:
            fcntl.flock(gate.fileno(), fcntl.LOCK_EX)
            if (STATE_ROOT.parent / "resize-in-progress").exists():
                raise RuntimeError("resize is in progress; reconnect after it finishes")
            state.update({"desired": "running", "status": "starting",
                          "boot_id": boot_id(), "oom_baseline": oom_kills()})
            save(state)
        return run_bound(state)
    finally:
        handle.close()


def recover(slot: str) -> int:
    handle = lock_slot(slot, blocking=False)
    if handle is None:
        return 0
    try:
        state = load_state(state_path(slot))
        if not state or state.get("desired") != "running":
            return 0
        state["pane"] = os.environ.get("TMUX_PANE", state.get("pane", ""))
        run_tmux("set-option", "-p", "-t", state["pane"], "@envr-codex-slot", slot)
        state["boot_id"] = boot_id()
        return run_bound(state)
    finally:
        handle.close()


def recovery_command(slot: str) -> str:
    command = shlex.join([sys.argv[0], "recover", slot])
    return f"{command}; exec /bin/bash -l"


def launch_recovery(state: dict) -> bool:
    STATE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (STATE_ROOT.parent / "tmux.lock").open("a+") as gate:
        fcntl.flock(gate.fileno(), fcntl.LOCK_EX)
        if (STATE_ROOT.parent / "resize-in-progress").exists():
            return False
        return restore_pane(state)


def restore_pane(state: dict) -> bool:
    session = str(state.get("tmux_session") or "")
    cwd = os.path.realpath(str(state.get("cwd") or ""))
    pane = str(state.get("pane") or "")
    if not SESSION.fullmatch(session):
        return False
    if not (cwd == str(WORKSPACE_ROOT) or cwd.startswith(str(WORKSPACE_ROOT) + os.sep)):
        return False
    command = recovery_command(str(state["slot"]))
    panes = run_tmux("list-panes", "-a", "-F", "#{pane_id}", capture=True)
    existing_panes = set(panes.stdout.split()) if panes.returncode == 0 else set()
    # Pane IDs are recycled when tmux restarts. Never replace a live shell or
    # another conversation merely because its numeric ID matches old state.
    binding = run_tmux(
        "show-options", "-p", "-t", pane, "-v", "@envr-codex-slot", capture=True
    ) if pane in existing_panes else None
    if (binding is not None and binding.stdout.strip() == str(state["slot"])
            and tmux_value("#{pane_dead}", pane) == "1"
            and tmux_value("#{session_name}", pane) == session):
        result = run_tmux("respawn-pane", "-k", "-t", pane, "-c", cwd, command)
        if result.returncode == 0:
            run_tmux("select-pane", "-t", pane)
            return True
    if run_tmux("has-session", "-t", f"={session}").returncode == 0:
        result = run_tmux(
            "new-window", "-d", "-P", "-F", "#{pane_id}",
            "-t", session, "-n", "codex-recovery", "-c", cwd, command,
            capture=True,
        )
        if result.returncode == 0:
            pane = result.stdout.strip()
            run_tmux("select-window", "-t", pane)
            return True
        return False
    result = run_tmux(
        "new-session", "-d", "-P", "-F", "#{pane_id}",
        "-s", session, "-n", "codex", "-c", cwd, command,
        capture=True,
    )
    if result.returncode == 0:
        return True
    return False


def inspect_orphans() -> None:
    current_boot = boot_id()
    current_oom = oom_kills()
    for path in STATE_ROOT.glob("*.json"):
        state = load_state(path)
        if not state or state.get("desired") != "running":
            continue
        slot = str(state.get("slot") or "")
        if not UUID.fullmatch(slot):
            continue
        handle = lock_slot(slot, blocking=False)
        if handle is None:
            continue
        try:
            state = load_state(path)
            if not state or state.get("desired") != "running":
                continue
            launching = int(state.get("launching_at") or 0)
            if state.get("status") == "recovering" and time.time() - launching < 30:
                continue
            recoverable = (
                str(state.get("boot_id") or "") != current_boot
                or current_oom > int(state.get("oom_baseline") or 0)
            )
            if not recoverable:
                state.update({
                    "desired": "stopped",
                    "status": "stopped",
                    "reason": "process ended without OOM",
                })
                save(state)
                continue
            now = int(time.time())
            failures = [int(value) for value in state.get("failures", [])
                        if now - int(value) <= FAILURE_WINDOW]
            failures.append(now)
            state["failures"] = failures
            if len(failures) > MAX_FAILURES:
                state.update({"desired": "stopped", "status": "failed",
                              "reason": "repeated recovery failures"})
                save(state)
                continue
            state.update({
                "status": "recovering",
                "launching_at": int(time.time()),
                "boot_id": current_boot,
                "oom_baseline": current_oom,
            })
            save(state)
        finally:
            handle.close()
        launched = launch_recovery(state)
        if not launched:
            handle = lock_slot(slot, blocking=False)
            if handle is not None:
                try:
                    latest = load_state(path) or state
                    latest.update({
                        "desired": "stopped",
                        "status": "failed",
                        "reason": "tmux recovery failed",
                    })
                    save(latest)
                finally:
                    handle.close()


def ensure_keeper_session() -> None:
    if run_tmux("has-session", "-t", "=envr-keeper").returncode == 0:
        return
    run_tmux(
        "new-session", "-d", "-s", "envr-keeper", "-n", "keeper",
        "-c", str(WORKSPACE_ROOT), "exec sleep infinity",
    )


def keeper() -> int:
    STATE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    while True:
        ensure_keeper_session()
        marker = STATE_ROOT / "recover-after-oom"
        if marker.exists():
            current = oom_kills()
            for path in STATE_ROOT.glob("*.json"):
                state = load_state(path)
                if not state or state.get("desired") != "running":
                    continue
                slot = str(state.get("slot") or "")
                if not UUID.fullmatch(slot):
                    continue
                handle = lock_slot(slot, blocking=False)
                if handle is None:
                    continue
                try:
                    latest = load_state(path) or state
                    latest["oom_baseline"] = min(
                        int(latest.get("oom_baseline") or 0), current - 1
                    )
                    save(latest)
                finally:
                    handle.close()
            try:
                marker.unlink()
            except OSError:
                pass
        inspect_orphans()
        time.sleep(5)


def armed() -> int:
    for path in STATE_ROOT.glob("*.json"):
        state = load_state(path)
        if state and state.get("desired") == "running":
            return 0
    return 1


def disarm_all() -> int:
    for path in STATE_ROOT.glob("*.json"):
        state = load_state(path)
        if state:
            state.update({"desired": "stopped", "status": "stopped", "reason": "envr shutdown"})
            save(state)
    return 0


def main(arguments: list[str]) -> int:
    try:
        if arguments and arguments[0] == "resume":
            return resume(arguments[1:])
        if len(arguments) == 2 and arguments[0] == "recover":
            return recover(arguments[1])
        if arguments == ["keeper"]:
            return keeper()
        if arguments == ["armed"]:
            return armed()
        if arguments == ["disarm-all"]:
            return disarm_all()
        if arguments == ["inspect-once"]:
            inspect_orphans()
            return 0
        if arguments == ["version"]:
            print(PROTOCOL_VERSION)
            return 0
        raise RuntimeError("invalid envr Codex supervisor operation")
    except RuntimeError as error:
        print(f"scodex: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
